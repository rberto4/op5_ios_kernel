From 1d75a80413be70d931021ec805781e7a2b913ca1 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Tue, 24 Nov 2026 00:30:51 +0100
Subject: [PATCH] cheeseburger: give the WLAN firmware a MAC (QMI WLFW
 MAC_ADDR)

Stock cnss-daemon (pulled from the OP5 vendor partition): reads the WLAN MAC from the modem with QMI DMS and sends it with wlfw_send_mac_addr_req (QMI_WLFW_MAC_ADDR_REQ 0x33), and connects to WLPS. We never sent one: WMI READY reported MAC 00:00:00, and the modem raised DOG_HB starvation ~8 s into mission every time. Send a locally administered MAC at FW_READY, WLAN_CFG on its response (kern.sweetwlfw_mac, default 1).
---
 bsd/dev/sweet_wlfw.c | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/sweet_wlfw.c b/bsd/dev/sweet_wlfw.c
index 12345f0..ab52522 100644
--- a/bsd/dev/sweet_wlfw.c
+++ b/bsd/dev/sweet_wlfw.c
@@ -45,6 +45,7 @@ int sweet_rpm_kvp(uint32_t rtype, uint32_t rid, uint32_t key, uint32_t value);
 #define WLFW_MSA_INFO       0x2D
 #define WLFW_MSA_READY      0x2E
 #define WLFW_HOST_CAP       0x34
+#define WLFW_MAC_ADDR       0x33
 #define QMI_ERR_MALFORMED   1                   /* QMI_ERR_MALFORMED_MSG_V01 */
 #define WLFW_FW_READY_BIT   0x1ull             /* QMI_WLFW_FW_READY_V01 in ind_register fw_status */
 #define WLFW_CLIENT_ID      0x4b4e454c          /* ath10k ATH10K_QMI_CLIENT_ID */
@@ -70,7 +71,9 @@ static unsigned w_arrivals, w_cap_tries, w_cap_retry_ms, w_mission_ms;
 static bool w_off_sent;
 static const char *w_step = "not started";
 
-int sweet_wlfw_smmu = 1, sweet_wlfw_upto, sweet_wlfw_off_ms, sweet_wlfw_pinctrl = 1;
+int sweet_wlfw_smmu = 1, sweet_wlfw_upto, sweet_wlfw_off_ms, sweet_wlfw_pinctrl = 1, sweet_wlfw_mac = 1;
+SYSCTL_INT(_kern, OID_AUTO, sweetwlfw_mac, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_wlfw_mac, 0,
+    "W5: 1 = give the firmware a MAC (QMI WLFW MAC_ADDR, as stock cnss-daemon) before WLAN_CFG");
 SYSCTL_INT(_kern, OID_AUTO, sweetwlfw_pinctrl, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_wlfw_pinctrl, 0,
     "W5: 1 = L7/L17/L25 pin-controlled by the WCN3990 (EN2) as the stock dtb, 0 = software-enabled");
 SYSCTL_INT(_kern, OID_AUTO, sweetwlfw_off_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_wlfw_off_ms, 0,
@@ -373,6 +376,20 @@ w_on_fw_ready(void)
 		LOG("wlfw: kern.sweetwlfw_upto 1: no WLAN_CFG / mission");
 		return;
 	}
+	/*
+	 * Stock cnss-daemon reads the WLAN MAC from the modem (DMS) and sends it with
+	 * QMI_WLFW_MAC_ADDR_REQ; ours never did, and WMI READY reported MAC 00:00:00.
+	 * Locally administered address, the one the scan vdev uses.
+	 */
+	if (sweet_wlfw_mac) {
+		static const uint8_t mac[6] = { 0x02, 0x4F, 0x50, 0x35, 0x00, 0x01 };
+		struct wmsg m;
+		if (wm_new(&m, WLFW_MAC_ADDR)) {
+			wm_tlv(&m, 0x10, mac, 6);
+			wm_send(&m, "mac_addr sent");
+			return;                         /* WLAN_CFG on the response */
+		}
+	}
 	w_send_cfg();
 }
 
@@ -521,6 +538,10 @@ w_on_resp(uint16_t msg, const uint8_t *d, uint32_t len)
 		LOG("t=%u ms: wlfw: cal_report %s err %u, waiting for FW_READY", g_ms, ok ? "ok" : "FAILED", err);
 		w_step = "waiting FW_READY";
 		break;
+	case WLFW_MAC_ADDR:
+		LOG("t=%u ms: wlfw: mac_addr %s err %u", g_ms, ok ? "ok" : "FAILED", err);
+		w_send_cfg();
+		break;
 	case WLFW_WLAN_CFG:
 		LOG("t=%u ms: wlfw: wlan_cfg %s err %u", g_ms, ok ? "ok" : "FAILED", err);
 		if (ok && sweet_wlfw_upto == 2) {
-- 
