+/*
+ * Phase D step 2 probe: can the 2D engine scale? iOS presents 750x1334 into
+ * the 1080x1920 panel (x1.44). CP_BLIT BLIT_OP_SCALE is documented only as
+ * "used for mipmap generation" and render mode 7 as a placeholder name, so
+ * try 64x64 -> 92x92 both ways and compare with nearest and bilinear.
+ */
+#define SC_W            92u
+#define SC_PITCH        512u
+#define SC_PX           (SC_PITCH / 4u)
+
+static uint32_t
+scale_variant(uint32_t which, uint32_t mode)
+{
+	uint32_t off = DMA_SCALE_DST + which * SC_PITCH * SC_PX;
+	volatile uint32_t *dst = (volatile uint32_t *)(dma + off);
+	for (uint32_t i = 0; i < SC_PX * SC_PX; i++) {
+		dst[i] = 0x12345678u;
+	}
+	flush_dcache64(dma_pa + off, SC_PITCH * SC_PX, TRUE);
+	rb_blit_setup();
+	rb_pkt7(CP_SET_RENDER_MODE, 1);
+	rb_out(mode);
+	rb_surface(R_RB_2D_SRC_INFO, R_GRAS_2D_SRC_INFO, gaddr(DMA_IMG_SRC));
+	rb_pkt4(R_RB_2D_DST_INFO, 9);
+	rb_out(FMT_R8G8B8A8_UNORM);
+	rb_out((uint32_t)gaddr(off));
+	rb_out((uint32_t)(gaddr(off) >> 32));
+	rb_out((SC_PITCH >> 6) | (((SC_PITCH * SC_PX) >> 6) << 16));
+	for (int i = 0; i < 5; i++) {
+		rb_out(0);
+	}
+	rb_reg(R_GRAS_2D_DST_INFO, FMT_R8G8B8A8_UNORM);
+	rb_pkt7(CP_BLIT, 5);
+	rb_out(BLIT_OP_SCALE);
+	rb_out(0);
+	rb_out((IMG_W - 1) | ((IMG_H - 1) << 16));
+	rb_out(0);
+	rb_out((SC_W - 1) | ((SC_W - 1) << 16));
+	rb_pkt7(CP_SET_RENDER_MODE, 1);
+	rb_out(RENDER_MODE_END2D);
+	rb_pkt7(CP_WAIT_FOR_IDLE, 0);
+	bool fenced = irq_test();
+	flush_dcache64(dma_pa + off, SC_PITCH * SC_PX, TRUE);
+	uint32_t written = 0, outside = 0, nearest = 0, maxerr = 0;
+	for (uint32_t y = 0; y < SC_PX; y++) {
+		for (uint32_t x = 0; x < SC_PX; x++) {
+			uint32_t got = dst[y * SC_PX + x];
+			bool in = x < SC_W && y < SC_W;
+			if (!in) {
+				outside += got != 0x12345678u;
+				continue;
+			}
+			written += got != 0x12345678u;
+			uint32_t nx = (2u * x + 1u) * IMG_W / (2u * SC_W), ny = (2u * y + 1u) * IMG_H / (2u * SC_W);
+			nearest += got == img_pattern(nx, ny);
+			/* bilinear expectation of R = 4 * x_src and G = 4 * y_src (src centres) */
+			int32_t er = (int32_t)(((2 * (int64_t)x + 1) * IMG_W * 4 / (2 * SC_W)) - 2);
+			int32_t eg = (int32_t)(((2 * (int64_t)y + 1) * IMG_H * 4 / (2 * SC_W)) - 2);
+			er = er < 0 ? 0 : (er > 252 ? 252 : er);
+			eg = eg < 0 ? 0 : (eg > 252 ? 252 : eg);
+			int32_t dr = (int32_t)(got & 0xffu) - er, dg = (int32_t)((got >> 8) & 0xffu) - eg;
+			uint32_t e = (uint32_t)((dr < 0 ? -dr : dr) > (dg < 0 ? -dg : dg) ? (dr < 0 ? -dr : dr) : (dg < 0 ? -dg : dg));
+			maxerr = e > maxerr ? e : maxerr;
+		}
+	}
+	printf("SWEET GPU B: SCALE %c (render mode %u): fence %s, written %u/%u, outside touched %u, nearest-exact %u, "
+	    "max R/G error vs bilinear %u; px (0,0) 0x%08x (45,45) 0x%08x (91,91) 0x%08x\n", 'a' + which, mode,
+	    fenced ? "ok" : "MISSING", written, SC_W * SC_W, outside, nearest, maxerr, dst[0], dst[45 * SC_PX + 45],
+	    dst[91 * SC_PX + 91]);
+	return fenced ? (written << 16) | (nearest > 0xffffu ? 0xffffu : nearest) : 0xffffffffu;
+}
+
+static int scale_res_a, scale_res_b;
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_scale_a, CTLFLAG_RD | CTLFLAG_LOCKED, &scale_res_a, 0,
+    "SWEET GPU: mode 10 variant a (written << 16 | nearest-exact, -1 = no fence)");
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_scale_b, CTLFLAG_RD | CTLFLAG_LOCKED, &scale_res_b, 0,
+    "SWEET GPU: mode 10 variant b");
+
+static int
+scale_test(void)
+{
+	volatile uint32_t *src = (volatile uint32_t *)(dma + DMA_IMG_SRC);
+	for (uint32_t y = 0; y < IMG_H; y++) {
+		for (uint32_t x = 0; x < IMG_W; x++) {
+			src[y * IMG_W + x] = img_pattern(x, y);
+		}
+	}
+	flush_dcache64(dma_pa + DMA_IMG_SRC, IMG_PITCH * IMG_H, TRUE);
+	scale_res_a = (int)scale_variant(0, RENDER_MODE_BLIT2D);
+	if (scale_res_a == -1) {
+		return -1;
+	}
+	scale_res_b = (int)scale_variant(1, RENDER_MODE_BLIT2DSCALE);
+	return scale_res_b == -1 ? -1 : 0;
+}
