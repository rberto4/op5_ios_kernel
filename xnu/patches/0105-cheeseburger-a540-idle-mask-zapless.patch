 /* Make the ring visible to the GPU, kick it and wait until it is drained and idle. */
+/*
+ * RBBM_STATUS bits that mean "still working". Test 0104: after ME_INIT the
+ * ring was drained (RPTR = WPTR) with CP_BUSY clear, yet 0xc0000101 stayed
+ * set (GPU_BUSY_IGN_AHB, _CP, _HYST, HI_BUSY: no GPMU, no clock gating), so
+ * those four are ignored. Tunable: sysctl kern.sweetgpu_busymask.
+ */
+static int busy_mask = (int)0x3ffffefeu;
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_busymask, CTLFLAG_RW | CTLFLAG_LOCKED, &busy_mask, 0,
+    "SWEET GPU stage B: RBBM_STATUS bits treated as busy");
+
 static bool
 rb_flush_wait(const char *what)
 {
 	flush_dcache64(dma_pa + DMA_RB, RB_SIZE, TRUE);
 	gwr(R_CP_RB_WPTR, rb_wptr);
 	for (int i = 0; i < 20000; i++) {
-		if (grd(R_CP_RB_RPTR) == rb_wptr && !(grd(R_RBBM_STATUS) & ~1u) &&
+		if (grd(R_CP_RB_RPTR) == rb_wptr && !(grd(R_RBBM_STATUS) & (uint32_t)busy_mask) &&
 		    !(grd(R_RBBM_INT_0_STATUS) & 0x00800000u)) {
-			printf("SWEET GPU B: %s: done after %d x 50 us (RPTR %u)\n", what, i, rb_wptr);
+			printf("SWEET GPU B: %s: done after %d x 50 us (RPTR %u, RBBM_STATUS 0x%08x)\n", what, i,
+			    rb_wptr, grd(R_RBBM_STATUS));
 			return true;
 		}
 		delay(50);
