+/*
+ * Tests 0128 and 0131: XNU here also hands out pages below 4 GiB (the
+ * low RAM bank), which are not in its physical aperture, so any cache
+ * maintenance by physical address (flush_dcache64(..., TRUE),
+ * IOMemoryDescriptor kIOMemoryIncoherentIOFlush) panics in phystokv on
+ * them. All cache maintenance goes through kernel virtual addresses.
+ */
+void sweet_gpu_flush_va(uintptr_t va, size_t len);
+void
+sweet_gpu_flush_va(uintptr_t va, size_t len)
+{
+	if (va != 0 && len != 0) {
+		flush_dcache64((addr64_t)va, (unsigned)len, FALSE);
+	}
+}
