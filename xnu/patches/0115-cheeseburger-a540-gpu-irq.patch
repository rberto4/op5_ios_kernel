+/*
+ * Phase C step 2: GPU interrupt. The Adreno node's interrupt is GIC SPI 300
+ * (INTID 332), level high. The GIC distributor is left as pe_init_fiq set it
+ * (ARE_NS, group 1 enabled); this routes the SPI to CPU 0 and enables it,
+ * and osfmk/arm64/sleh.c (patch 0115) calls gpu_irq() before EOI.
+ */
+#define GICD_PA                 0x17a00000u
+#define GICD_IGROUPR(n)         (0x0080u + 4u * ((n) / 32u))
+#define GICD_ISENABLER(n)       (0x0100u + 4u * ((n) / 32u))
+#define GICD_ICENABLER(n)       (0x0180u + 4u * ((n) / 32u))
+#define GICD_IPRIORITYR(n)      (0x0400u + (n))
+#define GICD_IROUTER(n)         (0x6000u + 8u * (n))
+#define GPU_INTID               (32u + 300u)
+#define GPU_IRQ_STORM           1000u
+#define INT_CP_SW               0x00000100u
+#define INT_CP_CACHE_FLUSH_TS   0x00100000u
+
+extern int sweet_irq_register(uint32_t intid, void (*fn)(uint32_t intid));
+
+static vm_offset_t gicd;
+static volatile uint32_t irq_count, irq_last_status;
+
+static void
+gicd_spi_enable(uint32_t intid, bool on)
+{
+	uint32_t bit = 1u << (intid % 32u);
+	if (on) {
+		*(volatile uint32_t *)(gicd + GICD_IGROUPR(intid)) |= bit;      /* group 1 non-secure */
+		*(volatile uint8_t *)(gicd + GICD_IPRIORITYR(intid)) = 0xa0;
+		*(volatile uint64_t *)(gicd + GICD_IROUTER(intid)) = 0;         /* CPU 0 (affinity 0.0.0.0) */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		*(volatile uint32_t *)(gicd + GICD_ISENABLER(intid)) = bit;
+	} else {
+		*(volatile uint32_t *)(gicd + GICD_ICENABLER(intid)) = bit;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+gpu_irq(uint32_t intid)
+{
+	uint32_t st = grd(R_RBBM_INT_0_STATUS);
+	gwr(R_RBBM_INT_CLEAR_CMD, st);
+	irq_last_status = st;
+	if (++irq_count >= GPU_IRQ_STORM) {
+		gwr(R_RBBM_INT_0_MASK, 0);
+		gicd_spi_enable(intid, false);
+	}
+}
+
+/* CP_EVENT_WRITE CACHE_FLUSH_TS with IRQ: the CP writes a fence value, then interrupts. */
+static bool
+irq_test(void)
+{
+	if (!gicd) {
+		gicd = ml_io_map(GICD_PA, 0x10000);
+	}
+	if (!gicd) {
+		return false;
+	}
+	gwr(R_RBBM_INT_CLEAR_CMD, 0xffffffffu);
+	irq_count = 0;
+	irq_last_status = 0;
+	if (sweet_irq_register(GPU_INTID, gpu_irq) != 0) {
+		printf("SWEET GPU B: IRQ: sweet_irq_register(%u) refused\n", GPU_INTID);
+		return false;
+	}
+	gicd_spi_enable(GPU_INTID, true);
+	gwr(R_RBBM_INT_0_MASK, INT_CP_CACHE_FLUSH_TS | INT_CP_SW);
+	printf("SWEET GPU B: IRQ: INTID %u enabled: IGROUPR 0x%08x ISENABLER 0x%08x IROUTER 0x%llx\n", GPU_INTID,
+	    *(volatile uint32_t *)(gicd + GICD_IGROUPR(GPU_INTID)),
+	    *(volatile uint32_t *)(gicd + GICD_ISENABLER(GPU_INTID)),
+	    *(volatile uint64_t *)(gicd + GICD_IROUTER(GPU_INTID)));
+
+	*(volatile uint32_t *)(dma + DMA_SCRATCH) = 0xdeadbeef;
+	flush_dcache64(dma_pa + DMA_SCRATCH, 64, TRUE);
+	uint64_t fence = gaddr(DMA_SCRATCH);
+	rb_pkt7(CP_EVENT_WRITE, 4);
+	rb_out(EV_CACHE_FLUSH_TS | EV_IRQ);
+	rb_out((uint32_t)fence);
+	rb_out((uint32_t)(fence >> 32));
+	rb_out(0x5eed0001);
+	flush_dcache64(dma_pa + DMA_RB, RB_SIZE, TRUE);
+	uint64_t t0 = mach_absolute_time();
+	gwr(R_CP_RB_WPTR, rb_wptr);
+	int i;
+	for (i = 0; i < 2000 && irq_count == 0; i++) {
+		delay(50);
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	flush_dcache64(dma_pa + DMA_SCRATCH, 64, TRUE);
+	uint32_t got = *(volatile uint32_t *)(dma + DMA_SCRATCH);
+	printf("SWEET GPU B: IRQ: %u interrupt(s), INT_0_STATUS 0x%08x, wait %d x 50 us (%llu us), fence 0x%08x (%s), "
+	    "RPTR %u WPTR %u\n", irq_count, irq_last_status, i, ns / 1000, got,
+	    got == 0x5eed0001 ? "written" : "NOT written", grd(R_CP_RB_RPTR), rb_wptr);
+
+	gwr(R_RBBM_INT_0_MASK, 0);
+	gicd_spi_enable(GPU_INTID, false);
+	(void)sweet_irq_register(GPU_INTID, NULL);
+	return irq_count > 0 && irq_count < GPU_IRQ_STORM && (irq_last_status & INT_CP_CACHE_FLUSH_TS) &&
+	       got == 0x5eed0001;
+}
