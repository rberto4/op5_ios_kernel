+#if defined(SWEET)
+/*
+ * sweet: no IOKit interrupt controller drives the GIC, so drivers that want
+ * a device SPI register a handler here (called in interrupt context, before
+ * EOI; it must clear the device's interrupt source).
+ */
+typedef void (*sweet_irq_fn_t)(uint32_t intid);
+#define SWEET_IRQ_MAX 1020
+static sweet_irq_fn_t sweet_irq_fns[SWEET_IRQ_MAX];
+
+int sweet_irq_register(uint32_t intid, sweet_irq_fn_t fn);
+int
+sweet_irq_register(uint32_t intid, sweet_irq_fn_t fn)
+{
+	if (intid < 32 || intid >= SWEET_IRQ_MAX) {
+		return -1;
+	}
+	__atomic_store_n(&sweet_irq_fns[intid], fn, __ATOMIC_RELEASE);
+	return 0;
+}
+#endif /* SWEET */
