+/* Raw pin levels as bits top|middle<<1|bottom<<2; changes are logged. */
 static void
+slider_log_raw(void)
+{
+	static unsigned last = ~0u, logged;
+	unsigned raw = 0;
+	for (int i = 0; i < 3; ++i) {
+		raw |= (keys_rd(slider_io[i], 4) & 1u) << i;
+	}
+	if (raw != last && logged < SLIDER_RAW_LOGS) {
+		++logged;
+		printf("SWEET SLIDER: raw gpio40=%u gpio42=%u gpio26=%u\n",
+		    raw & 1u, (raw >> 1) & 1u, (raw >> 2) & 1u);
+	}
+	last = raw;
+}
