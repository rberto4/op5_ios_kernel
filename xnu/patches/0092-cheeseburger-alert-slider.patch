+/* Slider pins top, middle, bottom; one mapped TLMM page each. */
+static const unsigned slider_pin[3] = { 40, 42, 26 };
+static vm_offset_t slider_io[3];
+static bool slider_on;
+
+static void
+slider_init(void)
+{
+	int enabled = 1;
+	(void)PE_parse_boot_argn("sweetslider", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET SLIDER: disabled (sweetslider=0)\n");
+		return;
+	}
+	for (int i = 0; i < 3; ++i) {
+		slider_io[i] = ml_io_map(SLIDER_EAST_PA + 0x1000u * slider_pin[i], 0x1000);
+		if (!slider_io[i]) {
+			printf("SWEET SLIDER: MMIO mapping failed\n");
+			return;
+		}
+	}
+	slider_on = true;
+	printf("SWEET SLIDER: gpio40 cfg=%#x io=%#x gpio42 cfg=%#x io=%#x gpio26 cfg=%#x io=%#x\n",
+	    keys_rd(slider_io[0], 0), keys_rd(slider_io[0], 4),
+	    keys_rd(slider_io[1], 0), keys_rd(slider_io[1], 4),
+	    keys_rd(slider_io[2], 0), keys_rd(slider_io[2], 4));
+}
+
+/* 0 top, 1 middle, 2 bottom; -1 while moving or not exactly one pin low. */
+static int
+slider_read(void)
+{
+	int pos = -1;
+	for (int i = 0; i < 3; ++i) {
+		if (!(keys_rd(slider_io[i], 4) & 1u)) {
+			if (pos >= 0) {
+				return -1;
+			}
+			pos = i;
+		}
+	}
+	return pos;
+}
+
+static void
+slider_poll(int *reported, int *candidate, unsigned *count)
+{
+	static const char *const names[3] = { "top (mute)", "middle (do not disturb)", "bottom (ring)" };
+	int pos = slider_read();
+	if (pos < 0 || pos != *candidate) {
+		*candidate = pos;
+		*count = 0;
+		return;
+	}
+	if (++*count < SLIDER_STABLE || pos == *reported) {
+		return;
+	}
+	/* Until backboardd has opened the buttons service, retry every 100 ms. */
+	if (sweet_hid_ringer(pos != 2) <= 0) {
+		*count = 0;
+		return;
+	}
+	*reported = pos;
+	printf("SWEET SLIDER: %s -> ringer %s\n", names[pos], pos == 2 ? "on" : "silent");
+}
