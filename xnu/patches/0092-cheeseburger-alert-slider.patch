+/*
+ * Ring/silent switch: telephony page RingEnable, the usage IOHIDFamily's
+ * HIDButtonLoggingServiceFilter lists for the button that replaced the
+ * switch (Staccato). Key down = ringer on; sweetringerinv=1 swaps it.
+ * Returns the number of clients the event went to.
+ */
+#define SWEET_HID_PAGE_TELEPHONY  0x0b
+#define SWEET_HID_TFON_RINGENABLE 0x2d
+unsigned
+SweetHIDButtons::ringer(bool silent)
+{
+	static int inv = -1;
+	if (inv < 0) {
+		inv = 0;
+		(void)PE_parse_boot_argn("sweetringerinv", &inv, sizeof(inv));
+	}
+	unsigned clients = _clients ? _clients->getCount() : 0;
+	if (!clients) {
+		return 0;
+	}
+	bool down = !silent ^ (inv != 0);
+	IOHIDEvent *event = IOHIDEvent::keyboardEvent(mach_absolute_time(),
+	    SWEET_HID_PAGE_TELEPHONY, SWEET_HID_TFON_RINGENABLE, down);
+	if (!event) {
+		return 0;
+	}
+	IOLog("SWEET HID: ringer %s (RingEnable %s, %u clients)\n", silent ? "silent" : "on",
+	    down ? "down" : "up", clients);
+	dispatchEvent(event);
+	event->release();
+	return clients;
+}
