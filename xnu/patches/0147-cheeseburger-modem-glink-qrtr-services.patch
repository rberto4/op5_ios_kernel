+void
+wlfw_arrive(uint32_t node, uint32_t port)
+{
+	sweet_mlink_wlfw_seen = true;
+	LOG("t=%u ms: WLFW service (0x45) up at node %u port %x: the WLAN firmware runs", g_ms, node, port);
+}
