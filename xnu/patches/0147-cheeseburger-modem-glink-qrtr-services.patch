--- a/bsd/dev/sweet_mpss.c
+++ b/bsd/dev/sweet_mpss.c
@@ -10,6 +10,8 @@
  *      carve-out to the modem -> status 4 "MPSS AUTHENTICATED"
  *  10  watch the modem's inbound item 435 (negotiation, SSR ack) for
  *      kern.sweetmss_hold seconds: "slave-kernel" bit 1 = "MPSS READY"
+ *  11  W3: GLINK + QRTR + pd-mapper/tftp/rmtfs (sweet_glink.c, sweet_msvc.c)
+ *      for kern.sweetmss_hold seconds: success = the WLFW service appears
  *
  * Linux v6.12: remoteproc/qcom_q6v5_mss.c (q6v5_mpss_init_image,
  * q6v5_mpss_load, q6v5_start), qcom_q6v5.c (request_stop), soc/qcom/
@@ -494,6 +496,21 @@ smp2p_watch(struct mss_state *s, int hold_s)
 	return s->ready;
 }
 
+/* For step 11: the modem's slave-kernel value (changes are logged), ~0 if unknown. */
+static uint32_t
+slave_kernel_now(void)
+{
+	static uint32_t last[16];
+	static bool seen;
+	static bool init;
+	if (!init) {
+		memset(last, 0xff, sizeof(last));
+		seen = true;
+		init = true;
+	}
+	return smp2p_poll(last, 16, &seen);
+}
+
 void
 sweet_mpss_request_stop(struct mss_state *s)
 {
@@ -553,8 +570,17 @@ sweet_mpss_run(struct mss_state *s, int last, int hold_s)
 		goto out;
 	}
 	sweet_mss_announce(10, "watch the modem's SMP2P state");
-	if (smp2p_watch(s, hold_s > 0 ? hold_s : 20)) {
-		reached = 10;
+	/* going on to step 11: READY comes at once, the long watch is step 11's */
+	if (!smp2p_watch(s, last >= 11 ? 3 : (hold_s > 0 ? hold_s : 20))) {
+		goto out;
+	}
+	reached = 10;
+	if (last < 11) {
+		goto out;
+	}
+	sweet_mss_announce(11, "GLINK + QRTR + host services (pd-mapper, tftp, rmtfs)");
+	if (sweet_mlink_watch(hold_s > 0 ? (unsigned)hold_s : 20, slave_kernel_now)) {
+		reached = 11;
 	}
 out:
 	if (mdt) {
