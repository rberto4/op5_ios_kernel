+/*
+ * SweetGPU: the Adreno 540 for user space (phase E).
+ *
+ * An IOService published under AppleCLCD (boot-arg sweetgpu=2) and an
+ * IOUserClient that speaks Linux's msm DRM interface, so that Mesa's
+ * freedreno runs unchanged over the libdrm emulation in
+ * userland/mesa/redwood-drm: a request's number is the call's selector
+ * (DRM_COMMAND_BASE + DRM_MSM_x, or 0x09 for GEM_CLOSE), its structure goes
+ * in and comes back (IOConnectCallStructMethod), and a buffer's memory is
+ * the client memory of the type that is the buffer's handle
+ * (IOConnectMapMemory64). Buffers are write-combined
+ * IOBufferMemoryDescriptors at softpin GPU addresses chosen by the kernel
+ * (MSM_INFO_GET_IOVA): no relocations. The GPU work itself is
+ * bsd/dev/sweet_a540_b.c.
+ *
+ * The structures below are those of include/uapi/drm/msm_drm.h:
+ * Copyright (C) 2013 Red Hat, MIT license (permission to use, copy,
+ * modify, merge, publish, distribute, sublicense and sell, with this
+ * notice).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/system.h>
+#include <pexpert/pexpert.h>
+
+extern "C" {
+int sweet_gpu_start(void);
+int sweet_gpu_ready(void);
+int sweet_gpu_param(uint32_t param, uint64_t *value);
+uint64_t sweet_gpu_map(const uint64_t *seg_pa, const uint64_t *seg_len, uint32_t nseg, uint64_t size);
+void sweet_gpu_unmap(uint64_t iova, uint64_t size);
+uint32_t sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, uint32_t n);
+int sweet_gpu_wait(uint32_t seq, uint32_t timeout_us);
+}
+
+/* ---- msm_drm.h (MIT, see above) ---- */
+#define DRM_COMMAND_BASE                0x40
+#define DRM_GEM_CLOSE                   0x09
+#define DRM_MSM_GET_PARAM               0x00
+#define DRM_MSM_SET_PARAM               0x01
+#define DRM_MSM_GEM_NEW                 0x02
+#define DRM_MSM_GEM_INFO                0x03
+#define DRM_MSM_GEM_CPU_PREP            0x04
+#define DRM_MSM_GEM_CPU_FINI            0x05
+#define DRM_MSM_GEM_SUBMIT              0x06
+#define DRM_MSM_WAIT_FENCE              0x07
+#define DRM_MSM_GEM_MADVISE             0x08
+#define DRM_MSM_SUBMITQUEUE_NEW         0x0A
+#define DRM_MSM_SUBMITQUEUE_CLOSE       0x0B
+#define DRM_MSM_SUBMITQUEUE_QUERY       0x0C
+#define MSM_INFO_GET_OFFSET             0x00
+#define MSM_INFO_GET_IOVA               0x01
+#define MSM_INFO_SET_NAME               0x02
+#define MSM_INFO_GET_FLAGS              0x05
+#define MSM_PREP_NOSYNC                 0x04
+#define MSM_SUBMIT_CMD_BUF              0x0001
+#define MSM_SUBMIT_CMD_IB_TARGET_BUF    0x0002
+#define MSM_SUBMIT_CMD_CTX_RESTORE_BUF  0x0003
+
+struct drm_msm_timespec { int64_t tv_sec, tv_nsec; };
+struct drm_msm_param { uint32_t pipe, param; uint64_t value; uint32_t len, pad; };
+struct drm_msm_gem_new { uint64_t size; uint32_t flags, handle; };
+struct drm_msm_gem_info { uint32_t handle, info; uint64_t value; uint32_t len, pad; };
+struct drm_msm_gem_cpu_prep { uint32_t handle, op; struct drm_msm_timespec timeout; };
+struct drm_msm_gem_cpu_fini { uint32_t handle; };
+struct drm_msm_gem_submit_cmd {
+	uint32_t type, submit_idx, submit_offset, size, pad, nr_relocs;
+	uint64_t relocs;
+};
+struct drm_msm_gem_submit_bo { uint32_t flags, handle; uint64_t presumed; };
+struct drm_msm_gem_submit {
+	uint32_t flags, fence, nr_bos, nr_cmds;
+	uint64_t bos, cmds;
+	int32_t fence_fd;
+	uint32_t queueid;
+	uint64_t in_syncobjs, out_syncobjs;
+	uint32_t nr_in_syncobjs, nr_out_syncobjs, syncobj_stride, pad;
+};
+struct drm_msm_wait_fence { uint32_t fence, flags; struct drm_msm_timespec timeout; uint32_t queueid; };
+struct drm_msm_gem_madvise { uint32_t handle, madv, retained; };
+struct drm_msm_submitqueue { uint32_t flags, prio, id; };
+struct drm_msm_submitqueue_query { uint64_t data; uint32_t id, param, len, pad; };
+struct drm_gem_close { uint32_t handle, pad; };
+/* ---- end of msm_drm.h ---- */
+
+#define SWEET_GPU_MAX_BOS       8192
+#define SWEET_GPU_MAX_SEGS      4096
+#define SWEET_GPU_MAX_BO_SIZE   (64u << 20)
+#define SWEET_GPU_MAX_SUBMIT_BOS 1024
+#define SWEET_GPU_MAX_IBS       64
+#define SWEET_GPU_WAIT_US       2000000u        /* the most a fence or CPU_PREP wait blocks */
+
+class SweetGPU : public IOService {
+	OSDeclareDefaultStructors(SweetGPU);
+};
+
+OSDefineMetaClassAndStructors(SweetGPU, IOService);
+
+class SweetGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetGPUUserClient);
+
+	struct Bo {
+		IOBufferMemoryDescriptor *mem;
+		uint64_t iova, size;
+		uint32_t flags, fence;          /* last submit that used it */
+	};
+	Bo       *fBo;
+	IOLock   *fLock;
+	uint64_t *fSegPA, *fSegLen;
+	uint32_t  fLastFence;
+	task_t    fTask;
+
+	bool validHandle(uint32_t h) { return h > 0 && h < SWEET_GPU_MAX_BOS && fBo[h].mem != NULL; }
+	IOReturn gemNew(struct drm_msm_gem_new *req);
+	void gemClose(uint32_t handle);
+	IOReturn gemInfo(struct drm_msm_gem_info *req);
+	IOReturn cpuPrep(struct drm_msm_gem_cpu_prep *req);
+	IOReturn submit(struct drm_msm_gem_submit *req);
+	IOReturn readUser(uint64_t address, void *out, size_t size);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPUUserClient, IOUserClient);
+
+/* Called by AppleCLCD::start. */
+void sweet_gpu_service_publish(IOService *parent);
+void
+sweet_gpu_service_publish(IOService *parent)
+{
+	SweetGPU *gpu = OSTypeAlloc(SweetGPU);
+	if (gpu != NULL && gpu->init()) {
+		gpu->setName("SweetGPU");
+		gpu->setProperty(kIOUserClientClassKey, "SweetGPUUserClient");
+		if (gpu->attach(parent)) {
+			gpu->registerService();
+			IOLog("SWEET GPU: SweetGPU service published (msm interface)\n");
+		}
+	}
+	OSSafeReleaseNULL(gpu);
+}
+
+bool
+SweetGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fBo = (Bo *)IOMallocData(SWEET_GPU_MAX_BOS * sizeof(Bo));
+	if (fBo != NULL) {
+		bzero(fBo, SWEET_GPU_MAX_BOS * sizeof(Bo));
+	}
+	fSegPA = (uint64_t *)IOMallocData(SWEET_GPU_MAX_SEGS * sizeof(uint64_t));
+	fSegLen = (uint64_t *)IOMallocData(SWEET_GPU_MAX_SEGS * sizeof(uint64_t));
+	fLock = IOLockAlloc();
+	if (fBo == NULL || fSegPA == NULL || fSegLen == NULL || fLock == NULL) {
+		return false;
+	}
+	/* bring the GPU up if the present path has not (first open waits for it) */
+	sweet_gpu_start();
+	for (int i = 0; i < 2000 && !sweet_gpu_ready(); i++) {
+		IOSleep(10);
+	}
+	return true;
+}
+
+IOReturn
+SweetGPUUserClient::readUser(uint64_t address, void *out, size_t size)
+{
+	if (size == 0) {
+		return kIOReturnSuccess;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)address, size,
+	    kIODirectionOut, fTask);
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	IOReturn ret = md->prepare();
+	if (ret == kIOReturnSuccess) {
+		ret = md->readBytes(0, out, size) == size ? kIOReturnSuccess : kIOReturnBadArgument;
+		md->complete();
+	}
+	md->release();
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::gemNew(struct drm_msm_gem_new *req)
+{
+	uint64_t size = req->size;
+	if (size == 0 || size > SWEET_GPU_MAX_BO_SIZE) {
+		return kIOReturnBadArgument;
+	}
+	size = (size + 0x3fffull) & ~0x3fffull;
+	uint32_t h;
+	for (h = 1; h < SWEET_GPU_MAX_BOS && fBo[h].mem != NULL; h++) {
+	}
+	if (h == SWEET_GPU_MAX_BOS) {
+		return kIOReturnNoResources;
+	}
+	/* write-combined, as Linux gives freedreno its buffers */
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache, size, 0x4000);
+	if (mem == NULL) {
+		return kIOReturnNoMemory;
+	}
+	bzero(mem->getBytesNoCopy(), (size_t)size);
+	uint32_t n = 0;
+	IOByteCount off = 0;
+	while (off < size && n < SWEET_GPU_MAX_SEGS) {
+		IOByteCount len = 0;
+		addr64_t pa = mem->getPhysicalSegment(off, &len, kIOMemoryMapperNone);
+		if (pa == 0 || len == 0) {
+			break;
+		}
+		if (len > size - off) {
+			len = size - off;
+		}
+		if (n > 0 && fSegPA[n - 1] + fSegLen[n - 1] == pa) {
+			fSegLen[n - 1] += len;
+		} else {
+			fSegPA[n] = pa;
+			fSegLen[n] = len;
+			n++;
+		}
+		off += len;
+	}
+	uint64_t va = off == size ? sweet_gpu_map(fSegPA, fSegLen, n, size) : 0;
+	if (va == 0) {
+		mem->release();
+		return kIOReturnNoResources;
+	}
+	fBo[h].mem = mem;
+	fBo[h].iova = va;
+	fBo[h].size = size;
+	fBo[h].flags = req->flags;
+	fBo[h].fence = 0;
+	req->handle = h;
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::gemClose(uint32_t h)
+{
+	if (!validHandle(h)) {
+		return;
+	}
+	if (fBo[h].fence != 0 && sweet_gpu_wait(fBo[h].fence, SWEET_GPU_WAIT_US) != 0) {
+		/* the GPU may still use it: leak rather than free memory under it */
+		IOLog("SWEET GPU: buffer %u closed with fence %u pending; leaked\n", h, fBo[h].fence);
+		fBo[h].mem = NULL;
+		return;
+	}
+	sweet_gpu_unmap(fBo[h].iova, fBo[h].size);
+	OSSafeReleaseNULL(fBo[h].mem);
+	bzero(&fBo[h], sizeof(fBo[h]));
+}
+
+IOReturn
+SweetGPUUserClient::gemInfo(struct drm_msm_gem_info *req)
+{
+	if (!validHandle(req->handle)) {
+		return kIOReturnNotFound;
+	}
+	switch (req->info) {
+	case MSM_INFO_GET_OFFSET:
+		req->value = req->handle;       /* redwood_drm_map maps the client memory of this type */
+		return kIOReturnSuccess;
+	case MSM_INFO_GET_IOVA:
+		req->value = fBo[req->handle].iova;
+		return kIOReturnSuccess;
+	case MSM_INFO_SET_NAME:
+		return kIOReturnSuccess;
+	case MSM_INFO_GET_FLAGS:
+		req->value = fBo[req->handle].flags;
+		return kIOReturnSuccess;
+	default:
+		return kIOReturnBadArgument;
+	}
+}
+
+IOReturn
+SweetGPUUserClient::cpuPrep(struct drm_msm_gem_cpu_prep *req)
+{
+	if (!validHandle(req->handle)) {
+		return kIOReturnNotFound;
+	}
+	uint32_t fence = fBo[req->handle].fence;
+	if (fence == 0) {
+		return kIOReturnSuccess;
+	}
+	/* NOSYNC: only ask whether the GPU is done with it */
+	uint32_t us = (req->op & MSM_PREP_NOSYNC) ? 0 : SWEET_GPU_WAIT_US;
+	return sweet_gpu_wait(fence, us) == 0 ? kIOReturnSuccess : ((req->op & MSM_PREP_NOSYNC) ? kIOReturnBusy :
+	           kIOReturnTimeout);
+}
+
+IOReturn
+SweetGPUUserClient::submit(struct drm_msm_gem_submit *req)
+{
+	uint32_t nbo = req->nr_bos, ncmd = req->nr_cmds;
+	if (nbo > SWEET_GPU_MAX_SUBMIT_BOS || ncmd == 0 || ncmd > SWEET_GPU_MAX_IBS) {
+		return kIOReturnBadArgument;
+	}
+	size_t bos_size = nbo * sizeof(struct drm_msm_gem_submit_bo);
+	struct drm_msm_gem_submit_bo *bos = nbo ? (struct drm_msm_gem_submit_bo *)IOMallocData(bos_size) : NULL;
+	struct drm_msm_gem_submit_cmd cmds[SWEET_GPU_MAX_IBS];
+	uint64_t ib[SWEET_GPU_MAX_IBS];
+	uint32_t dw[SWEET_GPU_MAX_IBS], nib = 0;
+	IOReturn ret = (nbo && bos == NULL) ? kIOReturnNoMemory : kIOReturnSuccess;
+	if (ret == kIOReturnSuccess) {
+		ret = readUser(req->bos, bos, bos_size);
+	}
+	if (ret == kIOReturnSuccess) {
+		ret = readUser(req->cmds, cmds, ncmd * sizeof(cmds[0]));
+	}
+	for (uint32_t i = 0; ret == kIOReturnSuccess && i < nbo; i++) {
+		if (!validHandle(bos[i].handle)) {
+			ret = kIOReturnNotFound;
+		}
+	}
+	for (uint32_t i = 0; ret == kIOReturnSuccess && i < ncmd; i++) {
+		const struct drm_msm_gem_submit_cmd *c = &cmds[i];
+		if (c->nr_relocs != 0 || c->submit_idx >= nbo || (c->size & 3u) || (c->submit_offset & 3u) ||
+		    c->size == 0) {
+			ret = kIOReturnBadArgument;     /* softpin only: no relocations */
+			break;
+		}
+		const Bo &b = fBo[bos[c->submit_idx].handle];
+		if ((uint64_t)c->submit_offset + c->size > b.size) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		if (c->type == MSM_SUBMIT_CMD_BUF || c->type == MSM_SUBMIT_CMD_CTX_RESTORE_BUF) {
+			ib[nib] = b.iova + c->submit_offset;
+			dw[nib] = c->size / 4u;
+			nib++;
+		} else if (c->type != MSM_SUBMIT_CMD_IB_TARGET_BUF) {
+			ret = kIOReturnBadArgument;
+		}
+	}
+	if (ret == kIOReturnSuccess && nib > 0) {
+		uint32_t seq = sweet_gpu_submit(ib, dw, nib);
+		if (seq == 0) {
+			ret = kIOReturnNotReady;
+		} else {
+			for (uint32_t i = 0; i < nbo; i++) {
+				fBo[bos[i].handle].fence = seq;
+			}
+			fLastFence = seq;
+			req->fence = seq;
+		}
+	} else if (ret == kIOReturnSuccess) {
+		req->fence = fLastFence;
+	}
+	if (bos != NULL) {
+		IOFreeData(bos, bos_size);
+	}
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	IOLockLock(fLock);
+	if (!validHandle(type)) {
+		IOLockUnlock(fLock);
+		return kIOReturnBadArgument;
+	}
+	fBo[type].mem->retain();
+	*memory = fBo[type].mem;
+	*options = 0;
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+#define REQ(type) \
+	if (args->structureInputDescriptor != NULL || args->structureInputSize < sizeof(type) || \
+	    args->structureOutputDescriptor != NULL || args->structureOutputSize < sizeof(type)) { \
+	        return kIOReturnBadArgument; \
+	} \
+	type *req = (type *)args->structureOutput; \
+	memcpy(req, args->structureInput, sizeof(type)); \
+	args->structureOutputSize = sizeof(type)
+
+IOReturn
+SweetGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	IOReturn ret;
+
+	if (!sweet_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	switch (selector) {
+	case DRM_COMMAND_BASE + DRM_MSM_GET_PARAM: {
+		REQ(struct drm_msm_param);
+		return sweet_gpu_param(req->param, &req->value) == 0 ? kIOReturnSuccess : kIOReturnBadArgument;
+	}
+	case DRM_COMMAND_BASE + DRM_MSM_SET_PARAM:
+		return kIOReturnSuccess;        /* SYSPROF, COMM, CMDLINE: nothing to do */
+	case DRM_COMMAND_BASE + DRM_MSM_GEM_NEW: {
+		REQ(struct drm_msm_gem_new);
+		IOLockLock(fLock);
+		ret = gemNew(req);
+		IOLockUnlock(fLock);
+		return ret;
+	}
+	case DRM_GEM_CLOSE: {
+		REQ(struct drm_gem_close);
+		IOLockLock(fLock);
+		gemClose(req->handle);
+		IOLockUnlock(fLock);
+		return kIOReturnSuccess;
+	}
+	case DRM_COMMAND_BASE + DRM_MSM_GEM_INFO: {
+		REQ(struct drm_msm_gem_info);
+		IOLockLock(fLock);
+		ret = gemInfo(req);
+		IOLockUnlock(fLock);
+		return ret;
+	}
+	case DRM_COMMAND_BASE + DRM_MSM_GEM_CPU_PREP: {
+		REQ(struct drm_msm_gem_cpu_prep);
+		IOLockLock(fLock);
+		ret = cpuPrep(req);
+		IOLockUnlock(fLock);
+		return ret;
+	}
+	case DRM_COMMAND_BASE + DRM_MSM_GEM_CPU_FINI:
+		return kIOReturnSuccess;
+	case DRM_COMMAND_BASE + DRM_MSM_GEM_SUBMIT: {
+		REQ(struct drm_msm_gem_submit);
+		IOLockLock(fLock);
+		ret = submit(req);
+		IOLockUnlock(fLock);
+		return ret;
+	}
+	case DRM_COMMAND_BASE + DRM_MSM_WAIT_FENCE: {
+		REQ(struct drm_msm_wait_fence);
+		/* the timeout is CLOCK_MONOTONIC-absolute in Linux; here: 0 asks, anything else waits */
+		bool poll = req->timeout.tv_sec == 0 && req->timeout.tv_nsec == 0;
+		return sweet_gpu_wait(req->fence, poll ? 0 : SWEET_GPU_WAIT_US) == 0 ? kIOReturnSuccess :
+		       (poll ? kIOReturnBusy : kIOReturnTimeout);
+	}
+	case DRM_COMMAND_BASE + DRM_MSM_GEM_MADVISE: {
+		REQ(struct drm_msm_gem_madvise);
+		req->retained = 1;
+		return kIOReturnSuccess;
+	}
+	case DRM_COMMAND_BASE + DRM_MSM_SUBMITQUEUE_NEW: {
+		REQ(struct drm_msm_submitqueue);
+		req->id = 1;                    /* one ring, one queue */
+		return kIOReturnSuccess;
+	}
+	case DRM_COMMAND_BASE + DRM_MSM_SUBMITQUEUE_CLOSE:
+		return kIOReturnSuccess;
+	case DRM_COMMAND_BASE + DRM_MSM_SUBMITQUEUE_QUERY: {
+		REQ(struct drm_msm_submitqueue_query);
+		req->len = 0;                   /* no faults counted */
+		return kIOReturnSuccess;
+	}
+	default:
+		return kIOReturnUnsupported;
+	}
+}
+
+IOReturn
+SweetGPUUserClient::clientClose(void)
+{
+	if (fBo != NULL && fLock != NULL) {
+		IOLockLock(fLock);
+		for (uint32_t h = 1; h < SWEET_GPU_MAX_BOS; h++) {
+			gemClose(h);
+		}
+		IOLockUnlock(fLock);
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::free(void)
+{
+	if (fBo != NULL) {
+		IOFreeData(fBo, SWEET_GPU_MAX_BOS * sizeof(Bo));
+		fBo = NULL;
+	}
+	if (fSegPA != NULL) {
+		IOFreeData(fSegPA, SWEET_GPU_MAX_SEGS * sizeof(uint64_t));
+	}
+	if (fSegLen != NULL) {
+		IOFreeData(fSegLen, SWEET_GPU_MAX_SEGS * sizeof(uint64_t));
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+	}
+	IOUserClient::free();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
