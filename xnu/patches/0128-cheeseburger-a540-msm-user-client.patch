+	case 0x02: *value = 0x100000; return 0;                         /* GMEM_SIZE: 1 MiB */
+	case 0x03: *value = 0x05040001; return 0;                       /* CHIP_ID: adreno-540.1 */
+	case 0x04: *value = (uint64_t)last_khz * 1000ull; return 0;     /* MAX_FREQ */
+	case 0x05:                                                      /* TIMESTAMP: always-on counter */
+		if (!sweet_gpu_ready()) {
+			return -1;
+		}
+		*value = grd(R_RBBM_ALWAYSON_LO) | ((uint64_t)grd(R_RBBM_ALWAYSON_LO + 1) << 32);
+		return 0;
+	case 0x06: *value = 0x100000; return 0;                         /* GMEM_BASE */
+	case 0x07: *value = 1; return 0;                                /* PRIORITIES / NR_RINGS */
+	case 0x08: case 0x09: case 0x0a: *value = 0; return 0;          /* PP_PGTABLE, FAULTS, SUSPENDS */
+	case 0x0e: *value = IOVA_BO; return 0;                          /* VA_START */
+	case 0x0f: *value = BO_VA_SIZE; return 0;                       /* VA_SIZE */
+	default: return -1;
+	}
+}
