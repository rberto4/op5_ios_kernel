+/*
+ * ---- Phase E step 1: GPU core for user space (msm-style) ----
+ *
+ * One ring, shared by the present path and user submits under gpu_mtx; one
+ * fence sequence written by CACHE_FLUSH_TS to DMA_SCRATCH. Buffer objects
+ * (bsd side only sees their physical segments) get GPU addresses in
+ * [IOVA_BO, IOVA_BO + BO_VA_SIZE): 4K-page bitmap, level-3 tables allocated
+ * on first use. iokit/Kernel/arm/SweetGPU.cpp turns this into an
+ * IOUserClient modelled on Linux include/uapi/drm/msm_drm.h (MIT).
+ */
+static lck_grp_t *gpu_lck_grp;
+static lck_mtx_t *gpu_mtx;
+static volatile uint32_t gpu_seq;
+#define BO_PAGES        (BO_VA_SIZE >> 12)
+#define BO_L3_TABLES    (BO_VA_SIZE >> 21)
+static uint64_t bo_bitmap[BO_PAGES / 64];
+static vm_offset_t bo_l3_va[BO_L3_TABLES];
+static uint64_t bo_l3_pa[BO_L3_TABLES];
+static vm_offset_t bo_l3_chunk;         /* current 16K page being split into 4K tables */
+static uint32_t bo_l3_chunk_used = 4;
+static int bo_pages_used, gpu_submits;
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_bo_pages, CTLFLAG_RD | CTLFLAG_LOCKED, &bo_pages_used, 0,
+    "SWEET GPU: 4K pages mapped for buffer objects");
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_submits, CTLFLAG_RD | CTLFLAG_LOCKED, &gpu_submits, 0,
+    "SWEET GPU: user command submissions");
+
+static bool
+gpu_core_init(void)
+{
+	gpu_lck_grp = lck_grp_alloc_init("sweetgpu", LCK_GRP_ATTR_NULL);
+	gpu_mtx = gpu_lck_grp ? lck_mtx_alloc_init(gpu_lck_grp, LCK_ATTR_NULL) : NULL;
+	if (!gpu_mtx) {
+		return false;
+	}
+	memset((void *)(dma + DMA_PT_L2D), 0, 0x1000);
+	flush_dcache64(dma_pa + DMA_PT_L2D, 0x1000, TRUE);
+	volatile uint64_t *l1 = (volatile uint64_t *)(dma + DMA_PT_L1);
+	l1[(IOVA_BO >> 30) & 3] = (dma_pa + DMA_PT_L2D) | PTE_TABLE;
+	flush_dcache64(dma_pa + DMA_PT_L1, 0x1000, TRUE);
+	*(volatile uint32_t *)(dma + DMA_SCRATCH) = 0;
+	flush_dcache64(dma_pa + DMA_SCRATCH, 64, TRUE);
+	gpu_seq = 0;
+	return true;
+}
+
+static void
+gpu_tlb_flush(void)
+{
+	swr(SMMU_CB(0) + CB_TLBIALL, 0);
+	swr(SMMU_CB(0) + CB_TLBSYNC, 0);
+	for (int i = 0; i < 1000 && (srd(SMMU_CB(0) + CB_TLBSTATUS) & 1u); i++) {
+		delay(1);
+	}
+}
+
+/* Free ring dwords (the CP reads up to RPTR); wait up to 100 ms for n. Lock held. */
+static bool
+rb_space(uint32_t n)
+{
+	uint32_t size = RB_SIZE / 4u;
+	for (int i = 0; i < 5000; i++) {
+		uint32_t rptr = grd(R_CP_RB_RPTR);
+		if (((rptr + size - rb_wptr - 1u) % size) >= n) {
+			return true;
+		}
+		delay(20);
+	}
+	return false;
+}
+
+/* CACHE_FLUSH_TS writing the next sequence number, then start the CP. Lock held. */
+static uint32_t
+rb_fence_kick(void)
+{
+	uint32_t seq = gpu_seq + 1u;
+	uint64_t fence = gaddr(DMA_SCRATCH);
+	rb_pkt7(CP_EVENT_WRITE, 4);
+	rb_out(EV_CACHE_FLUSH_TS);
+	rb_out((uint32_t)fence);
+	rb_out((uint32_t)(fence >> 32));
+	rb_out(seq);
+	gpu_seq = seq;
+	flush_dcache64(dma_pa + DMA_RB, RB_SIZE, TRUE);
+	gwr(R_CP_RB_WPTR, rb_wptr);
+	return seq;
+}
+
+int sweet_gpu_ready(void);
+int
+sweet_gpu_ready(void)
+{
+	return __atomic_load_n(&present_state, __ATOMIC_ACQUIRE) == PRESENT_READY;
+}
+
+/* 0 once fence seq has passed, -1 after timeout_us. */
+int sweet_gpu_wait(uint32_t seq, uint32_t timeout_us);
+int
+sweet_gpu_wait(uint32_t seq, uint32_t timeout_us)
+{
+	volatile uint32_t *fv = (volatile uint32_t *)(dma + DMA_SCRATCH);
+	uint64_t deadline = 0;
+	nanoseconds_to_absolutetime((uint64_t)timeout_us * 1000ull, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		flush_dcache64(dma_pa + DMA_SCRATCH, 64, TRUE);
+		if ((int32_t)(*fv - seq) >= 0) {
+			return 0;
+		}
+		if (mach_absolute_time() > deadline) {
+			return -1;
+		}
+		delay(20);
+	}
+}
+
+static bool
+bo_l3_table(uint32_t t)
+{
+	if (bo_l3_va[t]) {
+		return true;
+	}
+	if (bo_l3_chunk_used == 4) {
+		vm_offset_t va = 0;
+		if (kmem_alloc(kernel_map, &va, 0x4000, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return false;
+		}
+		bo_l3_chunk = va;
+		bo_l3_chunk_used = 0;
+	}
+	vm_offset_t va = bo_l3_chunk + 0x1000u * bo_l3_chunk_used++;
+	uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)va)) | (va & PAGE_MASK);
+	bo_l3_va[t] = va;
+	bo_l3_pa[t] = pa;
+	flush_dcache64(pa, 0x1000, TRUE);
+	volatile uint64_t *l2 = (volatile uint64_t *)(dma + DMA_PT_L2D);
+	l2[t] = pa | PTE_TABLE;
+	flush_dcache64(dma_pa + DMA_PT_L2D + 8u * t, 8, TRUE);
+	return true;
+}
+
+/* GPU address for a buffer object's physical segments (4K aligned); 0 on failure. */
+uint64_t sweet_gpu_map(const uint64_t *seg_pa, const uint64_t *seg_len, uint32_t nseg, uint64_t size);
+uint64_t
+sweet_gpu_map(const uint64_t *seg_pa, const uint64_t *seg_len, uint32_t nseg, uint64_t size)
+{
+	uint64_t pages = (size + 0xfffull) >> 12, covered = 0;
+	for (uint32_t i = 0; i < nseg; i++) {
+		if ((seg_pa[i] & 0xfffull) || (seg_len[i] & 0xfffull)) {
+			return 0;
+		}
+		covered += seg_len[i] >> 12;
+	}
+	if (!sweet_gpu_ready() || pages == 0 || covered < pages || pages > BO_PAGES) {
+		return 0;
+	}
+	lck_mtx_lock(gpu_mtx);
+	/* first fit in the page bitmap */
+	uint64_t run = 0, start = 0;
+	for (uint64_t pg = 0; pg < BO_PAGES; pg++) {
+		if (bo_bitmap[pg / 64] & (1ull << (pg % 64))) {
+			run = 0;
+			continue;
+		}
+		if (run++ == 0) {
+			start = pg;
+		}
+		if (run == pages) {
+			break;
+		}
+	}
+	if (run != pages) {
+		lck_mtx_unlock(gpu_mtx);
+		return 0;
+	}
+	uint32_t seg = 0;
+	uint64_t seg_off = 0;
+	for (uint64_t k = 0; k < pages; k++) {
+		uint64_t pg = start + k;
+		uint32_t t = (uint32_t)(pg >> 9);
+		if (!bo_l3_table(t)) {
+			lck_mtx_unlock(gpu_mtx);
+			return 0;      /* pages mapped so far stay unused in the bitmap: harmless */
+		}
+		volatile uint64_t *l3 = (volatile uint64_t *)bo_l3_va[t];
+		l3[pg & 0x1ff] = (seg_pa[seg] + seg_off) | PTE_PAGE;
+		bo_bitmap[pg / 64] |= 1ull << (pg % 64);
+		seg_off += 0x1000;
+		if (seg_off == seg_len[seg]) {
+			seg++;
+			seg_off = 0;
+		}
+	}
+	for (uint64_t t = start >> 9; t <= (start + pages - 1) >> 9; t++) {
+		flush_dcache64(bo_l3_pa[t], 0x1000, TRUE);
+	}
+	gpu_tlb_flush();
+	bo_pages_used += (int)pages;
+	lck_mtx_unlock(gpu_mtx);
+	return IOVA_BO + (start << 12);
+}
+
+void sweet_gpu_unmap(uint64_t iova, uint64_t size);
+void
+sweet_gpu_unmap(uint64_t iova, uint64_t size)
+{
+	uint64_t pages = (size + 0xfffull) >> 12;
+	if (iova < IOVA_BO || iova + (pages << 12) > IOVA_BO + BO_VA_SIZE || pages == 0) {
+		return;
+	}
+	uint64_t start = (iova - IOVA_BO) >> 12;
+	lck_mtx_lock(gpu_mtx);
+	for (uint64_t k = 0; k < pages; k++) {
+		uint64_t pg = start + k;
+		uint32_t t = (uint32_t)(pg >> 9);
+		if (bo_l3_va[t]) {
+			((volatile uint64_t *)bo_l3_va[t])[pg & 0x1ff] = 0;
+		}
+		bo_bitmap[pg / 64] &= ~(1ull << (pg % 64));
+	}
+	for (uint64_t t = start >> 9; t <= (start + pages - 1) >> 9; t++) {
+		if (bo_l3_va[t]) {
+			flush_dcache64(bo_l3_pa[t], 0x1000, TRUE);
+		}
+	}
+	gpu_tlb_flush();
+	bo_pages_used -= (int)pages;
+	lck_mtx_unlock(gpu_mtx);
+}
+
+/*
+ * Indirect buffers (GPU address, size in dwords) as Linux a5xx_submit,
+ * without preemption: CP_INDIRECT_BUFFER_PFE each, then the fence. Returns
+ * the fence sequence number, 0 on failure.
+ */
+uint32_t sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, uint32_t n);
+uint32_t
+sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, uint32_t n)
+{
+	if (!sweet_gpu_ready() || n == 0 || n > 64) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		if (ib_iova[i] < IOVA_BO || ib_iova[i] + 4ull * ib_dwords[i] > IOVA_BO + BO_VA_SIZE ||
+		    ib_dwords[i] == 0 || ib_dwords[i] > 0xfffff) {
+			return 0;
+		}
+	}
+	lck_mtx_lock(gpu_mtx);
+	if (!rb_space(4u * n + 8u)) {
+		lck_mtx_unlock(gpu_mtx);
+		return 0;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		rb_pkt7(CP_INDIRECT_BUFFER_PFE, 3);
+		rb_out((uint32_t)ib_iova[i]);
+		rb_out((uint32_t)(ib_iova[i] >> 32));
+		rb_out(ib_dwords[i]);
+	}
+	uint32_t seq = rb_fence_kick();
+	gpu_submits++;
+	lck_mtx_unlock(gpu_mtx);
+	return seq;
+}
+
+/* msm_drm.h MSM_PARAM_* values for the A540; -1 if unknown. */
+int sweet_gpu_param(uint32_t param, uint64_t *value);
+int
+sweet_gpu_param(uint32_t param, uint64_t *value)
