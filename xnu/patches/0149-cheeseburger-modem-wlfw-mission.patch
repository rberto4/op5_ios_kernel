 {
 	size = (size + 0xfff) & ~0xfffull;
-	if (pool == NULL || pool_used + size > MODEM_POOL_SIZE) {
+	if (pool == NULL || pool_used + size > MODEM_POOL_ALLOC) {
 		return NULL;
 	}
 	*pa = MODEM_POOL_BASE + pool_used;
@@ -46,6 +46,15 @@ pool_alloc(uint64_t size, uint64_t *pa)
 	return va;
 }
 
+uint8_t *
+sweet_mlink_pool_va(uint64_t pa)
+{
+	if (pool == NULL || pa < MODEM_POOL_BASE || pa >= MODEM_POOL_BASE + MODEM_POOL_SIZE) {
+		return NULL;
+	}
+	return pool + (pa - MODEM_POOL_BASE);
+}
+
 /* ---------------------------------------------------------------- SMEM (topaz) */
 
 /* ---------------------------------------------------------------- SMEM */
@@ -756,6 +765,7 @@ sweet_mlink_watch(unsigned seconds, uint32_t (*slave_kernel)(void))
 	}
 	for (ms = 0; ms < seconds * 1000; ms++) {
 		glink_poll(part, ms);
+		wlfw_poll();
 		if (ms == 3000 || ms == 20000) {
 			glink_summary();
 		}
@@ -767,6 +777,9 @@ sweet_mlink_watch(unsigned seconds, uint32_t (*slave_kernel)(void))
 	}
 	LOG("watch done after %u ms", ms);
 	glink_summary();
+	if (wlfw_mission()) {
+		LOG("W4: WLAN in mission mode");
