+/*
+ * ---- Phase D step 2: the GPU in AppleCLCD's present path ----
+ *
+ * With boot-args sweetfb_gpu=1 and sweetfb_hwscale=1 the display pipe
+ * scales 750x1334 to the panel, so a present is a 1:1 copy of the surface
+ * into the panel's top-left (test 0126). SweetFramebuffer.cpp calls
+ * sweet_gpu_present_start() on its first frame: a kernel thread runs stage
+ * B (mode 5: translated GPU addresses, zap, secure exit; GPU clock from
+ * boot-arg sweetgpu_l, default 43 = 412.8 MHz) and maps the panel. Then
+ * sweet_gpu_present_copy() maps the surface's physical segments at
+ * IOVA_SURF, cleans them from the CPU caches, blits even and odd rows (the
+ * panel pitch is not a multiple of 64, see screen_test) and waits for a
+ * CACHE_FLUSH_TS fence. Any failure returns non-zero and the caller copies
+ * with the CPU; a fence timeout turns the GPU path off for good.
+ */
+static volatile int stage_b_claimed;
+
+static bool
+stage_b_claim(void)
+{
+	int expected = 0;
+	return __atomic_compare_exchange_n(&stage_b_claimed, &expected, 1, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+
+#define PRESENT_IDLE    0
+#define PRESENT_START   1
+#define PRESENT_READY   2
+#define PRESENT_OFF     (-1)
+static volatile int present_state;
+static int present_frames, present_fallbacks, present_us_last, present_us_max;
+static uint32_t present_seq;
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_present_state, CTLFLAG_RD | CTLFLAG_LOCKED, (int *)&present_state, 0,
+    "SWEET GPU present: 0 idle, 1 starting, 2 ready, -1 off");
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_present_frames, CTLFLAG_RD | CTLFLAG_LOCKED, &present_frames, 0,
+    "SWEET GPU present: frames copied by the GPU");
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_present_fallbacks, CTLFLAG_RD | CTLFLAG_LOCKED, &present_fallbacks, 0,
+    "SWEET GPU present: frames left to the CPU after the GPU was ready");
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_present_us_last, CTLFLAG_RD | CTLFLAG_LOCKED, &present_us_last, 0,
+    "SWEET GPU present: last frame, cache clean + map + blit + fence (us)");
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_present_us_max, CTLFLAG_RD | CTLFLAG_LOCKED, &present_us_max, 0,
+    "SWEET GPU present: slowest frame (us)");
+
+static void
+present_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t l = 43;
+	PE_parse_boot_argn("sweetgpu_l", &l, sizeof(l));
+	pll_l = (int)l;
+	if (!stage_b_claim()) {
+		printf("SWEET GPU P: stage B already used by sysctl; GPU present off\n");
+		present_state = PRESENT_OFF;
+		return;
+	}
+	stage_result = stage_b(5);
+	int ok = stage_result == 6;
+	if (ok) {
+		PE_Video video;
+		ok = PE_current_console(&video) == 0 && video.v_baseAddr != 0;
+		if (ok) {
+			fb_pa = video.v_baseAddr;
+			fb_w = (uint32_t)video.v_width;
+			fb_h = (uint32_t)video.v_height;
+			fb_pitch = (uint32_t)video.v_rowBytes;
+			ok = (2u * fb_pitch) % 64u == 0 &&
+			    pt_map_blocks(fb_pa, ((uint64_t)fb_pitch * fb_h + 0x1fffffull) & ~0x1fffffull);
+		}
+	}
+	printf("SWEET GPU P: stage B %d, GPU %d kHz, panel %ux%u pitch %u: GPU present %s\n", stage_result, last_khz,
+	    fb_w, fb_h, fb_pitch, ok ? "ON" : "off");
+	__atomic_store_n(&present_state, ok ? PRESENT_READY : PRESENT_OFF, __ATOMIC_RELEASE);
+}
+
+int sweet_gpu_present_start(void);
+int
+sweet_gpu_present_start(void)
+{
+	int expected = PRESENT_IDLE;
+	if (!__atomic_compare_exchange_n(&present_state, &expected, PRESENT_START, false, __ATOMIC_ACQ_REL,
+	    __ATOMIC_ACQUIRE)) {
+		return 0;
+	}
+	thread_t thread;
+	if (kernel_thread_start(present_thread, NULL, &thread) != KERN_SUCCESS) {
+		present_state = PRESENT_OFF;
+		return -1;
+	}
+	thread_deallocate(thread);
+	return 0;
+}
+
+/* Map the surface segments at IOVA_SURF, 4K pages; false if they do not fit or are not 4K aligned. */
+static bool
+pt_map_surface(const uint64_t *seg_pa, const uint64_t *seg_len, uint32_t nseg)
+{
+	volatile uint64_t *l1 = (volatile uint64_t *)(dma + DMA_PT_L1);
+	volatile uint64_t *l2 = (volatile uint64_t *)(dma + DMA_PT_L2C);
+	volatile uint64_t *l3 = (volatile uint64_t *)(dma + DMA_PT_L3S);
+	memset((void *)(dma + DMA_PT_L3S), 0, 4 * 0x1000);
+	uint64_t at = 0;
+	for (uint32_t i = 0; i < nseg; i++) {
+		if ((seg_pa[i] & 0xfffull) || (seg_len[i] & 0xfffull) || at + seg_len[i] > SURF_WINDOW) {
+			return false;
+		}
+		for (uint64_t o = 0; o < seg_len[i]; o += 0x1000, at += 0x1000) {
+			l3[at >> 12] = (seg_pa[i] + o) | PTE_PAGE;
+		}
+	}
+	if (l1[(IOVA_SURF >> 30) & 3] == 0) {
+		memset((void *)(dma + DMA_PT_L2C), 0, 0x1000);
+		for (uint32_t t = 0; t < 4; t++) {
+			l2[((IOVA_SURF >> 21) & 0x1ff) + t] = (dma_pa + DMA_PT_L3S + 0x1000u * t) | PTE_TABLE;
+		}
+		flush_dcache64(dma_pa + DMA_PT_L2C, 0x1000, TRUE);
+		l1[(IOVA_SURF >> 30) & 3] = (dma_pa + DMA_PT_L2C) | PTE_TABLE;
+		flush_dcache64(dma_pa + DMA_PT_L1, 0x1000, TRUE);
+	}
+	flush_dcache64(dma_pa + DMA_PT_L3S, 4 * 0x1000, TRUE);
+	swr(SMMU_CB(0) + CB_TLBIALL, 0);
+	swr(SMMU_CB(0) + CB_TLBSYNC, 0);
+	for (int i = 0; i < 1000 && (srd(SMMU_CB(0) + CB_TLBSTATUS) & 1u); i++) {
+		delay(1);
+	}
+	return true;
+}
+
+int sweet_gpu_present_copy(const uint64_t *seg_pa, const uint64_t *seg_len, uint32_t nseg, uint32_t src_off,
+    uint32_t bpr, uint32_t sx, uint32_t sy, uint32_t dx, uint32_t dy, uint32_t w, uint32_t h);
+int
+sweet_gpu_present_copy(const uint64_t *seg_pa, const uint64_t *seg_len, uint32_t nseg, uint32_t src_off,
+    uint32_t bpr, uint32_t sx, uint32_t sy, uint32_t dx, uint32_t dy, uint32_t w, uint32_t h)
+{
+	if (__atomic_load_n(&present_state, __ATOMIC_ACQUIRE) != PRESENT_READY) {
+		return -1;
+	}
+	/* even/odd row split: even rows, 64-byte aligned surfaces, inside the panel */
+	if ((2u * bpr) % 64u || (src_off % 64u) || (sy | dy | h) & 1u || w == 0 || h == 0 ||
+	    sx + w > bpr / 4u || dx + w > fb_w || dy + h > fb_h ||
+	    (uint64_t)src_off + (uint64_t)(sy + h) * bpr > SURF_WINDOW) {
+		present_fallbacks++;
+		return -1;
+	}
+	uint64_t t0 = mach_absolute_time();
+	for (uint32_t i = 0; i < nseg; i++) {
+		flush_dcache64(seg_pa[i], (unsigned)seg_len[i], TRUE);     /* backboardd drew with the CPU */
+	}
+	if (!pt_map_surface(seg_pa, seg_len, nseg)) {
+		present_fallbacks++;
+		return -1;
+	}
+	uint64_t src = IOVA_SURF + src_off, vsrc_pitch = 2u * bpr, vdst_pitch = 2u * fb_pitch;
+	rb_blit_setup();
+	rb_blit_copy(src, (uint32_t)vsrc_pitch, IOVA_FB, (uint32_t)vdst_pitch, sx, sy / 2u, dx, dy / 2u, w, h / 2u);
+	rb_blit_copy(src, (uint32_t)vsrc_pitch, IOVA_FB, (uint32_t)vdst_pitch, bpr / 4u + sx, sy / 2u, fb_w + dx,
+	    dy / 2u, w, h / 2u);
+	rb_pkt7(CP_WAIT_FOR_IDLE, 0);
+	uint32_t seq = ++present_seq;
+	uint64_t fence = gaddr(DMA_SCRATCH);
+	rb_pkt7(CP_EVENT_WRITE, 4);
+	rb_out(EV_CACHE_FLUSH_TS);
+	rb_out((uint32_t)fence);
+	rb_out((uint32_t)(fence >> 32));
+	rb_out(seq);
+	flush_dcache64(dma_pa + DMA_RB, RB_SIZE, TRUE);
+	gwr(R_CP_RB_WPTR, rb_wptr);
+	volatile uint32_t *fv = (volatile uint32_t *)(dma + DMA_SCRATCH);
+	for (int i = 0; i < 5000; i++) {        /* 100 ms */
+		flush_dcache64(dma_pa + DMA_SCRATCH, 64, TRUE);
+		if (*fv == seq) {
+			uint64_t us = ns_since(t0) / 1000;
+			present_us_last = (int)us;
+			present_us_max = (int)us > present_us_max ? (int)us : present_us_max;
+			present_frames++;
+			return 0;
+		}
+		delay(20);
+	}
+	printf("SWEET GPU P: frame %u: no fence after 100 ms; GPU present off\n", seq);
+	gpu_dump("present");
+	__atomic_store_n(&present_state, PRESENT_OFF, __ATOMIC_RELEASE);
+	present_fallbacks++;
+	return -1;
+}
