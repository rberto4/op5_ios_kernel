+/*
+ * The surface's physical segments for the GPU (whole memory descriptor; the
+ * GPU maps them in order, so the pixel offset stays s->offset).
+ */
+bool
+AppleCLCD::gpuCopy(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (!fGpuStarted) {
+		fGpuStarted = true;
+		sweet_gpu_present_start();
+		return false;
+	}
+	IOByteCount total = s->memory->getLength(), off = 0;
+	uint32_t n = 0;
+	while (off < total && n < SWEET_FB_GPU_SEGS) {
+		IOByteCount len = 0;
+		addr64_t pa = s->memory->getPhysicalSegment(off, &len, kIOMemoryMapperNone);
+		if (pa == 0 || len == 0) {
+			return false;
+		}
+		if (len > total - off) {
+			len = total - off;
+		}
+		if (n > 0 && fSegPA[n - 1] + fSegLen[n - 1] == pa) {
+			fSegLen[n - 1] += len;
+		} else {
+			fSegPA[n] = pa;
+			fSegLen[n] = len;
+			n++;
+		}
+		off += len;
+	}
+	if (off < total) {
+		return false;
+	}
+	return sweet_gpu_present_copy(fSegPA, fSegLen, n, s->offset, s->bytesPerRow, (uint32_t)sx, (uint32_t)sy,
+	           (uint32_t)dx, (uint32_t)dy, (uint32_t)w, (uint32_t)h) == 0;
+}
