+	printf("SWEET USB: QUSB2 PLL_STATUS 0x%08x POWERDOWN 0x%08x PORT_TUNE1 0x%08x TEST1 0x%08x\n",
+	    usb_rd(phy, 0x1a0), usb_rd(phy, 0x210), usb_rd(phy, 0x23c), usb_rd(phy, 0x24c));
 }
 
