--- /dev/null
+++ b/bsd/dev/sweet_mpss.c
@@ -0,0 +1,565 @@
+/*
+ * Modem W2 part 2 for cheeseburger (OnePlus 5, MSM8998): from "MBA alive"
+ * (sweet_mss.c steps 1-6) to a running, authenticated modem firmware.
+ *
+ *   7  SMP2P: our outbound item 428 in the apps<->modem SMEM partition
+ *      (qcom_smem_alloc_private under TCSR mutex 3 + qcom_smp2p_alloc_outbound_item,
+ *      "master-kernel" entry), doorbell APCS IPC bit 14
+ *   8  modem.mdt metadata (ELF header + hash) to MBA: META_DATA_READY -> status 3
+ *   9  modem.bNN segments into the MPSS carve-out, LOAD_READY, code length,
+ *      carve-out to the modem -> status 4 "MPSS AUTHENTICATED"
+ *  10  watch the modem's inbound item 435 (negotiation, SSR ack) for
+ *      kern.sweetmss_hold seconds: "slave-kernel" bit 1 = "MPSS READY"
+ *
+ * Linux v6.12: remoteproc/qcom_q6v5_mss.c (q6v5_mpss_init_image,
+ * q6v5_mpss_load, q6v5_start), qcom_q6v5.c (request_stop), soc/qcom/
+ * mdt_loader.c (qcom_mdt_read_metadata), smem.c, smp2p.c, hwspinlock/
+ * qcom_hwspinlock.c; msm8998.dtsi smp2p-mpss: items <435>, <428>, local pid 0,
+ * remote pid 1, mboxes <&apcs_glb 14>.
+ *
+ * Carve-out windows are ml_io_map_unmappable (kernel_map; the I/O submap is
+ * only 8 MiB) write-combined, and are unmapped before the region goes to the
+ * modem. The SMEM partition stays mapped (the modem may keep running).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/vnode.h>
+#include <sys/fcntl.h>
+#include <sys/kauth.h>
+#include <sys/proc.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include "sweet_mss.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+
+#define WIMG_WCOMB      0x6             /* VM_WIMG_WCOMB: normal non-cacheable */
+#define MDATA_PA        0xb0000000u     /* low bank, unused by xnu (--highmem), Linux mdata range */
+#define MDT_MAX         0x10000u
+#define CHUNK           0x100000u
+#define SEG_MAX         64
+
+#define SMEM_PA         0x86000000u
+#define SMEM_SIZE       0x00200000u
+#define TCSR_MUTEX3_PA  0x01f43000u     /* tcsr_mutex 0x1f40000, stride 0x1000, lock 3 */
+#define APCS_PA         0x17911000u     /* apcs_glb; IPC doorbell at +8 */
+#define MPSS_DOORBELL   (1u << 14)
+#define APPS_PROC_ID    1
+
+#define SMP2P_IN        435
+#define SMP2P_OUT       428
+#define SMP2P_MAGIC     0x504d5324u     /* "$SMP" */
+#define SMP2P_ITEM_SIZE 340             /* 20 B header + 16 entries x 20 B */
+#define SMEM_CANARY     0xa5a5u
+
+/* ELF32 */
+#define PT_LOAD_        1
+#define MDT_TYPE(f)     (((f) >> 24) & 7)
+#define MDT_TYPE_HASH   2
+#define MDT_RELOC       (1u << 27)
+
+struct phdr32 {
+	uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align;
+};
+
+static vm_offset_t smem_ptable, smem_part, mutex3, apcs;
+static uint32_t part_size;
+static vm_offset_t smp2p_out;   /* our item, in smem_part */
+static bool negotiated, ssr_ack_enabled, ssr_ack;
+
+#define rd sweet_mss_rd
+#define wr sweet_mss_wr
+
+static void
+kick(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(apcs, 8, MPSS_DOORBELL);
+}
+
+/* ---- carve-out windows ---- */
+
+struct win {
+	vm_offset_t va, base;
+	vm_size_t len;
+};
+
+static bool
+win_map(struct win *w, uint64_t pa, size_t len)
+{
+	w->va = ml_io_map_unmappable((vm_offset_t)pa, len, WIMG_WCOMB);
+	w->base = w->va & ~(vm_offset_t)PAGE_MASK;
+	w->len = round_page(len + (w->va - w->base));
+	return w->va != 0;
+}
+
+static void
+win_unmap(struct win *w)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ml_io_unmap(w->base, w->len);
+	w->va = 0;
+}
+
+/* ---- SMEM (smem.c) ---- */
+
+static bool
+smem_map(void)
+{
+	if (smem_part) {
+		return true;
+	}
+	smem_ptable = ml_io_map(SMEM_PA + SMEM_SIZE - 0x1000, 0x1000);
+	mutex3 = ml_io_map(TCSR_MUTEX3_PA, 0x1000);
+	apcs = ml_io_map(APCS_PA, 0x1000);
+	if (rd(smem_ptable, 0) != 0x434f5424u) {        /* "$TOC" */
+		printf("SWEET MPSS: no SMEM ptable\n");
+		return false;
+	}
+	uint32_t n = rd(smem_ptable, 8);
+	for (uint32_t i = 0; i < n && i < 32; ++i) {
+		vm_offset_t e = smem_ptable + 32 + 48 * i;
+		uint32_t off = rd(e, 0), size = rd(e, 4), hosts = rd(e, 12);
+		if ((hosts == 1 || hosts == 0x10000) && off && size && off + size <= SMEM_SIZE) {
+			smem_part = ml_io_map_unmappable(SMEM_PA + off, size, WIMG_WCOMB);
+			part_size = size;
+			printf("SWEET MPSS: apps<->modem partition +%#x size %#x free %#x/%#x\n", off, size,
+			    rd(smem_part, 12), rd(smem_part, 16));
+			return rd(smem_part, 0) == 0x54525024u;         /* "$PRT" */
+		}
+	}
+	printf("SWEET MPSS: no apps<->modem partition\n");
+	return false;
+}
+
+/* Find a private uncached item; returns its data address or 0. */
+static vm_offset_t
+smem_find(uint32_t item, uint32_t *size_out)
+{
+	uint32_t end = rd(smem_part, 12);
+	uint32_t off = 32;
+	while (off + 16 <= end && end <= part_size) {
+		uint32_t w0 = rd(smem_part, off), size = rd(smem_part, off + 4);
+		uint32_t pad = rd(smem_part, off + 8) >> 16;
+		if ((w0 & 0xffff) != SMEM_CANARY) {
+			printf("SWEET MPSS: bad SMEM canary at +%#x\n", off);
+			return 0;
+		}
+		if ((w0 >> 16) == item) {
+			*size_out = size;
+			return smem_part + off + 16 + pad;
+		}
+		off += 16 + pad + size;
+	}
+	return 0;
+}
+
+static bool
+hwlock(void)
+{
+	for (unsigned i = 0; i < 1000000; ++i) {
+		wr(mutex3, 0, APPS_PROC_ID);
+		if (rd(mutex3, 0) == APPS_PROC_ID) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* qcom_smem_alloc_private; nothing is printed while the lock is held. */
+static int
+smem_alloc(uint32_t item, uint32_t size)
+{
+	uint32_t asize = (size + 7) & ~7u, have = 0;
+	if (smem_find(item, &have)) {
+		return have >= size ? 0 : EEXIST;
+	}
+	if (!hwlock()) {
+		return EBUSY;
+	}
+	uint32_t end = rd(smem_part, 12), cached = rd(smem_part, 16);
+	int err = 0;
+	if (end + 16 + asize > cached || cached > part_size) {
+		err = ENOSPC;
+	} else {
+		wr(smem_part, end, SMEM_CANARY | item << 16);
+		wr(smem_part, end + 4, asize);
+		wr(smem_part, end + 8, asize - size);   /* padding_data, padding_hdr 0 */
+		wr(smem_part, end + 12, 0);
+		wr(smem_part, 12, end + 16 + asize);    /* wr() orders the header first */
+	}
+	wr(mutex3, 0, 0);
+	return err;
+}
+
+/* ---- SMP2P (smp2p.c) ---- */
+
+static int
+smp2p_alloc_out(struct mss_state *s)
+{
+	uint32_t size = 0;
+	int err = smem_alloc(SMP2P_OUT, SMP2P_ITEM_SIZE);
+	smp2p_out = err ? 0 : smem_find(SMP2P_OUT, &size);
+	printf("SWEET MPSS: SMEM item %u: err %d at +%#lx size %u\n", SMP2P_OUT, err,
+	    smp2p_out ? (unsigned long)(smp2p_out - smem_part) : 0ul, size);
+	if (!smp2p_out) {
+		return err ? err : ENOENT;
+	}
+	for (uint32_t o = 0; o < SMP2P_ITEM_SIZE; o += 4) {
+		wr(smp2p_out, o, 0);
+	}
+	wr(smp2p_out, 0, SMP2P_MAGIC);
+	wr(smp2p_out, 4, 1u << 8);              /* version 0 (not valid yet), features SSR_ACK */
+	wr(smp2p_out, 8, 0 | 1u << 16);         /* local pid 0, remote pid 1 */
+	wr(smp2p_out, 12, 16);                  /* total 16, valid 0 */
+	wr(smp2p_out, 4, 1 | 1u << 8);          /* version 1 last */
+	kick();
+	static const char name[16] = "master-kernel";
+	for (uint32_t o = 0; o < 16; o += 4) {
+		wr(smp2p_out, 20 + o, (uint32_t)(uint8_t)name[o] | (uint32_t)(uint8_t)name[o + 1] << 8 |
+		    (uint32_t)(uint8_t)name[o + 2] << 16 | (uint32_t)(uint8_t)name[o + 3] << 24);
+	}
+	wr(smp2p_out, 36, 0);
+	wr(smp2p_out, 12, 16 | 1u << 16);       /* valid 1 */
+	kick();
+	negotiated = ssr_ack_enabled = ssr_ack = false;
+	s->smp2p_out = true;
+	return 0;
+}
+
+/* One poll of the inbound item: negotiation, SSR ack, entries; returns slave-kernel value or ~0. */
+static uint32_t
+smp2p_poll(uint32_t *last, unsigned nlast, bool *seen_hdr)
+{
+	uint32_t size = 0;
+	vm_offset_t in = smem_find(SMP2P_IN, &size);
+	if (!in || rd(in, 0) != SMP2P_MAGIC) {
+		return ~0u;
+	}
+	uint32_t vf = rd(in, 4), pids = rd(in, 8), tv = rd(in, 12), flags = rd(in, 16);
+	if (!*seen_hdr) {
+		printf("SWEET MPSS: inbound %u: version %u features %#x pid %u->%u entries %u/%u flags %#x\n",
+		    SMP2P_IN, vf & 0xff, vf >> 8, pids & 0xffff, pids >> 16, tv >> 16, tv & 0xffff, flags);
+		*seen_hdr = true;
+	}
+	uint32_t outvf = rd(smp2p_out, 4);
+	if (!negotiated && (vf & 0xff) == (outvf & 0xff)) {
+		uint32_t feat = (outvf >> 8) & (vf >> 8);
+		wr(smp2p_out, 4, (outvf & 0xff) | feat << 8);
+		negotiated = true;
+		ssr_ack_enabled = feat & 1;
+		printf("SWEET MPSS: SMP2P negotiated, features %#x\n", feat);
+	}
+	if (ssr_ack_enabled && (flags & 1) != ssr_ack) {
+		ssr_ack = flags & 1;
+		wr(smp2p_out, 16, (rd(smp2p_out, 16) & ~2u) | (ssr_ack ? 2u : 0));
+		kick();
+		printf("SWEET MPSS: SSR ack %d\n", ssr_ack);
+	}
+	uint32_t valid = tv >> 16, slave = ~0u;
+	for (uint32_t i = 0; i < valid && i < 16 && i < nlast; ++i) {
+		char name[17];
+		for (uint32_t o = 0; o < 16; o += 4) {
+			uint32_t w = rd(in, 20 + 20 * i + o);
+			for (uint32_t k = 0; k < 4; ++k) {
+				name[o + k] = (char)(w >> (8 * k));
+			}
+		}
+		name[16] = 0;
+		uint32_t v = rd(in, 36 + 20 * i);
+		if (v != last[i]) {
+			printf("SWEET MPSS: inbound entry %u \"%s\" = %#x\n", i, name, v);
+			last[i] = v;
+		}
+		if (strncmp(name, "slave-kernel", 16) == 0) {
+			slave = v;
+		}
+	}
+	return slave;
+}
+
+/* ---- MPSS image (mdt_loader.c, q6v5_mpss_init_image / q6v5_mpss_load) ---- */
+
+static const struct phdr32 *
+mdt_phdrs(const uint8_t *mdt, size_t len, uint32_t *n_out)
+{
+	uint32_t phoff = *(const uint32_t *)(const void *)(mdt + 0x1c);
+	uint32_t n = *(const uint16_t *)(const void *)(mdt + 0x2c);
+	if (len < 52 || *(const uint32_t *)(const void *)mdt != 0x464c457fu || mdt[4] != 1 ||
+	    n < 2 || n > SEG_MAX || phoff + n * sizeof(struct phdr32) > len) {
+		return NULL;
+	}
+	*n_out = n;
+	return (const struct phdr32 *)(const void *)(mdt + phoff);
+}
+
+/* Step 8 */
+static int
+mpss_metadata(const uint8_t *mdt, size_t len, const struct phdr32 *ph, uint32_t n)
+{
+	uint32_t hash = 0;
+	for (uint32_t i = 1; i < n && !hash; ++i) {
+		hash = MDT_TYPE(ph[i].flags) == MDT_TYPE_HASH ? i : 0;
+	}
+	uint32_t ehdr = ph[0].filesz, hsize = hash ? ph[hash].filesz : 0;
+	uint32_t hoff = ehdr + hsize == len ? ehdr : ph[hash].offset;
+	if (!hash || ph[0].type == PT_LOAD_ || ehdr > len || hoff + hsize > len) {
+		printf("SWEET MPSS: modem.mdt: no usable header/hash (hash ph%u)\n", hash);
+		return EINVAL;
+	}
+	uint32_t mlen = ehdr + hsize;
+	struct win w;
+	if (!win_map(&w, MDATA_PA, mlen)) {
+		return ENOMEM;
+	}
+	memcpy((void *)w.va, mdt, ehdr);
+	memcpy((void *)(w.va + ehdr), mdt + hoff, hsize);
+	win_unmap(&w);
+	vm_offset_t rmb = sweet_mss_rmb();
+	wr(rmb, RMB_PMI_CODE_LENGTH, 0);
+	uint64_t perm = 1ull << VMID_HLOS;
+	if (sweet_mss_xfer(MDATA_PA, mlen, &perm, false, true)) {
+		return EIO;
+	}
+	wr(rmb, RMB_PMI_META_DATA, MDATA_PA);
+	wr(rmb, RMB_MBA_COMMAND, 1);            /* RMB_CMD_META_DATA_READY */
+	int32_t st = 0;
+	unsigned ms;
+	for (ms = 0; ms <= 1000; ++ms) {
+		st = (int32_t)rd(rmb, RMB_MBA_STATUS);
+		if (st < 0 || st == 3) {
+			break;
+		}
+		delay(1000);
+	}
+	printf("SWEET MPSS: metadata %u B (header %u + hash ph%u %u): MBA status %d after %u ms\n", mlen,
+	    ehdr, hash, hsize, st, ms);
+	if (sweet_mss_xfer(MDATA_PA, mlen, &perm, true, false)) {
+		printf("SWEET MPSS: metadata buffer not reclaimed (outside xnu RAM; harmless)\n");
+	}
+	return st == 3 ? 0 : EACCES;
+}
+
+/* Copy one segment file into [pa, pa + memsz) in 1 MiB windows, zero the tail. */
+static int
+load_segment(uint32_t idx, uint64_t pa, uint32_t filesz, uint32_t memsz, uint8_t *buf)
+{
+	char name[64];
+	snprintf(name, sizeof(name), "%smodem.b%02u", MSS_FW_DIR, idx);
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	int err = filesz ? vnode_open(name, FREAD, 0, 0, &vp, ctx) : 0;
+	if (err) {
+		printf("SWEET MPSS: %s: open error %d\n", name, err);
+		return err;
+	}
+	for (uint32_t off = 0; off < memsz && !err; off += CHUNK) {
+		uint32_t n = memsz - off < CHUNK ? memsz - off : CHUNK;
+		uint32_t fn = off < filesz ? (filesz - off < n ? filesz - off : n) : 0;
+		int resid = 0;
+		if (fn) {
+			err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)fn, (off_t)off, UIO_SYSSPACE, 0,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			err = err ? err : (resid ? EIO : 0);
+		}
+		struct win w;
+		if (!err && win_map(&w, pa + off, n)) {
+			memcpy((void *)w.va, buf, fn);
+			bzero((void *)(w.va + fn), n - fn);
+			win_unmap(&w);
+		}
+	}
+	if (vp) {
+		vnode_close(vp, FREAD, ctx);
+	}
+	if (err) {
+		printf("SWEET MPSS: %s: read error %d\n", name, err);
+	}
+	return err;
+}
+
+/* Step 9 */
+static int
+mpss_segments(struct mss_state *s, const struct phdr32 *ph, uint32_t n)
+{
+	uint64_t min = ~0ull;
+	bool reloc = false;
+	for (uint32_t i = 0; i < n; ++i) {
+		if (ph[i].type == PT_LOAD_ && MDT_TYPE(ph[i].flags) != MDT_TYPE_HASH && ph[i].memsz) {
+			reloc |= (ph[i].flags & MDT_RELOC) != 0;
+			min = ph[i].paddr < min ? ph[i].paddr : min;
+		}
+	}
+	uint64_t base = reloc ? min : MPSS_PA;
+	if (sweet_mss_xfer(MPSS_PA, MPSS_SIZE, &s->mpss_perm, true, false) ||
+	    sweet_mss_xfer(MPSS_PA, MPSS_SIZE, &s->mpss_perm, true, true)) {
+		return EIO;
+	}
+	s->mpss_loading = true;
+	uint8_t *buf = kalloc_data(CHUNK, Z_WAITOK);
+	if (!buf) {
+		return ENOMEM;
+	}
+	vm_offset_t rmb = sweet_mss_rmb();
+	uint32_t size = 0, nseg = 0;
+	uint64_t t0 = mach_absolute_time();
+	int err = 0;
+	for (uint32_t i = 0; i < n && !err; ++i) {
+		if (ph[i].type != PT_LOAD_ || MDT_TYPE(ph[i].flags) == MDT_TYPE_HASH || !ph[i].memsz) {
+			continue;
+		}
+		uint64_t off = ph[i].paddr - base;
+		if (ph[i].paddr < base || off + ph[i].memsz > MPSS_SIZE || ph[i].filesz > ph[i].memsz) {
+			printf("SWEET MPSS: ph%u outside the carve-out or filesz > memsz\n", i);
+			err = EINVAL;
+			break;
+		}
+		err = load_segment(i, MPSS_PA + off, ph[i].filesz, ph[i].memsz, buf);
+		size += ph[i].memsz;
+		nseg++;
+		if (!err && rd(rmb, RMB_PMI_CODE_LENGTH) == 0) {
+			wr(rmb, RMB_PMI_CODE_START, reloc ? MPSS_PA : (uint32_t)min);
+			wr(rmb, RMB_MBA_COMMAND, 2);    /* RMB_CMD_LOAD_READY */
+		}
+		wr(rmb, RMB_PMI_CODE_LENGTH, size);
+		if (!err && (int32_t)rd(rmb, RMB_MBA_STATUS) < 0) {
+			printf("SWEET MPSS: MBA rejected ph%u: status %d\n", i, (int32_t)rd(rmb, RMB_MBA_STATUS));
+			err = EACCES;
+		}
+	}
+	kfree_data(buf, CHUNK);
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("SWEET MPSS: %u segments, code length %#x, %llu ms, MBA status %d\n", nseg, size,
+	    ns / 1000000, (int32_t)rd(rmb, RMB_MBA_STATUS));
+	return err;
+}
+
+/* Step 9 end: MPSS to the modem only, wait RMB_MBA_AUTH_COMPLETE. */
+static int
+mpss_auth(struct mss_state *s)
+{
+	if (sweet_mss_xfer(MPSS_PA, MPSS_SIZE, &s->mpss_perm, false, true)) {
+		return EIO;
+	}
+	vm_offset_t rmb = sweet_mss_rmb();
+	int32_t st = 0;
+	unsigned ms;
+	for (ms = 0; ms <= 10000; ++ms) {
+		st = (int32_t)rd(rmb, RMB_MBA_STATUS);
+		if (st < 0 || st == 4) {
+			break;
+		}
+		delay(1000);
+	}
+	printf("SWEET MPSS: MBA status %d after %u ms%s\n", st, ms, st == 4 ? ": MPSS AUTHENTICATED" : "");
+	s->mpss_running = st == 4;
+	return st == 4 ? 0 : EACCES;
+}
+
+/* Step 10 */
+static bool
+smp2p_watch(struct mss_state *s, int hold_s)
+{
+	uint32_t last[16];
+	bool seen = false, found = false;
+	memset(last, 0xff, sizeof(last));
+	for (int i = 0; i < hold_s * 10; ++i) {
+		uint32_t v = smp2p_poll(last, 16, &seen);
+		if (seen && !found) {
+			found = true;
+		}
+		if (v != ~0u && (v & 1)) {
+			printf("SWEET MPSS: slave-kernel fatal bit set (%#x)\n", v);
+			s->ready = false;
+			return false;
+		}
+		if (v != ~0u && (v & 2) && !s->ready) {
+			s->ready = true;
+			printf("SWEET MPSS: MPSS READY after %d ms\n", i * 100);
+			/* q6v5_start: the MBA region goes back to HLOS once the modem runs */
+			(void)sweet_mss_xfer(MBA_PA, MBA_SIZE, &s->mba_perm, true, false);
+		}
+		delay(100 * 1000);
+	}
+	if (!found) {
+		printf("SWEET MPSS: inbound item %u never appeared\n", SMP2P_IN);
+	}
+	return s->ready;
+}
+
+void
+sweet_mpss_request_stop(struct mss_state *s)
+{
+	if (!smp2p_out || !s->ready) {
+		return;
+	}
+	wr(smp2p_out, 36, rd(smp2p_out, 36) | 1);       /* master-kernel bit 0 = stop */
+	kick();
+	uint32_t last[16];
+	bool seen = true;
+	unsigned ms = 0;
+	memset(last, 0xff, sizeof(last));
+	for (; ms < 5000; ms += 10) {
+		uint32_t v = smp2p_poll(last, 16, &seen);
+		if (v != ~0u && (v & 8)) {
+			break;
+		}
+		delay(10 * 1000);
+	}
+	wr(smp2p_out, 36, rd(smp2p_out, 36) & ~1u);
+	kick();
+	printf("SWEET MPSS: stop request: %s after %u ms\n", ms < 5000 ? "stop-ack" : "no ack", ms);
+}
+
+int
+sweet_mpss_run(struct mss_state *s, int last, int hold_s)
+{
+	int reached = 6;
+	size_t len = 0;
+	uint8_t *mdt = NULL;
+	uint32_t n = 0;
+	const struct phdr32 *ph;
+	sweet_mss_announce(7, "SMP2P outbound item 428 (first write into shared SMEM)");
+	if (!smem_map() || smp2p_alloc_out(s)) {
+		return reached;
+	}
+	reached = 7;
+	if (last < 8) {
+		return reached;
+	}
+	sweet_mss_announce(8, "modem.mdt metadata to the MBA");
+	mdt = sweet_mss_read_file("modem.mdt", MDT_MAX, &len);
+	ph = mdt ? mdt_phdrs(mdt, len, &n) : NULL;
+	if (!ph || mpss_metadata(mdt, len, ph, n)) {
+		goto out;
+	}
+	reached = 8;
+	if (last < 9) {
+		goto out;
+	}
+	sweet_mss_announce(9, "load modem.bNN into MPSS and authenticate");
+	if (mpss_segments(s, ph, n) || mpss_auth(s)) {
+		goto out;
+	}
+	reached = 9;
+	if (last < 10) {
+		goto out;
+	}
+	sweet_mss_announce(10, "watch the modem's SMP2P state");
+	if (smp2p_watch(s, hold_s > 0 ? hold_s : 20)) {
+		reached = 10;
+	}
+out:
+	if (mdt) {
+		kfree_data(mdt, MDT_MAX);
+	}
+	return reached;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
