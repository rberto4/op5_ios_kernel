+/*
+ * Shared between sweet_mss.c (MBA boot, W2 part 1) and sweet_mpss.c (MPSS
+ * load + SMP2P, W2 part 2) for cheeseburger (OnePlus 5, MSM8998).
+ */
+#ifndef _SWEET_MSS_H_
+#define _SWEET_MSS_H_
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#define MSS_FW_DIR      "/usr/local/share/op5fw/"
+
+/* Carve-outs (phone DT / Android dmesg) */
+#define MPSS_PA         0x8d000000u
