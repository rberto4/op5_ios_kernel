From 86be40d63e1c34e3178b19a7326c3b8e612b536a Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 25 Nov 2026 23:36:16 +0100
Subject: [PATCH] cheeseburger: serve the modem's DIAG over QRTR as linux-msm
 diag-router does

lkml 2021 (Pixel 2 XL DT): "without [diag-router] the wifi firmware crashes every 10 seconds or so.
This is the same issue encountered on the OnePlus 5." That is our DOG_HB starvation ~7-9 s after
WLAN mission (0165-0168 did not change it; taimen ruled out a dozen more causes). Publish DIAG
service 4097 instances 0 (cntl), 2 (data), 4 (dci); answer the modem's feature mask with ours,
masks all disabled, real-time mode, streaming buffering; give DIAG_IDs; drain data and DCI.
kern.sweetdiag, default 1.
---
 bsd/dev/sweet_msvc.c | 269 ++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 265 insertions(+), 4 deletions(-)

diff --git a/bsd/dev/sweet_msvc.c b/bsd/dev/sweet_msvc.c
index 32fa630..1c0ed53 100644
--- a/bsd/dev/sweet_msvc.c
+++ b/bsd/dev/sweet_msvc.c
@@ -116,6 +116,9 @@ efs_read(const char *part, uint64_t off, void *dst, uint64_t n)
 #define PORT_DMSC           0x4005              /* our QMI client port towards DMS */
 #define PORT_SRNC           0x4006              /* our QMI client port towards servreg-notif */
 #define PORT_WLPS           0x4007              /* our QMI client port towards WLPS (0168) */
+#define PORT_DIAG_CNTL      0x4008              /* DIAG over QRTR (0169): control, inst 0 */
+#define PORT_DIAG_DATA      0x4009              /* DIAG data, inst 2 */
+#define PORT_DIAG_DCI       0x400a              /* DIAG DCI, inst 4 */
 #define PORT_SESS           0x4100
 
 /* generated by fwtable_all.py from NON-HLOS.bin (HyperOS 2.0.208 modem_a): 657 files, 657 extents */
@@ -779,11 +782,33 @@ rmtfs_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg, const uint8_t
 }
 
 
+/*
+ * 0169: DIAG router over QRTR (linux-msm/diag router/peripheral-qrtr.c). lkml 2021 (Pixel 2 XL DT):
+ * "without [diag-router] the wifi firmware crashes every 10 seconds or so. This is the same issue
+ * encountered on the OnePlus 5." = our DOG_HB starvation after WLAN mission. The AP publishes
+ * service 4097 (0x1001) instance 0 (CNTL), 2 (DATA), 4 (DCI) (diag puts the instance where QMI puts
+ * the version); the modem connects to them. kern.sweetdiag: 0 = off, 1 = on (default).
+ */
+#define DIAG_SVC            4097
+static int sweet_diag = 1;
+SYSCTL_INT(_kern, OID_AUTO, sweetdiag, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_diag, 0,
+    "DIAG router over QRTR (svc 0x1001 cntl/data/dci) as linux-msm diag-router: 0 = no, 1 = yes");
+
 static const uint32_t svc[][3] = {
 	{ 0x40, 0x101, PORT_PDM },              /* servreg-locator, version 0x101 instance 0 */
 	{ 4096, 1,     PORT_TFTP },             /* tftp */
 	{ 14,   1,     PORT_RMTFS },            /* rmtfs */
+	{ DIAG_SVC, 0, PORT_DIAG_CNTL },        /* diag control (0169) */
+	{ DIAG_SVC, 2, PORT_DIAG_DATA },        /* diag data */
+	{ DIAG_SVC, 4, PORT_DIAG_DCI },         /* diag dci */
 };
+#define SVC_N               (sizeof(svc) / sizeof(svc[0]))
+
+static bool
+svc_enabled(unsigned i)
+{
+	return svc[i][0] != DIAG_SVC || sweet_diag > 0;
+}
 
 /* Linux qrtr ns ctrl_cmd_new_lookup: every matching server of ours, then an empty NEW_SERVER
  * (end of list) to the asking port. instance 0 = any. */
@@ -791,8 +816,8 @@ void
 svc_lookup(uint32_t node, uint32_t port, uint32_t service, uint32_t instance)
 {
 	unsigned n = 0;
-	for (unsigned i = 0; i < 3; i++) {
-		if (svc[i][0] != service || (instance != 0 && svc[i][1] != instance)) {
+	for (unsigned i = 0; i < SVC_N; i++) {
+		if (!svc_enabled(i) || svc[i][0] != service || (instance != 0 && svc[i][1] != instance)) {
 			continue;
 		}
 		struct qrtr_ctrl c = { QRTR_TYPE_NEW_SERVER, svc[i][0], svc[i][1], QRTR_NODE_APPS, svc[i][2] };
@@ -1004,14 +1029,246 @@ wlps_rx(const uint8_t *d, uint32_t len)
 	LOG("t=%u ms: wlps: type %u msg %x result %u error %u", g_ms, d[0], msg, res, err);
 }
 
+/*
+ * 0169 DIAG control protocol (linux-msm/diag router/diag_cntl.c). Packets: u32 cmd, u32 len, body.
+ * Modem FEATURE_MASK (8) -> ours back, then masks all disabled (msg 11, log 9, event 10), DIAG_MODE
+ * real time (3), buffering streaming (17), as diag_cntl_send_feature_mask(). DIAG_ID (33) -> an id.
+ * REGISTER (1) / DEREGISTER (27) / NUM_PRESETS (12) need no answer. DATA and DCI are drained.
+ */
+#define DIAG_CNTL_REGISTER      1
+#define DIAG_CNTL_DIAG_MODE     3
+#define DIAG_CNTL_FEATURE_MASK  8
+#define DIAG_CNTL_LOG_MASK      9
+#define DIAG_CNTL_EVENT_MASK    10
+#define DIAG_CNTL_MSG_MASK      11
+#define DIAG_CNTL_NUM_PRESETS   12
+#define DIAG_CNTL_BUFFERING     17
+#define DIAG_CNTL_DEREGISTER    27
+#define DIAG_CNTL_DIAG_ID       33
+#define DIAG_MASK_ALL_DISABLED  1
+#define DIAG_F_FEATURE_MASK     (1u << 0)
+#define DIAG_F_MASTER_MASK      (1u << 1)
+#define DIAG_F_APPS_HDLC        (1u << 6)
+#define DIAG_F_SOCKETS          (1u << 13)
+#define DIAG_LOCAL_FEATURES     (DIAG_F_FEATURE_MASK | DIAG_F_MASTER_MASK | DIAG_F_APPS_HDLC | DIAG_F_SOCKETS)
+
+static unsigned diag_cntl_msgs, diag_regs, diag_data_pkts, diag_dci_pkts;
+static uint64_t diag_data_bytes;
+static uint32_t diag_next_id = 1;               /* DIAG_ID_APPS = 1, peripherals from 2 */
+
+struct dpkt { uint8_t b[64]; uint32_t n; };
+
+static void
+dp_init(struct dpkt *p, uint32_t cmd)
+{
+	memset(p, 0, sizeof(*p));
+	memcpy(p->b, &cmd, 4);
+	p->n = 8;
+}
+
+static void
+dp_put(struct dpkt *p, const void *v, uint32_t len)
+{
+	if (p->n + len <= sizeof(p->b)) {
+		memcpy(p->b + p->n, v, len);
+		p->n += len;
+	}
+}
+
+static void
+dp_u8(struct dpkt *p, uint8_t v)
+{
+	dp_put(p, &v, 1);
+}
+
+static void
+dp_u32(struct dpkt *p, uint32_t v)
+{
+	dp_put(p, &v, 4);
+}
+
+static void
+dp_send(struct dpkt *p, uint32_t node, uint32_t port)
+{
+	uint32_t body = p->n - 8;
+	memcpy(p->b + 4, &body, 4);
+	qrtr_send(QRTR_TYPE_DATA, PORT_DIAG_CNTL, node, port, p->b, p->n);
+}
+
+static void
+diag_send_masks_off(uint32_t node, uint32_t port)
+{
+	struct dpkt p;
+
+	dp_init(&p, DIAG_CNTL_MSG_MASK);         /* stream 1, all disabled, mode 0, range 0-0, 0 items */
+	dp_u8(&p, 1);
+	dp_u8(&p, DIAG_MASK_ALL_DISABLED);
+	dp_u8(&p, 0);
+	dp_u32(&p, 0);
+	dp_u32(&p, 0);
+	dp_send(&p, node, port);
+
+	dp_init(&p, DIAG_CNTL_LOG_MASK);         /* stream 1, all disabled, equip 0, 0 items, size 0 */
+	dp_u8(&p, 1);
+	dp_u8(&p, DIAG_MASK_ALL_DISABLED);
+	dp_u8(&p, 0);
+	dp_u32(&p, 0);
+	dp_u32(&p, 0);
+	dp_send(&p, node, port);
+
+	dp_init(&p, DIAG_CNTL_EVENT_MASK);       /* stream 1, all disabled, config 0, size 0 */
+	dp_u8(&p, 1);
+	dp_u8(&p, DIAG_MASK_ALL_DISABLED);
+	dp_u8(&p, 0);
+	dp_u32(&p, 0);
+	dp_send(&p, node, port);
+}
+
+static void
+diag_send_setup(uint32_t node, uint32_t port, uint32_t features)
+{
+	struct dpkt p;
+
+	dp_init(&p, DIAG_CNTL_FEATURE_MASK);     /* mask_len 4, mask, 2 spare bytes as the router */
+	dp_u32(&p, 4);
+	dp_u32(&p, features);
+	dp_u8(&p, 0);
+	dp_u8(&p, 0);
+	dp_send(&p, node, port);
+
+	diag_send_masks_off(node, port);
+
+	dp_init(&p, DIAG_CNTL_DIAG_MODE);        /* v1: sleep_vote 1, real_time 1, rest 0 */
+	dp_u32(&p, 1);
+	dp_u32(&p, 1);
+	dp_u32(&p, 1);
+	for (unsigned i = 0; i < 6; i++) {
+		dp_u32(&p, 0);
+	}
+	dp_send(&p, node, port);
+
+	dp_init(&p, DIAG_CNTL_BUFFERING);        /* v1: stream 0, streaming */
+	dp_u32(&p, 1);
+	dp_u8(&p, 0);
+	dp_u8(&p, 0);
+	dp_send(&p, node, port);
+}
+
+static void
+diag_send_id(uint32_t node, uint32_t port, const uint8_t *body, uint32_t blen)
+{
+	struct dpkt p;
+	uint32_t version = 0, id = 0;
+	char name[24];
+	size_t nl;
+
+	if (blen < 8) {
+		return;
+	}
+	memcpy(&version, body, 4);
+	memcpy(&id, body + 4, 4);
+	nl = MIN((size_t)(blen - 8), sizeof(name) - 1);
+	memcpy(name, body + 8, nl);
+	name[nl] = 0;
+	nl = strnlen(name, sizeof(name) - 1);
+	if (version < 3) {
+		id = ++diag_next_id;
+	}
+	dp_init(&p, DIAG_CNTL_DIAG_ID);
+	dp_u32(&p, 1);
+	dp_u32(&p, id);
+	dp_put(&p, name, (uint32_t)nl);
+	dp_u8(&p, 0);
+	dp_send(&p, node, port);
+	LOG("t=%u ms: diag: DIAG_ID v%u \"%s\" -> id %u", g_ms, version, name, id);
+}
+
+static void
+diag_cntl_cmd(uint32_t node, uint32_t port, uint32_t cmd, const uint8_t *body, uint32_t blen)
+{
+	uint32_t ml = 0, mask = 0;
+
+	switch (cmd) {
+	case DIAG_CNTL_FEATURE_MASK:
+		if (blen >= 8) {
+			memcpy(&ml, body, 4);
+			memcpy(&mask, body + 4, 4);
+		}
+		LOG("t=%u ms: diag: modem feature mask %x (len %u) from %u:%x -> ours %x, masks off, real time",
+		    g_ms, mask, ml, node, port, mask & DIAG_LOCAL_FEATURES);
+		diag_send_setup(node, port, mask & DIAG_LOCAL_FEATURES);
+		break;
+	case DIAG_CNTL_DIAG_ID:
+		diag_send_id(node, port, body, blen);
+		break;
+	case DIAG_CNTL_REGISTER:
+		diag_regs++;
+		break;
+	case DIAG_CNTL_DEREGISTER:
+	case DIAG_CNTL_NUM_PRESETS:
+		break;
+	default:
+		LOG("t=%u ms: diag: cntl cmd %u len %u ignored", g_ms, cmd, blen);
+		break;
+	}
+}
+
+static void
+diag_cntl_rx(uint32_t node, uint32_t port, const uint8_t *d, uint32_t len)
+{
+	uint32_t off = 0;
+
+	while (off + 8 <= len) {
+		uint32_t cmd, blen;
+		memcpy(&cmd, d + off, 4);
+		memcpy(&blen, d + off + 4, 4);
+		if (blen > len - off - 8) {
+			LOG("t=%u ms: diag: truncated cntl cmd %u len %u (have %u)", g_ms, cmd, blen, len - off - 8);
+			return;
+		}
+		diag_cntl_msgs++;
+		diag_cntl_cmd(node, port, cmd, d + off + 8, blen);
+		off += 8 + blen;
+	}
+}
+
+static void
+diag_rx(uint32_t node, uint32_t port, uint32_t dst_port, const uint8_t *d, uint32_t len)
+{
+	if (dst_port == PORT_DIAG_CNTL) {
+		if (diag_cntl_msgs == 0) {
+			LOG("t=%u ms: diag: first control packet from %u:%x (%u B)", g_ms, node, port, len);
+		}
+		diag_cntl_rx(node, port, d, len);
+		return;
+	}
+	if (dst_port == PORT_DIAG_DCI) {
+		diag_dci_pkts++;
+		if (diag_dci_pkts == 1) {
+			LOG("t=%u ms: diag: first DCI packet from %u:%x (%u B)", g_ms, node, port, len);
+		}
+		return;
+	}
+	diag_data_pkts++;
+	diag_data_bytes += len;
+	if (diag_data_pkts == 1 || diag_data_pkts % 500 == 0) {
+		LOG("t=%u ms: diag: data pkt %u from %u:%x, %llu B total (cntl %u, %u registrations)", g_ms,
+		    diag_data_pkts, node, port, (unsigned long long)diag_data_bytes, diag_cntl_msgs, diag_regs);
+	}
+}
+
 void
 svc_announce(void)
 {
-	for (unsigned i = 0; i < 3; i++) {
+	for (unsigned i = 0; i < SVC_N; i++) {
+		if (!svc_enabled(i)) {
+			continue;
+		}
 		struct qrtr_ctrl c = { QRTR_TYPE_NEW_SERVER, svc[i][0], svc[i][1], QRTR_NODE_APPS, svc[i][2] };
 		qrtr_send(QRTR_TYPE_NEW_SERVER, QRTR_PORT_CTRL, q_modem_node, QRTR_PORT_CTRL, &c, sizeof(c));
 	}
-	LOG("t=%u ms: announced pd-mapper 0x40, tftp 0x1000, rmtfs 0x0e", g_ms);
+	LOG("t=%u ms: announced pd-mapper 0x40, tftp 0x1000, rmtfs 0x0e%s", g_ms,
+	    sweet_diag > 0 ? ", diag 0x1001 cntl/data/dci" : "");
 }
 
 bool
@@ -1042,6 +1299,10 @@ svc_rx(uint32_t src_node, uint32_t src_port, uint32_t dst_port, const uint8_t *d
 		}
 		return true;
 	}
+	if (dst_port == PORT_DIAG_CNTL || dst_port == PORT_DIAG_DATA || dst_port == PORT_DIAG_DCI) {
+		diag_rx(src_node, src_port, dst_port, data, len);
+		return true;
+	}
 	if (dst_port == PORT_WLPS) {
 		if (len >= 7) {
 			wlps_rx(data, len);
-- 
