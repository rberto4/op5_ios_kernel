+/*
+ * 0136: what pushing IOSurfaces out of the CPU cache costs (SweetGPU.cpp
+ * pushSurfaces), and how often it happens: kern.sweetgpu_push_ms, writable
+ * (boot-arg sweetgpu_push_ms; 0 = only when a surface's seed changes).
+ */
+int sweet_gpu_push_ms = 4;
+static int gpu_push_count;
+static int64_t gpu_push_us, gpu_push_mb_bytes, gpu_ring_flush_bytes;
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_push_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_gpu_push_ms, 0,
+    "SWEET GPU: ms between cache pushes of an unchanged IOSurface (0: only on seed change)");
