 /* CACHE_FLUSH_TS writing the next sequence number, then start the CP. Lock held. */
+/*
+ * 0136: clean only the ring dwords written since the last kick (from
+ * rb_flushed up to rb_wptr, across the wrap), not the whole 32 KiB, on
+ * every submission. Lock held.
+ */
+static void
+rb_flush_written(void)
+{
+	uint32_t size = RB_SIZE / 4u, from = rb_flushed % size, to = rb_wptr;
+	if (from == to) {
+		return;
+	}
+	if (to > from) {
+		flush_dcache64((addr64_t)(dma + DMA_RB + 4u * from), 4u * (to - from), FALSE);
+		gpu_ring_flush_bytes += 4u * (to - from);
+	} else {
+		flush_dcache64((addr64_t)(dma + DMA_RB + 4u * from), 4u * (size - from), FALSE);
+		gpu_ring_flush_bytes += 4u * (size - from);
+		if (to != 0) {
+			flush_dcache64((addr64_t)(dma + DMA_RB), 4u * to, FALSE);
+			gpu_ring_flush_bytes += 4u * to;
+		}
+	}
+	rb_flushed = to;
+}
