+    "SWEET GPU: microseconds spent in IOSurface cache pushes");
+SYSCTL_QUAD(_kern, OID_AUTO, sweetgpu_push_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, &gpu_push_mb_bytes,
+    "SWEET GPU: bytes of IOSurface pushed out of the cache");
+SYSCTL_QUAD(_kern, OID_AUTO, sweetgpu_ring_flush_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, &gpu_ring_flush_bytes,
+    "SWEET GPU: ring bytes cleaned at submissions");
+
+void sweet_gpu_push_note(uint64_t ticks, uint64_t bytes);
+void
+sweet_gpu_push_note(uint64_t ticks, uint64_t bytes)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(ticks, &ns);
+	__atomic_add_fetch(&gpu_push_count, 1, __ATOMIC_RELAXED);
+	__atomic_add_fetch(&gpu_push_us, (int64_t)(ns / 1000u), __ATOMIC_RELAXED);
+	__atomic_add_fetch(&gpu_push_mb_bytes, (int64_t)bytes, __ATOMIC_RELAXED);
+}
