+
+#define R_RBBM_CLOCK_CNTL       0x0067
+#define R_RBBM_CLOCK_DELAY_GPMU 0x00c9
+#define R_RBBM_CLOCK_HYST_GPMU  0x00ca
+#define R_RBBM_ISDB_CNT         0x0533
+
+static void
+set_hwcg(void)
+{
+	for (unsigned i = 0; i < sizeof(a5xx_hwcg) / sizeof(a5xx_hwcg[0]); i++) {
+		gwr(a5xx_hwcg[i][0], a5xx_hwcg[i][1]);
+	}
+	gwr(R_RBBM_CLOCK_DELAY_GPMU, 0x00000770);
+	gwr(R_RBBM_CLOCK_HYST_GPMU, 0x00000004);
+	gwr(R_RBBM_CLOCK_CNTL, 0xaaa8aa00);
+	gwr(R_RBBM_ISDB_CNT, 0x182);
+	trace_status("hwcg", R_RBBM_CLOCK_CNTL);
+}
