 static void
 hw_init(void)
 {
@@ -521,6 +644,9 @@ hw_init(void)
 	hwr(R_UCHE_MODE_CNTL, 1u << 29);
 	hwr(R_CP_CHICKEN_DBG, 0x02000000);
 	hwr(R_RBBM_AHB_CNTL1, 0xa6ffffff);
