+/*
+ * Hardware clock gating, as Linux a5xx_set_hwcg(gpu, true) for A540 (table
+ * a5xx_hwcg, register offsets from a5xx.xml.h). Test 0110: RBBM_STATUS
+ * GPU_BUSY bits flap with every register write and never settle idle, even
+ * with the CP halted. sysctl kern.sweetgpu_hwcg=0 skips it.
+ */
+static int hwcg_enable = 1;
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_hwcg, CTLFLAG_RW | CTLFLAG_LOCKED, &hwcg_enable, 0,
+    "SWEET GPU stage B: hardware clock gating");
