diff --git a/bsd/dev/sweet_a540_b.c b/bsd/dev/sweet_a540_b.c
index 2ea4143..faa276d 100644
--- a/bsd/dev/sweet_a540_b.c
+++ b/bsd/dev/sweet_a540_b.c
@@ -58,6 +58,36 @@
 #include <kern/locks.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/*
+ * 0134: cache maintenance that happens. This kernel is built with Apple's
+ * coherent-cache config (__ARM_COHERENT_CACHE__), where flush_dcache64 is a
+ * bare DSB; the Adreno and its SMMU read DRAM behind this processor's caches
+ * (the DMA area, ring, page tables and buffer objects are cacheable kernel
+ * memory). Every flush_dcache64 of this file cleans and invalidates by
+ * virtual address to the point of coherency (dc civac), as topaz 0111 does.
+ * Only kernel virtual addresses: by physical address, pages below 4 GiB
+ * panic in phystokv (tests 0128/0131).
+ */
+static void
+sweet_dc_civac(uintptr_t va, size_t len)
+{
+	uint64_t ctr, line;
+	uintptr_t end;
+
+	__builtin_arm_dsb(0xf);      /* dsb sy */
+	if (va == 0 || len == 0) {
+		return;
+	}
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	line = 4ull << ((ctr >> 16) & 0xf);     /* DminLine */
+	end = va + len;
+	for (uintptr_t a = va & ~(uintptr_t)(line - 1); a < end; a += line) {
+		__asm__ volatile ("dc civac, %0" :: "r"(a) : "memory");
+	}
+	__builtin_arm_dsb(0xf);      /* dsb sy */
+}
+#define flush_dcache64(va, len, phys) sweet_dc_civac((uintptr_t)(va), (size_t)(len))
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 bool sweet_a540_powered(void);
 
