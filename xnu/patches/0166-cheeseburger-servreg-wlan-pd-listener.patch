From cc8efc0c3b674a26faac85f10c72b540cd639ca2 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 25 Nov 2026 15:17:46 +0100
Subject: [PATCH] cheeseburger: listen to servreg-notif for wlan_pd and ACK its state updates

Stock icnss and hackios raphael (K20 Pro, WCN3998, Wi-Fi works) register with the modem's servreg-notifier (QMI 0x42, v1 instance 180) as listener of msm/modem/wlan_pd and ACK every STATE_UPDATED indication (Linux pdr_interface.c). We never registered. REGISTER_LISTENER when 0x42:b401 appears, ACK 0x23 for each indication 0x22 (kern.sweetmss_pdl, default 1).

---
 bsd/dev/sweet_glink.c |  3 ++
 bsd/dev/sweet_mlink.h |  2 +
 bsd/dev/sweet_msvc.c  | 91 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 96 insertions(+)

diff --git a/bsd/dev/sweet_glink.c b/bsd/dev/sweet_glink.c
index 226908a..68e46d5 100644
--- a/bsd/dev/sweet_glink.c
+++ b/bsd/dev/sweet_glink.c
@@ -598,6 +598,9 @@ qrtr_rx(const uint8_t *p, uint32_t len)
 		if (c->a == 0x02 && c->c == q_modem_node) {
 			svc_dms_seen(c->c, c->d);       /* QMI DMS */
 		}
+		if (c->a == 0x42 && c->c == q_modem_node) {
+			svc_servreg_seen(c->c, c->d, c->b);     /* servreg-notif: wlan_pd listener (0166) */
+		}
 		if (c->a == QMI_SVC_WLFW) {
 			LOG("t=%u ms: *** WLFW service 0x45 up: inst %x node %u port %x ***", g_ms, c->b, c->c, c->d);
 			wlfw_arrive(c->c, c->d);
diff --git a/bsd/dev/sweet_mlink.h b/bsd/dev/sweet_mlink.h
index ef6af7f..cccee88 100644
--- a/bsd/dev/sweet_mlink.h
+++ b/bsd/dev/sweet_mlink.h
@@ -45,6 +45,7 @@ struct smem_part_hdr { uint8_t magic[4]; uint16_t host0, host1; uint32_t size, f
 #define svc_summary         sweet_mlink_svc_summary
 #define svc_lookup          sweet_mlink_svc_lookup
 #define svc_dms_seen        sweet_mlink_svc_dms_seen
+#define svc_servreg_seen    sweet_mlink_svc_servreg_seen
 #define wlfw_arrive         sweet_mlink_wlfw_arrive
 #define wlfw_rx             sweet_mlink_wlfw_rx
 #define wlfw_poll           sweet_mlink_wlfw_poll
@@ -87,6 +88,7 @@ void svc_announce(void);
 void svc_summary(void);
 void svc_lookup(uint32_t node, uint32_t port, uint32_t service, uint32_t instance);
 void svc_dms_seen(uint32_t node, uint32_t port);
+void svc_servreg_seen(uint32_t node, uint32_t port, uint32_t instance);
 void wlfw_arrive(uint32_t node, uint32_t port);
 /* sweet_wlfw.c (W4) */
 void wlfw_rx(const uint8_t *data, uint32_t len);
diff --git a/bsd/dev/sweet_msvc.c b/bsd/dev/sweet_msvc.c
index 100283d..f11c1cb 100644
--- a/bsd/dev/sweet_msvc.c
+++ b/bsd/dev/sweet_msvc.c
@@ -114,6 +114,7 @@ efs_read(const char *part, uint64_t off, void *dst, uint64_t n)
 #define PORT_TFTP           0x4002
 #define PORT_RMTFS          0x4003
 #define PORT_DMSC           0x4005              /* our QMI client port towards DMS */
+#define PORT_SRNC           0x4006              /* our QMI client port towards servreg-notif */
 #define PORT_SESS           0x4100
 
 /* generated by fwtable_all.py from NON-HLOS.bin (HyperOS 2.0.208 modem_a): 657 files, 657 extents */
@@ -844,6 +845,90 @@ dms_rx(const uint8_t *d, uint32_t len)
 	LOG("t=%u ms: dms: type %u msg %x result %u error %u", g_ms, d[0], msg, res, err);
 }
 
+/*
+ * 0166: stock icnss and hackios raphael (WCN3998, Wi-Fi works) register with the modem's
+ * servreg-notifier (0x42, v1 instance 180) as listener of "msm/modem/wlan_pd" and ACK every
+ * STATE_UPDATED indication (Linux pdr_interface.c). Ours never did; an unacked state change
+ * keeps a modem task waiting. REGISTER_LISTENER 0x20 (1: enable u8, 2: path), indication
+ * 0x22 (1: state, 2: path, 3: transaction u16), ACK 0x23 (1: path, 2: transaction).
+ */
+#ifndef QMI_IND
+#define QMI_IND                     4
+#endif
+#define SERVREG_REGISTER_LISTENER   0x0020
+#define SERVREG_STATE_UPDATED_IND   0x0022
+#define SERVREG_STATE_UPDATED_ACK   0x0023
+#define WLAN_PD_PATH                "msm/modem/wlan_pd"
+static int sweet_mss_pdl = 1;
+SYSCTL_INT(_kern, OID_AUTO, sweetmss_pdl, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_mss_pdl, 0,
+    "1 = listen to servreg-notif for msm/modem/wlan_pd and ACK its state updates (stock icnss), 0 = no");
+static bool srn_sent;
+static uint32_t srn_node, srn_port;
+static unsigned srn_inds;
+
+void
+svc_servreg_seen(uint32_t node, uint32_t port, uint32_t instance)
+{
+	struct qmsg m;
+	uint8_t enable = 1;
+
+	if (srn_sent || !sweet_mss_pdl || instance != 0xb401) {   /* version 1, instance 180 */
+		return;
+	}
+	srn_sent = true;
+	srn_node = node;
+	srn_port = port;
+	qm_init(&m, 1, SERVREG_REGISTER_LISTENER);
+	m.b[0] = QMI_REQ;
+	qm_tlv(&m, 0x01, &enable, 1);
+	qm_tlv(&m, 0x02, WLAN_PD_PATH, (uint16_t)strlen(WLAN_PD_PATH));
+	qm_send(&m, PORT_SRNC, node, port);
+	LOG("t=%u ms: servreg: listener for %s sent to %u:%x", g_ms, WLAN_PD_PATH, node, port);
+}
+
+static void
+srn_rx(uint32_t node, uint32_t port, const uint8_t *d, uint32_t len)
+{
+	uint16_t msg, tl = 0;
+	uint32_t state = 0xffffffff;
+	memcpy(&msg, d + 3, 2);
+	if (d[0] == QMI_RESP) {
+		const uint8_t *r = qm_find(d, len, 0x02, &tl);
+		uint16_t res = 0xffff, err = 0xffff;
+		if (r != NULL && tl >= 4) {
+			memcpy(&res, r, 2);
+			memcpy(&err, r + 2, 2);
+		}
+		const uint8_t *s = qm_find(d, len, 0x10, &tl);
+		if (s != NULL && tl >= 4) {
+			memcpy(&state, s, 4);
+		}
+		LOG("t=%u ms: servreg: response %x result %u error %u, wlan_pd state %x", g_ms, msg, res, err, state);
+		return;
+	}
+	if (d[0] != QMI_IND || msg != SERVREG_STATE_UPDATED_IND) {
+		LOG("t=%u ms: servreg: type %u msg %x ignored", g_ms, d[0], msg);
+		return;
+	}
+	const uint8_t *s = qm_find(d, len, 0x01, &tl);
+	if (s != NULL && tl >= 4) {
+		memcpy(&state, s, 4);
+	}
+	const uint8_t *t = qm_find(d, len, 0x03, &tl);
+	uint16_t txn = 0;
+	if (t != NULL && tl >= 2) {
+		memcpy(&txn, t, 2);
+	}
+	srn_inds++;
+	struct qmsg m;
+	qm_init(&m, (uint16_t)(srn_inds + 1), SERVREG_STATE_UPDATED_ACK);
+	m.b[0] = QMI_REQ;
+	qm_tlv(&m, 0x01, WLAN_PD_PATH, (uint16_t)strlen(WLAN_PD_PATH));
+	qm_tlv(&m, 0x02, &txn, 2);
+	qm_send(&m, PORT_SRNC, node, port);
+	LOG("t=%u ms: servreg: wlan_pd state %x (txn %u): ACK sent", g_ms, state, txn);
+}
+
 void
 svc_announce(void)
 {
@@ -876,6 +961,12 @@ svc_rx(uint32_t src_node, uint32_t src_port, uint32_t dst_port, const uint8_t *d
 		}
 		return true;
 	}
+	if (dst_port == PORT_SRNC) {
+		if (len >= 7) {
+			srn_rx(src_node, src_port, data, len);
+		}
+		return true;
+	}
 	if (len < 7 || data[0] != QMI_REQ) {
 		return false;
 	}
-- 
