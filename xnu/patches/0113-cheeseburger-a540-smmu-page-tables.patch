+/*
+ * Phase C step 1: CB0 translates. AArch64 stage-1 tables, 4K granule, 32-bit
+ * GPU address space (T0SZ 32: walk starts at level 1), the register values
+ * Linux arm-smmu / io-pgtable-arm use for a non-coherent master: MAIR attr0
+ * normal non-cacheable, walks non-cacheable outer-shareable, terminate (not
+ * stall) on fault. The DMA area appears at IOVA_DMA, DMA_TEST also at
+ * IOVA_TEST.
+ */
+#define CB_TCR2         0x10u
+#define CB_TTBR0        0x20u
+#define CB_TCR          0x30u
+#define CB_CONTEXTIDR   0x34u
+#define CB_MAIR0        0x38u
+#define CB_FAR          0x60u
+#define CB_FSYNR0       0x68u
+#define CB_TLBIALL      0x618u
+#define CB_TLBSYNC      0x7f0u
+#define CB_TLBSTATUS    0x7f4u
+#define PTE_TABLE       0x3ull
+#define PTE_PAGE        (0x3ull | (1ull << 10) /* AF */ | (2ull << 8) /* outer shareable */ | \
+	                 (1ull << 6) /* AP: read/write, unprivileged too */ | (0ull << 2) /* MAIR attr0 */)
+#define TCR_VALUE       (32u /* T0SZ */ | (2u << 12) /* SH0 outer */ | (1u << 23) /* EPD1 */)
+#define TCR2_VALUE      (2u /* PASize 40 bits */ | (7u << 15) /* SEP upstream */)
+#define MAIR0_VALUE     0x0004ff44u     /* attr0 NC, attr1 WB RWA, attr2 device */
+#define SCTLR_XLATE     (1u /* M */ | (1u << 1) /* TRE */ | (1u << 2) /* AFE */ | (1u << 5) /* CFRE */ | \
+	                 (1u << 6) /* CFIE */ | (1u << 12) /* ASIDPNE */)
+
+static void
+pt_map(uint64_t iova, uint32_t off, uint32_t len)
+{
+	volatile uint64_t *l1 = (volatile uint64_t *)(dma + DMA_PT_L1);
+	volatile uint64_t *l2 = (volatile uint64_t *)(dma + DMA_PT_L2);
+	uint32_t l3off = (iova >= IOVA_TEST) ? DMA_PT_L3B : DMA_PT_L3A;
+	volatile uint64_t *l3 = (volatile uint64_t *)(dma + l3off);
+	l1[(iova >> 30) & 3] = (dma_pa + DMA_PT_L2) | PTE_TABLE;
+	l2[(iova >> 21) & 0x1ff] = (dma_pa + l3off) | PTE_TABLE;
+	for (uint32_t done = 0; done < len; done += 0x1000) {
+		l3[((iova + done) >> 12) & 0x1ff] = (dma_pa + off + done) | PTE_PAGE;
+	}
+}
+
+static bool
+smmu_translate_setup(void)
+{
+	memset((void *)(dma + DMA_PT_L1), 0, 4 * 0x1000);
+	pt_map(IOVA_DMA, 0, DMA_SIZE);
+	pt_map(IOVA_TEST, DMA_TEST, 0x1000);
+	flush_dcache64(dma_pa + DMA_PT_L1, 4 * 0x1000, TRUE);
+
+	uint32_t cb = SMMU_CB(0);
+	swr(cb + CB_SCTLR, 0);
+	swr(cb + CB_TCR2, TCR2_VALUE);
+	swr(cb + CB_TTBR0, (uint32_t)(dma_pa + DMA_PT_L1));
+	swr(cb + CB_TTBR0 + 4, (uint32_t)((dma_pa + DMA_PT_L1) >> 32));
+	swr(cb + CB_MAIR0, MAIR0_VALUE);
+	swr(cb + CB_CONTEXTIDR, 0);
+	swr(cb + CB_TCR, TCR_VALUE);
+	swr(cb + CB_TLBIALL, 0);
+	swr(cb + CB_TLBSYNC, 0);
+	int i;
+	for (i = 0; i < 1000 && (srd(cb + CB_TLBSTATUS) & 1u); i++) {
+		delay(1);
+	}
+	swr(cb + CB_FSR, srd(cb + CB_FSR));
+	swr(cb + CB_SCTLR, SCTLR_XLATE);
+	printf("SWEET GPU B: CB0 translate: TTBR0 0x%08x%08x (want 0x%llx) TCR 0x%08x TCR2 0x%08x MAIR0 0x%08x "
+	    "SCTLR 0x%08x TLB sync %d us\n", srd(cb + CB_TTBR0 + 4), srd(cb + CB_TTBR0), dma_pa + DMA_PT_L1,
+	    srd(cb + CB_TCR), srd(cb + CB_TCR2), srd(cb + CB_MAIR0), srd(cb + CB_SCTLR), i);
+	printf("SWEET GPU B: page tables: DMA area at GPU 0x%llx, test page at GPU 0x%llx\n", IOVA_DMA,
+	    IOVA_TEST);
+	return srd(cb + CB_SCTLR) == SCTLR_XLATE && srd(cb + CB_TCR) == TCR_VALUE &&
+	       srd(cb + CB_TTBR0) == (uint32_t)(dma_pa + DMA_PT_L1);
+}
