From f3929a5cdb51fb3f18dd2794fd77293c4f9ea000 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 25 Nov 2026 23:07:03 +0100
Subject: [PATCH] cheeseburger: connect to the modem's WLPS (0x39) as
 cnss-daemon does

Stock cnss-daemon logs "WLPS service connected" right after WMI READY and forwards qcacld's
version (UPDATE_CLIENT_VERSION 0x20) and WLAN status (UPDATE_CLIENT_STATUS 0x21) to the WLAN
proxy service the modem publishes ~20 ms after mission mode. We never connected. Send both
when 0x39 appears (kern.sweetwlps: 0 off, 1 default = adsp 0 + on, 2 = adsp 1 + vdev 0 STA).
---
 bsd/dev/sweet_glink.c |  3 ++
 bsd/dev/sweet_mlink.h |  2 ++
 bsd/dev/sweet_msvc.c  | 81 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 86 insertions(+)

diff --git a/bsd/dev/sweet_glink.c b/bsd/dev/sweet_glink.c
index 68e46d5..f77d376 100644
--- a/bsd/dev/sweet_glink.c
+++ b/bsd/dev/sweet_glink.c
@@ -601,6 +601,9 @@ qrtr_rx(const uint8_t *p, uint32_t len)
 		if (c->a == 0x42 && c->c == q_modem_node) {
 			svc_servreg_seen(c->c, c->d, c->b);     /* servreg-notif: wlan_pd listener (0166) */
 		}
+		if (c->a == 0x39 && c->c == q_modem_node) {
+			svc_wlps_seen(c->c, c->d, c->b);        /* WLPS: cnss-daemon client (0168) */
+		}
 		if (c->a == QMI_SVC_WLFW) {
 			LOG("t=%u ms: *** WLFW service 0x45 up: inst %x node %u port %x ***", g_ms, c->b, c->c, c->d);
 			wlfw_arrive(c->c, c->d);
diff --git a/bsd/dev/sweet_mlink.h b/bsd/dev/sweet_mlink.h
index cccee88..176003b 100644
--- a/bsd/dev/sweet_mlink.h
+++ b/bsd/dev/sweet_mlink.h
@@ -46,6 +46,7 @@ struct smem_part_hdr { uint8_t magic[4]; uint16_t host0, host1; uint32_t size, f
 #define svc_lookup          sweet_mlink_svc_lookup
 #define svc_dms_seen        sweet_mlink_svc_dms_seen
 #define svc_servreg_seen    sweet_mlink_svc_servreg_seen
+#define svc_wlps_seen       sweet_mlink_svc_wlps_seen
 #define wlfw_arrive         sweet_mlink_wlfw_arrive
 #define wlfw_rx             sweet_mlink_wlfw_rx
 #define wlfw_poll           sweet_mlink_wlfw_poll
@@ -89,6 +90,7 @@ void svc_summary(void);
 void svc_lookup(uint32_t node, uint32_t port, uint32_t service, uint32_t instance);
 void svc_dms_seen(uint32_t node, uint32_t port);
 void svc_servreg_seen(uint32_t node, uint32_t port, uint32_t instance);
+void svc_wlps_seen(uint32_t node, uint32_t port, uint32_t instance);
 void wlfw_arrive(uint32_t node, uint32_t port);
 /* sweet_wlfw.c (W4) */
 void wlfw_rx(const uint8_t *data, uint32_t len);
diff --git a/bsd/dev/sweet_msvc.c b/bsd/dev/sweet_msvc.c
index f11c1cb..32fa630 100644
--- a/bsd/dev/sweet_msvc.c
+++ b/bsd/dev/sweet_msvc.c
@@ -115,6 +115,7 @@ efs_read(const char *part, uint64_t off, void *dst, uint64_t n)
 #define PORT_RMTFS          0x4003
 #define PORT_DMSC           0x4005              /* our QMI client port towards DMS */
 #define PORT_SRNC           0x4006              /* our QMI client port towards servreg-notif */
+#define PORT_WLPS           0x4007              /* our QMI client port towards WLPS (0168) */
 #define PORT_SESS           0x4100
 
 /* generated by fwtable_all.py from NON-HLOS.bin (HyperOS 2.0.208 modem_a): 657 files, 657 extents */
@@ -929,6 +930,80 @@ srn_rx(uint32_t node, uint32_t port, const uint8_t *d, uint32_t len)
 	LOG("t=%u ms: servreg: wlan_pd state %x (txn %u): ACK sent", g_ms, state, txn);
 }
 
+/*
+ * 0168: stock cnss-daemon is a client of the modem's WLAN proxy service (WLPS, QMI 0x39, published
+ * ~20 ms after mission mode). On connect ("WLPS service connected", right after WMI READY in the
+ * stock log) it forwards what qcacld reported: UPDATE_CLIENT_VERSION 0x20 (1: chip_id u32,
+ * 2-5: chip name / vendor / host version / fw version, char[16] each) and UPDATE_CLIENT_STATUS
+ * 0x21 (1: fw_adsp_support u8, 2: is_on u8, 0x10 opt: vdev_info {u8 id, u32 mode}).
+ * We never connected. kern.sweetwlps: 0 = no, 1 = version + status (adsp 0, on 1),
+ * 2 = status with adsp 1 + vdev_info (vdev 0, station).
+ */
+#define WLPS_UPDATE_VERSION     0x0020
+#define WLPS_UPDATE_STATUS      0x0021
+#define WLPS_STR_LEN            16
+static int sweet_wlps = 1;
+SYSCTL_INT(_kern, OID_AUTO, sweetwlps, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_wlps, 0,
+    "WLPS client (0x39) as cnss-daemon: 0 = no, 1 = version + status on, 2 = status with adsp + vdev 0 STA");
+static bool wlps_sent;
+
+static void
+wlps_str(struct qmsg *m, uint8_t type, const char *v)
+{
+	char b[WLPS_STR_LEN];
+
+	memset(b, 0, sizeof(b));
+	strlcpy(b, v, sizeof(b));
+	qm_tlv(m, type, b, WLPS_STR_LEN);
+}
+
+void
+svc_wlps_seen(uint32_t node, uint32_t port, uint32_t instance)
+{
+	struct qmsg m;
+	uint32_t chip_id = 0x30214;                 /* WCN3990 chip_id from WLFW CAP */
+	uint8_t adsp = sweet_wlps >= 2 ? 1 : 0, on = 1;
+
+	if (wlps_sent || sweet_wlps <= 0) {
+		return;
+	}
+	wlps_sent = true;
+	qm_init(&m, 1, WLPS_UPDATE_VERSION);
+	m.b[0] = QMI_REQ;
+	qm_tlv(&m, 0x01, &chip_id, 4);
+	wlps_str(&m, 0x02, "WCN3990");
+	wlps_str(&m, 0x03, "Qualcomm");
+	wlps_str(&m, 0x04, "5.2.0.0");
+	wlps_str(&m, 0x05, "1.0.0.126");
+	qm_send(&m, PORT_WLPS, node, port);
+
+	qm_init(&m, 2, WLPS_UPDATE_STATUS);
+	m.b[0] = QMI_REQ;
+	qm_tlv(&m, 0x01, &adsp, 1);
+	qm_tlv(&m, 0x02, &on, 1);
+	if (adsp) {
+		uint8_t vi[5] = { 0, 0, 0, 0, 0 };  /* vdev 0, mode 0 = infra station */
+		qm_tlv(&m, 0x10, vi, sizeof(vi));
+	}
+	qm_send(&m, PORT_WLPS, node, port);
+	LOG("t=%u ms: wlps: version + status (adsp %u, on 1) sent to %u:%x inst %x", g_ms, adsp, node, port, instance);
+}
+
+static void
+wlps_rx(const uint8_t *d, uint32_t len)
+{
+	uint16_t msg, tl = 0, res = 0xffff, err = 0xffff;
+	const uint8_t *r;
+
+	memcpy(&msg, d + 3, 2);
+	r = qm_find(d, len, 0x02, &tl);
+	if (r != NULL && tl >= 4) {
+		memcpy(&res, r, 2);
+		memcpy(&err, r + 2, 2);
+	}
+	LOG("t=%u ms: wlps: type %u msg %x result %u error %u", g_ms, d[0], msg, res, err);
+}
+
 void
 svc_announce(void)
 {
@@ -967,6 +1042,12 @@ svc_rx(uint32_t src_node, uint32_t src_port, uint32_t dst_port, const uint8_t *d
 		}
 		return true;
 	}
+	if (dst_port == PORT_WLPS) {
+		if (len >= 7) {
+			wlps_rx(data, len);
+		}
+		return true;
+	}
 	if (len < 7 || data[0] != QMI_REQ) {
 		return false;
 	}
