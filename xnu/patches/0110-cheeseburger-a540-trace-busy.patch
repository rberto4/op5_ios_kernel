 /* ---- stage B ---- */
 
+/*
+ * Test 0109: RBBM_STATUS is 0x1 after the soft reset and 0xc0000101 (GPU_BUSY
+ * summary bits, never clearing) once the CP runs. Log the write that sets them.
+ */
+static uint32_t trace_last;
+
+static void
+trace_status(const char *what, uint32_t reg)
+{
+	uint32_t st = grd(R_RBBM_STATUS);
+	if (st != trace_last) {
+		printf("SWEET GPU B: RBBM_STATUS 0x%08x -> 0x%08x after %s 0x%04x\n", trace_last, st, what,
+		    reg);
+		trace_last = st;
+	}
+}
+
+static void
+hwr(uint32_t reg, uint32_t v)
+{
+	gwr(reg, v);
+	trace_status("write", reg);
+}
