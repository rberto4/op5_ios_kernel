+/* 0142: a surface buffer into / out of its ID's chain. With the lock held. */
+void
+SweetGPUUserClient::surfLink(uint32_t h)
+{
+	uint16_t *head = &fSurfBucket[surfBucket(fBo[h].surface->id)];
+	fBo[h].surfNext = *head;
+	*head = (uint16_t)h;
+}
+
+void
+SweetGPUUserClient::surfUnlink(uint32_t h)
+{
+	if (fBo[h].surface == NULL) {
+		return;
+	}
+	for (uint16_t *link = &fSurfBucket[surfBucket(fBo[h].surface->id)]; *link != 0; link = &fBo[*link].surfNext) {
+		if (*link == h) {
+			*link = fBo[h].surfNext;
+			fBo[h].surfNext = 0;
+			return;
+		}
+	}
+}
