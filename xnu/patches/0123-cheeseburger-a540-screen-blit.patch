+/* Map [pa, pa + len) with 2 MiB level-2 blocks at IOVA_FB (pa 2 MiB aligned); used by mode 9. */
+static bool
+pt_map_blocks(uint64_t pa, uint64_t len)
+{
+	if ((pa & 0x1fffffull) || len > 0x40000000ull) {
+		return false;
+	}
+	volatile uint64_t *l1 = (volatile uint64_t *)(dma + DMA_PT_L1);
+	volatile uint64_t *l2 = (volatile uint64_t *)(dma + DMA_PT_L2B);
+	memset((void *)(dma + DMA_PT_L2B), 0, 0x1000);
+	l1[(IOVA_FB >> 30) & 3] = (dma_pa + DMA_PT_L2B) | PTE_TABLE;
+	for (uint64_t off = 0; off < len; off += 0x200000ull) {
+		l2[((IOVA_FB + off) >> 21) & 0x1ff] = (pa + off) | (PTE_PAGE & ~0x2ull);    /* block: bits[1:0] = 01 */
+	}
+	flush_dcache64(dma_pa + DMA_PT_L1, 0x1000, TRUE);
+	flush_dcache64(dma_pa + DMA_PT_L2B, 0x1000, TRUE);
+	swr(SMMU_CB(0) + CB_TLBIALL, 0);
+	swr(SMMU_CB(0) + CB_TLBSYNC, 0);
+	for (int i = 0; i < 1000 && (srd(SMMU_CB(0) + CB_TLBSTATUS) & 1u); i++) {
+		delay(1);
+	}
+	return true;
+}
