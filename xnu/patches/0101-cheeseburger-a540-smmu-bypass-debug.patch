@@ -534,4 +576,51 @@ sysctl_sweetgpu_stage SYSCTL_HANDLER_ARGS
 
 SYSCTL_PROC(_kern, OID_AUTO, sweetgpu_stage, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
     0, 0, sysctl_sweetgpu_stage, "I", "SWEET Adreno 540 stage B (write 1)");
+/*
+ * Debug register access in the GPU block (root only, GPU powered by stage A):
+ *   sysctl kern.sweetgpu_addr=<offset from 0x05000000, 4-aligned, < 0x70000>
+ *   read  kern.sweetgpu_val   -> 32-bit read at that offset
+ *   write kern.sweetgpu_val=v -> 32-bit write, logged with the value read back
+ * Covers GPU 0x05000000, SMMU 0x05040000 and GPUCC 0x05065000.
+ */
+#define DBG_SPAN        0x70000u
+static vm_offset_t dbg_base;
+static int dbg_addr;
+
+static bool
+dbg_ready(void)
+{
+	if (!sweet_a540_powered() || dbg_addr < 0 || (uint32_t)dbg_addr >= DBG_SPAN || (dbg_addr & 3)) {
+		return false;
+	}
+	if (!dbg_base) {
+		dbg_base = ml_io_map(GPU_PA, DBG_SPAN);
+	}
+	return dbg_base != 0;
+}
+
+static int
+sysctl_sweetgpu_val SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	if (!dbg_ready()) {
+		return ENXIO;
+	}
+	volatile uint32_t *reg = (volatile uint32_t *)(dbg_base + (uint32_t)dbg_addr);
+	int value = (int)*reg;
+	int err = sysctl_handle_int(oidp, &value, 0, req);
+	if (err || !req->newptr) {
+		return err;
+	}
+	*reg = (uint32_t)value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET GPU B: poke 0x%08x = 0x%08x, reads 0x%08x\n", GPU_PA + (uint32_t)dbg_addr,
+	    (uint32_t)value, *reg);
+	return 0;
+}
+
+SYSCTL_INT(_kern, OID_AUTO, sweetgpu_addr, CTLFLAG_RW | CTLFLAG_LOCKED, &dbg_addr, 0,
+    "SWEET GPU debug: register offset from 0x05000000");
+SYSCTL_PROC(_kern, OID_AUTO, sweetgpu_val, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweetgpu_val, "I", "SWEET GPU debug: register at kern.sweetgpu_addr");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
