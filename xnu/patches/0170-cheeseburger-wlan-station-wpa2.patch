+	bool mgmt = kind == SWEET_HTT_TX_MGMT;
+	if (tx_pool == NULL) {
+		tx_pool = (uint8_t *)pool_alloc(TX_SLOTS * TX_SLOT_SIZE, &tx_pool_pa);
+	}
+	if (tx_pool == NULL || htt_bank == NULL || htt_state != 2 || len > TX_SLOT_SIZE) {
+		return false;
+	}
+	for (id = 0; id < TX_SLOTS && (tx_busy & (1ull << id)) != 0; id++) {
+	}
+	if (id == TX_SLOTS) {
+		return false;
+	}
+	uint64_t pa = tx_pool_pa + (uint64_t)id * TX_SLOT_SIZE, frags = pa;
+	memcpy(tx_pool + id * TX_SLOT_SIZE, f, len);
+	if (!mgmt) {
+		uint8_t *ext = htt_bank + id * HTT_EXT_DESC_SIZE;
+		uint32_t lo = (uint32_t)pa;
+		uint16_t hi = (uint16_t)(pa >> 32), l16 = (uint16_t)len;
+		bzero(ext, HTT_EXT_DESC_SIZE);
+		memcpy(ext + 24, &lo, 4);
+		memcpy(ext + 28, &hi, 2);
+		memcpy(ext + 30, &l16, 2);
+		frags = htt_bank_pa + (uint64_t)id * HTT_EXT_DESC_SIZE;
+	}
+	mb();
+	bzero(m, sizeof(m));
+	*p++ = H2T_TX_FRM;
+	*p++ = (uint8_t)(TXF0_MAC_HDR | ((mgmt ? TXF0_PKT_MGMT : TXF0_PKT_NATIVE) << TXF0_PKT_SHIFT) |
+	    (kind != SWEET_HTT_TX_DATA ? TXF0_NO_ENCRYPT : 0));
+	p = put16(p, (uint16_t)(((mgmt ? TXF1_TID_MGMT : TXF1_TID_NONQOS) << TXF1_TID_SHIFT) | TXF1_POSTPONED));
+	p = put16(p, (uint16_t)len);
+	p = put16(p, (uint16_t)id);
+	p = put64(p, frags);
+	p = put32(p, 0xFFFF);                       /* peer id: invalid */
+	memcpy(p, f, MIN(len, pf));
