+	p = w_pmac(p, s_bssid);
+	if (create) {
+		w_p32(p, 0);
+	}
+	return sweet_wmi_cmd(cmd, m, create ? 20 : 16);
+}
+
+static bool
+w_peer_param(uint32_t param, uint32_t value)
+{
+	uint8_t m[4 + 20], *p = sweet_wmi_tlv(m, TAG_PEER_SET_PARAM, 20);
+	p = w_p32(p, 0);
+	p = w_pmac(p, s_bssid);
+	p = w_p32(p, param);
+	w_p32(p, value);
+	return sweet_wmi_cmd(CMD_PEER_SET_PARAM, m, sizeof(m));
+}
+
+static bool
+w_ps_off(void)
+{
+	uint8_t m[12], *p = sweet_wmi_tlv(m, TAG_STA_PS_MODE, 8);
+	p = w_p32(p, 0);
+	w_p32(p, 0);
+	return sweet_wmi_cmd(CMD_STA_PS_MODE, m, sizeof(m));
+}
+
+static bool
+w_mgmt_tx_wmi(const uint8_t *f, uint32_t len)
+{
+	uint8_t m[4 + 28 + 4 + 64] = { 0 }, *p;
+	uint32_t buf = (MIN(len, 64u) + 3) & ~3u;
+	if (s_mgmt_va == NULL) {
+		s_mgmt_va = (uint8_t *)pool_alloc(0x1000, &s_mgmt_pa);
+	}
+	if (s_mgmt_va == NULL || len > 0x1000 - 8) {
+		return false;
+	}
+	bzero(s_mgmt_va, ((len + 3) & ~3u) + 4);
+	memcpy(s_mgmt_va, f, len);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	p = sweet_wmi_tlv(m, TAG_MGMT_TX, 28);
+	p = w_p32(p, 0);
+	p = w_p32(p, ++s_desc);
+	p = w_p32(p, 0);
+	p = w_p64(p, s_mgmt_pa);
+	p = w_p32(p, len);
+	p = w_p32(p, buf);
+	p = sweet_wmi_tlv(p, TAG_ARRAY_BYTE, buf);
+	memcpy(p, s_mgmt_va, buf);
+	return sweet_wmi_cmd(CMD_MGMT_TX_SEND, m, 4 + 28 + 4 + buf);
+}
+
+static bool
+w_mgmt_tx(const uint8_t *f, uint32_t len)
+{
+	return s_mgmt_htt ? sweet_htt_tx(f, len, SWEET_HTT_TX_MGMT) : w_mgmt_tx_wmi(f, len);
+}
+
+static uint32_t
+w_ap_rates(uint8_t *out)
+{
+	static const uint8_t ids[2] = { 1, 50 };
+	uint32_t n = 0;
+	for (int k = 0; k < 2; k++) {
+		const uint8_t *ie = w_find_ie(s_body, s_body_len, ids[k]);
+		for (uint32_t i = 0; ie != NULL && i < ie[1] && n < 16; i++) {
+			out[n++] = ie[2 + i];
+		}
+	}
+	return n;
+}
+
+static bool
+w_peer_assoc(uint32_t caps)
+{
+	uint8_t m[4 + 76 + 4 + 16 + 4 + 4 + 16] = { 0 }, *p, *r, rates[16];
+	uint32_t n = w_ap_rates(rates), rl = (MIN(n, 16u) + 3) & ~3u;
+	p = sweet_wmi_tlv(m, TAG_PEER_ASSOC, 76);
+	p = w_pmac(p, s_bssid);
+	p = w_p32(p, 0);
+	p = w_p32(p, 1);                            /* new assoc */
+	p = w_p32(p, s_aid);
+	p = w_p32(p, PEER_FLAG_AUTH | (s_rsn ? PEER_FLAG_NEED_PTK_4WAY : 0));
+	p = w_p32(p, caps);
+	p = w_p32(p, 1);                            /* listen interval */
+	p += 4 * 4;                                 /* ht caps, max mpdu, density, rate caps */
+	p = w_p32(p, 1);                            /* nss */
+	p = w_p32(p, 0);                            /* vht caps */
+	p = w_p32(p, s_freq < 4000 ? 1 : 0);        /* phy mode: 11g / 11a */
+	p += 8;
+	p = w_p32(p, MIN(n, 16u));
+	p = w_p32(p, 0);
+	r = sweet_wmi_tlv(p, TAG_ARRAY_BYTE, rl);
+	for (uint32_t i = 0; i < n && i < 16; i++) {
+		uint8_t v = rates[i] & 0x7F;
+		r[i] = (v == 2 || v == 4 || v == 11 || v == 22) ? (uint8_t)(v | 0x80) : v;
+	}
+	p = r + rl;
+	p = sweet_wmi_tlv(p, TAG_ARRAY_BYTE, 0);
+	sweet_wmi_tlv(p, TAG_VHT_RATE_SET, 16);
+	return sweet_wmi_cmd(CMD_PEER_ASSOC, m, 4 + 76 + 4 + rl + 4 + 4 + 16);
+}
+
+static bool
+w_install_key(bool group, uint32_t idx, uint32_t cipher, const uint8_t *key, uint32_t klen)
+{
+	uint8_t m[4 + 92 + 4 + 32] = { 0 }, *p;
+	uint32_t kl = (klen + 3) & ~3u;
+	p = sweet_wmi_tlv(m, TAG_VDEV_INSTALL_KEY, 92);
+	p = w_p32(p, 0);
+	p = w_pmac(p, s_bssid);
+	p = w_p32(p, idx);
+	p = w_p32(p, group ? 1 : 0);
+	p = w_p32(p, cipher);
+	p += 3 * 8 + 16 + 16;
+	p = w_p32(p, klen);
+	p = w_p32(p, cipher == WMI_CIPHER_TKIP ? 8 : 0);
+	p = w_p32(p, cipher == WMI_CIPHER_TKIP ? 8 : 0);
+	p = sweet_wmi_tlv(p, TAG_ARRAY_BYTE, kl);
+	memcpy(p, key, klen);
+	return sweet_wmi_cmd(CMD_VDEV_INSTALL_KEY, m, 4 + 92 + 4 + kl);
+}
+
+/* ---------------------------------------------------------------- 802.11 management frames */
+
+static uint8_t *
+w_mgmt_hdr(uint8_t *f, uint8_t fc)
+{
+	bzero(f, 24);
+	f[0] = fc;
+	memcpy(f + 4, s_bssid, 6);
+	memcpy(f + 10, sweet_wlan_mac(), 6);
+	memcpy(f + 16, s_bssid, 6);
+	return f + 24;
+}
+
+static bool
+w_send_auth(void)
+{
+	uint8_t f[30], *b = w_mgmt_hdr(f, FC_AUTH);
+	bzero(b, 6);
+	b[2] = 1;                                   /* open system, transaction 1 */
+	return w_mgmt_tx(f, sizeof(f));
+}
+
+static void
+w_build_assoc_req(void)
+{
+	uint8_t *f = s_assoc_req, *p = w_mgmt_hdr(f, FC_ASSOC_REQ), rates[16];
+	uint32_t n = w_ap_rates(rates), cap = 0x0001 | 0x0020 | 0x0400;   /* ESS, short preamble, short slot */
+	if (s_rsn) {
+		cap |= 0x0010;
+	}
+	*p++ = (uint8_t)cap;
+	*p++ = (uint8_t)(cap >> 8);
+	*p++ = 10;                                  /* listen interval */
+	*p++ = 0;
+	*p++ = 0;
+	*p++ = s_ssid_len;
+	memcpy(p, s_ssid, s_ssid_len);
+	p += s_ssid_len;
+	*p++ = 1;
+	*p++ = (uint8_t)MIN(n, 8u);
+	for (uint32_t k = 0; k < n && k < 8; k++) {
+		*p++ = rates[k];
+	}
+	if (n > 8) {
+		*p++ = 50;
+		*p++ = (uint8_t)(n - 8);
+		for (uint32_t k = 8; k < n; k++) {
+			*p++ = rates[k];
+		}
+	}
+	if (s_rsn) {
+		memcpy(p, s_rsn_ie, sizeof(s_rsn_ie));
+		p += sizeof(s_rsn_ie);
+	}
+	s_assoc_req_len = (uint32_t)(p - f);
+}
+
+/* an Ethernet frame (dst, src, type, payload) to the AP as a to-DS native wifi data frame */
+static bool
+w_tx_ether(const uint8_t *e, size_t len, bool clear)
+{
+	static uint8_t f[1600];
+	static const uint8_t snap[6] = { 0xAA, 0xAA, 0x03, 0x00, 0x00, 0x00 };
+	if (len < 14 || len - 14 + 32 > sizeof(f)) {
+		return false;
+	}
+	bzero(f, 24);
+	f[0] = 0x08;                                /* data */
+	f[1] = (uint8_t)(0x01 | (s_ptk_set && !clear ? 0x40 : 0));   /* to DS (+ protected once keyed) */
+	memcpy(f + 4, s_bssid, 6);                  /* addr1: the AP */
+	memcpy(f + 10, sweet_wlan_mac(), 6);        /* addr2: us */
+	memcpy(f + 16, e, 6);                       /* addr3: the destination */
+	memcpy(f + 24, snap, 6);
+	memcpy(f + 30, e + 12, 2);                  /* ethertype */
+	memcpy(f + 32, e + 14, len - 14);
+	return sweet_htt_tx(f, (uint32_t)(len - 14 + 32), clear ? SWEET_HTT_TX_DATA_CLEAR : SWEET_HTT_TX_DATA);
+}
+
+/* ---------------------------------------------------------------- WPA2 4-way handshake */
+
+static void w_join_end(int result);
+
+static void
+w_eapol_send(uint16_t info, const uint8_t *nonce, const uint8_t *data, uint16_t dlen)
+{
+	uint8_t e[14 + 4 + 95 + 64] = { 0 }, *k = e + 14 + 4, mic[20];
+	memcpy(e, s_bssid, 6);
+	memcpy(e + 6, sweet_wlan_mac(), 6);
+	e[12] = 0x88;
+	e[13] = 0x8E;
+	uint16_t body = (uint16_t)(95 + dlen);
+	e[14] = 1;                                  /* EAPOL version */
+	e[15] = 3;                                  /* key */
+	e[16] = (uint8_t)(body >> 8);
+	e[17] = (uint8_t)body;
+	k[0] = 2;                                   /* RSN key descriptor */
+	k[1] = (uint8_t)(info >> 8);
+	k[2] = (uint8_t)info;
+	for (int i = 0; i < 8; i++) {
+		k[5 + i] = (uint8_t)(s_replay >> (56 - 8 * i));
+	}
+	if (nonce != NULL) {
+		memcpy(k + 13, nonce, 32);
+	}
+	k[93] = (uint8_t)(dlen >> 8);
+	k[94] = (uint8_t)dlen;
+	if (dlen) {
+		memcpy(k + 95, data, dlen);
+	}
+	sweet_wcr_hmac_sha1(s_ptk, 16, e + 14, 4 + body, NULL, 0, NULL, 0, mic);
+	memcpy(k + 77, mic, 16);
+	if (!w_tx_ether(e, 14 + 4 + body, true)) {
+		LOG("t=%u ms: wpa: EAPOL tx FAILED", g_ms);
+	}
+}
+
+static bool
+w_eapol_mic_ok(uint8_t *eapol, size_t len)
+{
+	uint8_t want[16], got[20];
+	if (len < 4 + 95) {
+		return false;
+	}
+	memcpy(want, eapol + 4 + 77, 16);
+	bzero(eapol + 4 + 77, 16);
+	sweet_wcr_hmac_sha1(s_ptk, 16, eapol, len, NULL, 0, NULL, 0, got);
+	memcpy(eapol + 4 + 77, want, 16);
+	return memcmp(want, got, 16) == 0;
+}
+
+static void
+w_eapol_msg1(const uint8_t *k, uint64_t replay)
+{
+	uint8_t data[76];
+	const uint8_t *aa = s_bssid, *spa = sweet_wlan_mac();
+
+	if (++s_msg1s > 3) {
+		LOG("t=%u ms: wpa: the AP keeps sending message 1: wrong passphrase?", g_ms);
+		w_join_end(EAUTH);
+		return;
+	}
+	s_replay = replay;
+	memcpy(s_anonce, k + 13, 32);
+	read_random(s_snonce, 32);
+	bool amin = memcmp(aa, spa, 6) < 0, nmin = memcmp(s_anonce, s_snonce, 32) < 0;
+	memcpy(data, amin ? aa : spa, 6);
+	memcpy(data + 6, amin ? spa : aa, 6);
+	memcpy(data + 12, nmin ? s_anonce : s_snonce, 32);
+	memcpy(data + 44, nmin ? s_snonce : s_anonce, 32);
+	sweet_wcr_prf(s_pmk, 32, "Pairwise key expansion", data, sizeof(data), s_ptk, 48);
+	w_eapol_send(0x010A, s_snonce, s_rsn_ie, sizeof(s_rsn_ie));
+	LOG("t=%u ms: wpa: message 1 -> message 2 sent", g_ms);
+}
+
+static void
+w_eapol_msg3(uint8_t *frame, size_t len, const uint8_t *k, uint16_t info, uint16_t dlen, uint64_t replay)
+{
+	uint8_t plain[256], gtk[32], gtk_len = 0, gtk_idx = 1;
+
+	if (!w_eapol_mic_ok(frame, len)) {
+		LOG("t=%u ms: wpa: message 3 MIC wrong: wrong passphrase", g_ms);
+		w_join_end(EAUTH);
+		return;
+	}
+	s_replay = replay;
+	if ((info & 0x1000) && dlen >= 24 && dlen <= sizeof(plain) + 8 && sweet_wcr_aes_unwrap(s_ptk + 16, k + 95, dlen, plain)) {
+		for (uint32_t o = 0; o + 2 <= (uint32_t)dlen - 8 && o + 2 + plain[o + 1] <= (uint32_t)dlen - 8; o += 2 + plain[o + 1]) {
+			if (plain[o] == 0xDD && plain[o + 1] >= 6 && plain[o + 2] == 0x00 && plain[o + 3] == 0x0F &&
+			    plain[o + 4] == 0xAC && plain[o + 5] == 0x01) {
+				gtk_idx = plain[o + 6] & 3;
+				gtk_len = (uint8_t)MIN((uint32_t)plain[o + 1] - 6, 32u);
+				memcpy(gtk, plain + o + 8, gtk_len);
+			}
+		}
+	}
+	w_eapol_send(0x030A, NULL, NULL, 0);
+	delay(5000);                                /* message 4 out in the clear before the keys go in */
+	w_install_key(false, 0, WMI_CIPHER_CCMP, s_ptk + 32, 16);
+	if (gtk_len != 0) {
+		w_install_key(true, gtk_idx, s_group_cipher == 2 ? WMI_CIPHER_TKIP : WMI_CIPHER_CCMP, gtk, gtk_len);
+	}
+	w_peer_param(PEER_PARAM_AUTHORIZE, 1);
+	s_ptk_set = true;
+	bzero(gtk, sizeof(gtk));
+	bzero(plain, sizeof(plain));
+	LOG("t=%u ms: *** WPA2 keys installed (group key %s, idx %u) ***", g_ms, gtk_len ? "yes" : "NO", gtk_idx);
+	w_join_end(0);
+}
+
+static void
+w_eapol_rx(const uint8_t *e, size_t elen)
+{
+	uint8_t frame[512];
+	rx_eapol++;
+	if (s_state != S_4WAY || elen < 14 + 4 + 95 || elen - 14 > sizeof(frame) || memcmp(e + 6, s_bssid, 6) != 0) {
+		return;
+	}
+	size_t len = elen - 14;
+	memcpy(frame, e + 14, len);
+	uint8_t *k = frame + 4;
+	if (frame[1] != 3 || k[0] != 2) {
+		return;
+	}
+	uint16_t info = (uint16_t)(k[1] << 8 | k[2]), dlen = (uint16_t)(k[93] << 8 | k[94]);
+	uint64_t replay = 0;
+	for (int i = 0; i < 8; i++) {
+		replay = replay << 8 | k[5 + i];
+	}
+	if (95 + (size_t)dlen > len - 4) {
+		return;
+	}
+	bool pairwise = info & 0x0008, ack = info & 0x0080, has_mic = info & 0x0100, install = info & 0x0040;
+	if (pairwise && ack && !has_mic) {
+		w_eapol_msg1(k, replay);
+	} else if (pairwise && ack && has_mic && install) {
+		w_eapol_msg3(frame, len, k, info, dlen, replay);
+	}
+}
+
+/* ---------------------------------------------------------------- DHCP probe (data path check) */
+
+static uint16_t
+ip_csum(const uint8_t *p, uint32_t n)
+{
+	uint32_t s = 0;
+	for (uint32_t i = 0; i + 1 < n; i += 2) {
+		s += (uint32_t)(p[i] << 8 | p[i + 1]);
+	}
+	while (s >> 16) {
+		s = (s & 0xFFFF) + (s >> 16);
+	}
+	return (uint16_t)~s;
+}
+
+static void
+dhcp_discover(void)
+{
+	static uint8_t e[14 + 20 + 8 + 300];
+	uint8_t *ip = e + 14, *udp = ip + 20, *b = udp + 8;
+	const uint8_t *mac = sweet_wlan_mac();
+	uint16_t iplen = 20 + 8 + 300, ulen = 8 + 300, c;
+
+	bzero(e, sizeof(e));
+	memset(e, 0xFF, 6);
+	memcpy(e + 6, mac, 6);
+	e[12] = 0x08;
+	ip[0] = 0x45;
+	ip[2] = (uint8_t)(iplen >> 8);
+	ip[3] = (uint8_t)iplen;
+	ip[8] = 64;
+	ip[9] = 17;
+	memset(ip + 16, 0xFF, 4);
+	c = ip_csum(ip, 20);
+	ip[10] = (uint8_t)(c >> 8);
+	ip[11] = (uint8_t)c;
+	udp[1] = 68;
+	udp[3] = 67;
+	udp[4] = (uint8_t)(ulen >> 8);
+	udp[5] = (uint8_t)ulen;
+	b[0] = 1;                                   /* BOOTREQUEST */
+	b[1] = 1;
+	b[2] = 6;
+	read_random(&dhcp_xid, 4);
+	memcpy(b + 4, &dhcp_xid, 4);
+	b[10] = 0x80;                               /* broadcast reply */
+	memcpy(b + 28, mac, 6);
+	static const uint8_t opt[] = { 0x63, 0x82, 0x53, 0x63, 53, 1, 1, 55, 4, 1, 3, 6, 15, 255 };
+	memcpy(b + 236, opt, sizeof(opt));
+	dhcp_sent = w_tx_ether(e, sizeof(e), false);
+	LOG("t=%u ms: dhcp: DISCOVER %s", g_ms, dhcp_sent ? "sent" : "FAILED");
+}
+
+static void
+dhcp_rx(const uint8_t *e, size_t len)
+{
+	const uint8_t *ip = e + 14, *b;
+	if (dhcp_offer || len < 14 + 20 + 8 + 240 || e[12] != 0x08 || e[13] != 0x00 || ip[9] != 17) {
+		return;
+	}
+	uint32_t ihl = (ip[0] & 0xF) * 4u;
+	if (len < 14 + ihl + 8 + 240 || ip[ihl + 2] != 0 || ip[ihl + 3] != 68) {
+		return;
+	}
+	b = ip + ihl + 8;
+	if (b[0] != 2 || memcmp(b + 4, &dhcp_xid, 4) != 0) {
+		return;
+	}
+	dhcp_offer = true;
+	LOG("t=%u ms: *** DHCP reply: offered %u.%u.%u.%u by %u.%u.%u.%u (data path works both ways) ***", g_ms,
+	    b[16], b[17], b[18], b[19], ip[12], ip[13], ip[14], ip[15]);
+}
+
+/* ---------------------------------------------------------------- the join, from the watch loop */
+
+static void
+w_teardown(void)
+{
+	if (s_state >= S_START) {
+		if (s_state >= S_4WAY) {
+			w_vdev_simple(CMD_VDEV_DOWN, TAG_VDEV_DOWN);
+		}
+		if (s_state >= S_AUTH) {
+			w_peer(CMD_PEER_DELETE, TAG_PEER_DELETE, false);
+		}
+		w_vdev_simple(CMD_VDEV_STOP, TAG_VDEV_STOP);
+	}
+	s_state = S_IDLE;
+	s_ptk_set = false;
+}
+
+static void
+w_join_end(int result)
+{
+	if (result != 0) {
+		LOG("t=%u ms: join: failed (%d) in state %u", g_ms, result, s_state);
+		w_teardown();
+	} else {
+		s_state = S_UP;
+		LOG("t=%u ms: *** JOINED %.*s ***", g_ms, (int)s_ssid_len, s_ssid);
+		dhcp_discover();
+	}
+	bzero(s_pmk, sizeof(s_pmk));
+	bzero(s_ptk, 32);                           /* KCK/KEK no longer needed; the TK is in the firmware */
+}
+
+static void
+w_make_rsn_ie(void)
+{
+	static const uint8_t hdr[4] = { 48, 20, 1, 0 };
+	const uint8_t *rsn = w_find_ie(s_body, s_body_len, 48);
+	uint8_t *q = s_rsn_ie + 4;
+
+	s_rsn = rsn != NULL;
+	s_group_cipher = (rsn != NULL && rsn[1] >= 8) ? rsn[2 + 2 + 3] : 4;
+	memcpy(s_rsn_ie, hdr, 4);
+	*q++ = 0x00; *q++ = 0x0F; *q++ = 0xAC; *q++ = s_group_cipher;
+	*q++ = 1; *q++ = 0; *q++ = 0x00; *q++ = 0x0F; *q++ = 0xAC; *q++ = 4;   /* pairwise CCMP */
+	*q++ = 1; *q++ = 0; *q++ = 0x00; *q++ = 0x0F; *q++ = 0xAC; *q++ = 2;   /* AKM PSK */
+	*q++ = 0; *q++ = 0;
+}
+
+static void
+w_join_begin(void)
+{
+	struct sweet_bss_info b;
+	if (!sweet_wlan_pick(s_ssid, s_ssid_len, &b)) {
+		LOG("t=%u ms: join: '%.*s' not heard", g_ms, (int)s_ssid_len, s_ssid);
+		w_join_end(ENOENT);
+		return;
+	}
+	memcpy(s_bssid, b.bssid, 6);
+	s_freq = b.freq;
+	s_body_len = MIN((uint32_t)b.ie_len, (uint32_t)sizeof(s_body));
+	memcpy(s_body, b.ie, s_body_len);
+	w_make_rsn_ie();
+	uint32_t bcn = b.bintval ? b.bintval : 100, dtim = 1;
+	const uint8_t *tim = w_find_ie(s_body, s_body_len, 5);
+	if (tim != NULL && tim[1] >= 2 && tim[3] != 0) {
+		dtim = tim[3];
+	}
+	s_mgmt_htt = sweet_wlan_mgmt == 2 || (sweet_wlan_mgmt == 0 && !sweet_wlan_svc(SVC_MGMT_TX_WMI));
+	s_msg1s = 0;
+	s_start_resp = false;
+	s_joins++;
+	LOG("t=%u ms: join %u: %.*s %02x:%02x:%02x:**:**:** %u MHz %d dBm %s, group cipher %u, mgmt over %s",
+	    g_ms, s_joins, (int)s_ssid_len, s_ssid, s_bssid[0], s_bssid[1], s_bssid[2], s_freq, b.rssi,
+	    s_rsn ? "WPA2" : "open", s_group_cipher, s_mgmt_htt ? "HTT" : "WMI");
+	w_ps_off();
+	if (!w_vdev_start(s_freq, bcn, dtim)) {
+		w_join_end(EIO);
+		return;
+	}
+	s_state = S_START;
+	s_deadline = g_ms + 1500;
+}
+
+static void
+w_assoc_resp(const uint8_t *f, uint32_t len)
+{
+	uint16_t v = (uint16_t)(f[26] | f[27] << 8);
+	uint8_t m[20], *p;
+
+	s_aid = (uint32_t)(f[28] | f[29] << 8) & 0x3FFF;
+	LOG("t=%u ms: join: assoc reply status %u aid %u", g_ms, v, s_aid);
+	if (v != 0 || len < 30) {
+		w_join_end(ECONNREFUSED);
+		return;
+	}
+	w_peer_assoc((uint32_t)(f[24] | f[25] << 8));
+	p = sweet_wmi_tlv(m, TAG_VDEV_UP, 16);
+	p = w_p32(p, 0);
+	p = w_p32(p, s_aid);
+	w_pmac(p, s_bssid);
+	sweet_wmi_cmd(CMD_VDEV_UP, m, sizeof(m));
+	s_state = S_4WAY;
+	if (!s_rsn) {
+		w_peer_param(PEER_PARAM_AUTHORIZE, 1);
+		w_join_end(0);
+		return;
+	}
+	s_deadline = g_ms + 8000;
+	LOG("t=%u ms: join: associated, waiting for the 4-way handshake", g_ms);
+}
+
+/* auth, assoc response, deauth, disassoc (from the WMI management rx path) */
+void
+sweet_wsta_mgmt_rx(const uint8_t *f, uint32_t len)
+{
+	if (len < 26 || s_state == S_IDLE || memcmp(f + 10, s_bssid, 6) != 0) {
+		return;
+	}
+	uint8_t fc = f[0];
+	uint16_t v = (uint16_t)(f[24] | f[25] << 8);
+	if (fc == FC_AUTH && s_state == S_AUTH && len >= 30 && f[26] == 2) {
+		v = (uint16_t)(f[28] | f[29] << 8);
+		LOG("t=%u ms: join: auth reply status %u", g_ms, v);
+		if (v != 0) {
+			w_join_end(ECONNREFUSED);
+			return;
+		}
+		s_state = S_ASSOC;
+		s_tries = 1;
+		w_build_assoc_req();
+		w_mgmt_tx(s_assoc_req, s_assoc_req_len);
+		s_deadline = g_ms + 400;
+	} else if (fc == FC_ASSOC_RESP && s_state == S_ASSOC && len >= 30) {
+		w_assoc_resp(f, len);
+	} else if (fc == FC_DEAUTH || fc == FC_DISASSOC) {
+		LOG("t=%u ms: join: the AP ended the link, reason %u (state %u)", g_ms, v, s_state);
+		if (s_state == S_UP) {
+			w_teardown();
+		} else {
+			w_join_end(s_state == S_4WAY ? EAUTH : ECONNREFUSED);
+		}
+	}
+}
+
+void
+sweet_wsta_event(uint32_t id, const uint8_t *t, uint32_t len)
+{
+	uint16_t l = 0;
+	uint32_t v[4] = { 0 };
+	if (len >= 4) {
+		memcpy(&l, t, 2);
+	}
+	if (len < 4u + l) {
+		return;
+	}
+	memcpy(v, t + 4, MIN((uint32_t)l, (uint32_t)sizeof(v)));
+	if (id == EV_VDEV_START_RESP && l >= 16) {  /* {vdev, req, type, status} */
+		s_start_status = (int32_t)v[3];
+		s_start_resp = true;
+		LOG("t=%u ms: join: VDEV_START_RESP status %d", g_ms, s_start_status);
+	} else if (id == EV_PEER_STA_KICKOUT && s_state == S_UP) {
+		LOG("t=%u ms: join: peer kickout", g_ms);
+		w_teardown();
+	}
+}
+
+/* a received data frame (native wifi, from the HTT rx ring) */
+void
+sweet_wsta_rx_native(const uint8_t *f, uint32_t len)
+{
+	static uint8_t e[14 + 1600];
+	if (len < 24 + 8 || (f[0] & 0x0C) != 0x08) {
+		return;                                 /* data frames only */
+	}
+	uint32_t hl = ((f[1] & 3) == 3) ? 30 : 24;
+	const uint8_t *da = f + 4, *sa = (f[1] & 2) ? f + 16 : f + 10;   /* from DS: addr3 is the source */
+	const uint8_t *llc = f + hl;
+	if (len < hl + 8 || llc[0] != 0xAA || llc[1] != 0xAA || llc[2] != 0x03) {
+		return;
+	}
+	uint32_t plen = len - hl - 8;
+	if (plen > 1600) {
+		return;
+	}
+	rx_data++;
+	memcpy(e, da, 6);
+	memcpy(e + 6, sa, 6);
+	memcpy(e + 12, llc + 6, 2);
+	memcpy(e + 14, llc + 8, plen);
+	if (e[12] == 0x88 && e[13] == 0x8E) {
+		w_eapol_rx(e, 14 + plen);
+		return;
+	}
+	if (s_state == S_UP && dhcp_sent) {
+		dhcp_rx(e, 14 + plen);
+	}
+}
+
+/* ssid= / psk= from WLAN_CONF; false if missing or malformed (nothing is logged about the values) */
+static bool
+w_read_conf(uint8_t pass[64], uint32_t *pass_len)
+{
+	char buf[256];
+	uint64_t size = 0;
+	if (sweet_msvc_file_read(WLAN_CONF, buf, 0, &size) != 0 || size == 0 || size >= sizeof(buf)) {
+		LOG("join: no usable %s (size %llu)", WLAN_CONF, (unsigned long long)size);
+		return false;
+	}
+	if (sweet_msvc_file_read(WLAN_CONF, buf, size, NULL) != 0) {
+		return false;
+	}
+	buf[size] = 0;
+	s_ssid_len = 0;
+	*pass_len = 0;
+	for (char *line = buf; line != NULL && *line != 0;) {
+		char *nl = strchr(line, '\n');
+		if (nl != NULL) {
+			*nl = 0;
+		}
+		size_t n = strlen(line);
+		while (n > 0 && (line[n - 1] == '\r' || line[n - 1] == ' ')) {
+			line[--n] = 0;
+		}
+		if (strncmp(line, "ssid=", 5) == 0 && n - 5 <= 32) {
+			s_ssid_len = (uint8_t)(n - 5);
+			memcpy(s_ssid, line + 5, s_ssid_len);
+		} else if (strncmp(line, "psk=", 4) == 0 && n - 4 <= 63) {
+			*pass_len = (uint32_t)(n - 4);
+			memcpy(pass, line + 4, *pass_len);
+		}
+		line = nl != NULL ? nl + 1 : NULL;
+	}
+	bzero(buf, sizeof(buf));
+	return s_ssid_len != 0 && (*pass_len == 0 || *pass_len >= 8);
+}
+
+static void
+w_ask_join(void)
+{
+	uint8_t pass[64];
+	uint32_t pass_len = 0;
+	if (!s_tested) {
+		s_tested = true;
+		s_crypto_ok = sweet_wcr_selftest();
+	}
+	if (!s_crypto_ok || !w_read_conf(pass, &pass_len)) {
+		return;
+	}
+	bzero(s_pmk, sizeof(s_pmk));
+	if (pass_len != 0) {
+		sweet_wcr_pbkdf2_pmk(pass, pass_len, s_ssid, s_ssid_len, s_pmk);
+	}
+	bzero(pass, sizeof(pass));
+	s_join_asked = true;
+	LOG("t=%u ms: join: asked for '%.*s' (%s)", g_ms, (int)s_ssid_len, s_ssid, pass_len ? "WPA2-PSK" : "open");
+}
+
+void
+sweet_wsta_scan_done(void)
+{
+	if (!s_conf_tried && sweet_wlan_join == 1) {
+		s_conf_tried = true;
+		w_ask_join();
+	}
+}
+
+bool
+sweet_wsta_busy(void)
+{
+	return s_join_asked || s_state != S_IDLE;
+}
+
+static void
+w_retry_or_fail(void)
+{
+	if (s_tries >= 4) {
+		w_join_end(ETIMEDOUT);
+		return;
+	}
+	s_tries++;
+	if (s_state == S_AUTH) {
+		w_send_auth();
+	} else {
+		w_mgmt_tx(s_assoc_req, s_assoc_req_len);
+	}
+	s_deadline = g_ms + 400;
+}
+
+/* every pass of the watch loop */
+void
+sweet_wsta_poll(void)
+{
+	if (sweet_wlan_join == 2) {
+		sweet_wlan_join = 1;
+		w_teardown();
+		w_ask_join();
+	}
+	if (s_join_asked && !sweet_wlan_scanning()) {
+		s_join_asked = false;
+		w_teardown();
+		w_join_begin();
+		return;
+	}
+	if (s_state == S_START) {
+		if (s_start_resp) {
+			if (s_start_status != 0) {
+				w_join_end(EIO);
+				return;
+			}
+			s_state = S_AUTH;
+			s_tries = 1;
+			w_peer(CMD_PEER_CREATE, TAG_PEER_CREATE, true);
+			w_send_auth();
+			s_deadline = g_ms + 400;
+		} else if (g_ms > s_deadline) {
+			w_join_end(ETIMEDOUT);
+		}
+	} else if ((s_state == S_AUTH || s_state == S_ASSOC) && g_ms > s_deadline) {
+		w_retry_or_fail();
+	} else if (s_state == S_4WAY && g_ms > s_deadline) {
+		LOG("t=%u ms: join: no 4-way handshake (%u message 1s, %u EAPOL frames)", g_ms, s_msg1s, rx_eapol);
+		w_join_end(s_msg1s != 0 ? EAUTH : ETIMEDOUT);
+	}
+}
+
+void
+sweet_wsta_summary(void)
+{
+	LOG("sta: state %u joins %u; rx data %u eapol %u; dhcp sent %u offer %u", s_state, s_joins, rx_data, rx_eapol,
+	    dhcp_sent, dhcp_offer);
+}
