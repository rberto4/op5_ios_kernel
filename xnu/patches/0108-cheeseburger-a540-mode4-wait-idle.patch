+/* CP_MEM_WRITE of val into the scratch word; true when the GPU wrote it. */
+static bool
+mem_write_test(uint32_t val, bool wait_idle_first, const char *what)
+{
+	uint64_t target = dma_pa + DMA_SCRATCH;
+	*(volatile uint32_t *)(dma + DMA_SCRATCH) = 0xdeadbeef;
+	flush_dcache64(target, 64, TRUE);
+	if (wait_idle_first) {
+		rb_pkt7(CP_WAIT_FOR_IDLE, 0);
+	}
+	rb_pkt7(CP_MEM_WRITE, 3);
+	rb_out((uint32_t)target);
+	rb_out((uint32_t)(target >> 32));
+	rb_out(val);
+	bool drained = rb_flush_wait(what);
+	flush_dcache64(target, 64, TRUE);
+	uint32_t got = *(volatile uint32_t *)(dma + DMA_SCRATCH);
+	printf("SWEET GPU B: %s: scratch at 0x%llx = 0x%08x (%s)\n", what, target, got,
+	    got == val ? "GPU WROTE IT" : "unchanged");
+	return drained && got == val;
+}
