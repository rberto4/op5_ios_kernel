+/* WLAN MSA (W4): its own MiB between the metadata buffer and the pool, never mapped for long */
+#define WLFW_MSA_PA         0xb0400000ull
 #define WLFW_MSA_SIZE       0x00100000u
 
 struct smem_part_hdr { uint8_t magic[4]; uint16_t host0, host1; uint32_t size, free_uncached, free_cached, rsvd[3]; } __attribute__((packed));
@@ -101,6 +101,13 @@ void sweet_wsmmu_fault_poll(unsigned ms);
