 bsd/dev/sweet_mlink.h |  15 +-
 bsd/dev/sweet_wce.c   |  71 ++++-
 bsd/dev/sweet_wlfw.c  |   1 +
 bsd/dev/sweet_wmi.c   | 726 ++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 796 insertions(+), 18 deletions(-)
