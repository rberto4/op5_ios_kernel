diff --git a/bsd/dev/sweet_wifi_ios.c b/bsd/dev/sweet_wifi_ios.c
new file mode 100644
index 0000000..ad6a8b0
--- /dev/null
+++ b/bsd/dev/sweet_wifi_ios.c
@@ -0,0 +1,194 @@
+/*
+ * cheeseburger: the station side of sys/redwood_sta.h over the WCN3990 radio (sweet_wlan.h), so that
+ * iOS's Wi-Fi side finds it. When the first scan is over, en0 is made (a radio, link down until a
+ * join) and the station attached: wifid finds a Wi-Fi interface, Settings lists what the scans hear,
+ * and a join asked there runs the kernel's WPA2-PSK station (sweet_wsta.c).
+ *
+ * Port of topaz bsd/dev/topaz_sta.c (0900, APSL 2.0) to the cheeseburger radio API. Only with
+ * boot-arg sweetwifi=1 (the modem and the WLAN served for the session, sweet_mss.c).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/redwood_net.h>
+#include <sys/redwood_sta.h>
+#include <sys/systm.h>
+#include "sweet_wlan.h"
+
+extern kern_return_t thread_terminate(thread_t thread);
+void MiniIONetworkStackStart(void);   /* iokit/Kernel/arm/MiniIONetworkStack.cpp */
+void sweet_wifi_ios_init(void);
+
+static const uint16_t sta_freqs[] = {
+	2412, 2417, 2422, 2427, 2432, 2437, 2442, 2447, 2452, 2457, 2462, 2467, 2472,
+	5180, 5200, 5220, 5240, 5260, 5280, 5300, 5320,
+	5500, 5520, 5540, 5560, 5580, 5600, 5620, 5640, 5660, 5680, 5700,
+	5745, 5765, 5785, 5805, 5825,
+};
+
+static void
+bss_copy(const struct sweet_wlan_bss *t, struct redwood_sta_bss *b)
+{
+	bzero(b, sizeof(*b));
+	memcpy(b->bssid, t->bssid, 6);
+	memcpy(b->ssid, t->ssid, t->ssid_length);
+	b->ssid_length = t->ssid_length;
+	b->frequency = t->frequency;
+	b->rssi = t->rssi;
+	b->beacon_interval = t->beacon_interval;
+	b->capability = t->capability;
+	b->age_ms = t->age_ms;
+	b->elements_length = t->elements_length < REDWOOD_STA_ELEMENTS_MOST ? t->elements_length : REDWOOD_STA_ELEMENTS_MOST;
+	memcpy(b->elements, t->elements, b->elements_length);
+}
+
+static int
+sta_power(__unused bool on)
+{
+	return 0;                               /* the radio stays up with the modem */
+}
+
+static int
+sta_scan(__unused const struct redwood_sta_scan *what)
+{
+	return sweet_wlan_api_scan();
+}
+
+static void
+sta_heard(void (*each)(const struct redwood_sta_bss *bss, void *context), void *context)
+{
+	static struct sweet_wlan_bss t;
+	static struct redwood_sta_bss b;
+
+	for (unsigned i = 0; sweet_wlan_api_heard(i, &t); i++) {
+		if (t.age_ms > 60000 || t.ssid_length == 0) {
+			continue;                       /* not heard in the last minute, or hidden */
+		}
+		bss_copy(&t, &b);
+		each(&b, context);
+	}
+}
+
+static int
+sta_join(const struct redwood_sta_join *what)
+{
+	bool wpa = what->security == REDWOOD_STA_WPA2_PSK;
+	int error = sweet_wlan_api_join(what->ssid, what->ssid_length, what->bssid,
+	    wpa ? what->passphrase : NULL, wpa ? what->passphrase_length : 0,
+	    wpa && what->passphrase_length == 0 ? what->pmk : NULL);
+	printf("SWEET WIFI: join asked by iOS -> %d\n", error);
+	return error;
+}
+
+static int
+sta_leave(void)
+{
+	return sweet_wlan_api_leave();
+}
+
+/* on any thread, does not sleep */
+static void
+sta_state(struct redwood_sta_state *state)
+{
+	static struct sweet_wlan_bss t;
+
+	bzero(state, sizeof(*state));
+	state->phase = sweet_wlan_api_joined() ? REDWOOD_STA_JOINED : REDWOOD_STA_IDLE;
+	if (state->phase == REDWOOD_STA_JOINED && sweet_wlan_api_current(&t)) {
+		bss_copy(&t, &state->bss);
+	}
+	state->last_error = sweet_wlan_api_last_error();
+}
+
+static unsigned
+sta_channels(struct redwood_sta_channel *channels, unsigned most)
+{
+	unsigned n = 0;
+	for (; n < most && n < sizeof(sta_freqs) / sizeof(sta_freqs[0]); n++) {
+		channels[n].frequency = sta_freqs[n];
+		channels[n].flags = REDWOOD_STA_CHANNEL_PASSIVE;
+	}
+	return n;
+}
+
+static struct redwood_sta_ops sta_ops = {
+	.power = sta_power,
+	.scan = sta_scan,
+	.heard = sta_heard,
+	.join = sta_join,
+	.leave = sta_leave,
+	.state = sta_state,
+	.channels = sta_channels,
+};
+
+static bool
+sta_transmit(mbuf_t packet, size_t length)
+{
+	static uint8_t frame[REDWOOD_NET_FRAME_MAX];   /* (one sender at a time: redwood_net's tx lock) */
+	if (length > sizeof(frame) || mbuf_copydata(packet, 0, length, frame) != 0) {
+		return false;
+	}
+	return sweet_wlan_api_transmit(frame, length);
+}
+
+static void
+sta_rx(const uint8_t *frame, size_t length)
+{
+	redwood_net_input(frame, length);
+}
+
+static void
+sta_link_changed(bool up)
+{
+	redwood_net_link_state(up);
+	if (!up && sweet_wlan_api_last_error() == 0) {
+		redwood_sta_lost(ECONNRESET);
+	}
+}
+
+static struct redwood_net_link sta_link = {
+	.name = "wcn3990",
+	.wireless = true,
+	.up = false,
+	.transmit = sta_transmit,
+	.poll = NULL,
+};
+
+/* from the radio's thread, once its first scan is over: the work goes on a thread of its own */
+static void
+sta_bring_up(__unused void *arg, __unused wait_result_t wr)
+{
+	sweet_wlan_api_address(sta_link.address);
+	memcpy(sta_ops.address, sta_link.address, 6);
+	sweet_wlan_rx_hook = sta_rx;
+	sweet_wlan_link_hook = sta_link_changed;
+	if (redwood_net_attach(&sta_link)) {
+		redwood_sta_attach(&sta_ops);
+		printf("SWEET WIFI: en0 and the station are up for iOS\n");
+		if (sweet_wlan_api_joined()) {
+			sta_link_changed(true);         /* joined already (wlan.conf): tell configd */
+		}
+	}
+	thread_terminate(current_thread());
+}
+
+static void
+sta_ready(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sta_bring_up, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* from sweet_mss_boot_init(), boot-arg sweetwifi=1 */
+void
+sweet_wifi_ios_init(void)
+{
+	redwood_net_init();
+	MiniIONetworkStackStart();              /* configd waits for it before it calls the registry quiet */
+	sweet_wlan_ready_hook = sta_ready;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_wlan.h b/bsd/dev/sweet_wlan.h
new file mode 100644
index 0000000..f8dcf92
--- /dev/null
+++ b/bsd/dev/sweet_wlan.h
@@ -0,0 +1,46 @@
+/*
+ * The cheeseburger WLAN radio for the rest of the kernel (0173): what bsd/dev/sweet_wifi_ios.c (en0 and
+ * Apple80211 for wifid) asks of the station that runs on the modem's session thread
+ * (sweet_wmi.c, sweet_wsta.c). Calls may come from any thread and may block (a scan, a join); the
+ * hooks are called from the session thread.
+ *
+ * Plain C types only, like topaz's topaz_wlan_* API (TopazModem.cpp 0126/0129/0130, APSL 2.0).
+ */
+#ifndef SWEET_WLAN_H
+#define SWEET_WLAN_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define SWEET_WLAN_IE_MAX       768
+
+struct sweet_wlan_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32], ssid_length;
+	uint16_t frequency;                     /* MHz */
+	int16_t rssi;                           /* dBm */
+	uint16_t beacon_interval, capability;
+	uint32_t age_ms;                        /* since last heard */
+	uint16_t elements_length;
+	uint8_t elements[SWEET_WLAN_IE_MAX];    /* the beacon's information elements */
+};
+
+extern void (*sweet_wlan_ready_hook)(void);                            /* once: the first scan is over */
+extern void (*sweet_wlan_rx_hook)(const uint8_t *frame, size_t length); /* an Ethernet frame arrived */
+extern void (*sweet_wlan_link_hook)(bool up);                          /* joined (keys in) / lost or left */
+
+bool sweet_wlan_api_ready(void);
+int  sweet_wlan_api_scan(void);                                         /* blocks until the scan is over */
+bool sweet_wlan_api_heard(unsigned index, struct sweet_wlan_bss *out);
+bool sweet_wlan_api_current(struct sweet_wlan_bss *out);                /* the network joined */
+void sweet_wlan_api_address(uint8_t address[6]);
+/* blocks until joined or failed: 0, EAUTH (passphrase), ENOENT (not heard), ETIMEDOUT, ECONNREFUSED, EIO */
+int  sweet_wlan_api_join(const uint8_t *ssid, unsigned ssid_length, const uint8_t *bssid,
+    const uint8_t *passphrase, unsigned passphrase_length, const uint8_t *pmk);
+int  sweet_wlan_api_leave(void);
+bool sweet_wlan_api_joined(void);
+int  sweet_wlan_api_last_error(void);
+bool sweet_wlan_api_transmit(const uint8_t *frame, size_t length);     /* Ethernet; queued for the session thread */
+
+#endif /* SWEET_WLAN_H */
