diff --git a/bsd/dev/sweet_mlink.h b/bsd/dev/sweet_mlink.h
index a4bd44b..754de27 100644
--- a/bsd/dev/sweet_mlink.h
+++ b/bsd/dev/sweet_mlink.h
@@ -117,6 +117,7 @@ bool sweet_wce_wmi_send(const void *data, uint32_t len);
 void sweet_wmi_rx(const uint8_t *d, uint32_t len);
