+/* ---------------------------------------------------------------- 0173: for other threads (sweet_wlan.h) */
+
+static LCK_GRP_DECLARE(etx_grp, "sweet-wlan-tx");
+static LCK_MTX_DECLARE(etx_lock, &etx_grp);
+#define ETXQ 32
+static struct { uint16_t len; uint8_t d[1514]; } etxq[ETXQ];
+static uint32_t etxq_head, etxq_tail;
+
+bool
+sweet_wlan_api_transmit(const uint8_t *frame, size_t length)
+{
+	bool ok = false;
+	if (s_state != S_UP || length < 14 || length > 1514) {
+		tx_drop++;
+		return false;
+	}
+	lck_mtx_lock(&etx_lock);
+	if (etxq_tail - etxq_head < ETXQ) {
+		uint32_t i = etxq_tail % ETXQ;
+		etxq[i].len = (uint16_t)length;
+		memcpy(etxq[i].d, frame, length);
+		etxq_tail++;
+		ok = true;
+	}
+	lck_mtx_unlock(&etx_lock);
+	if (!ok) {
+		tx_drop++;
+	}
+	return ok;
+}
+
+/* on the session thread: up to 16 queued frames to the radio */
+static void
+w_tx_pump(void)
+{
+	static uint8_t one[1514];
+	for (int n = 0; n < 16; n++) {
+		uint16_t len;
+		lck_mtx_lock(&etx_lock);
+		if (etxq_head == etxq_tail) {
+			lck_mtx_unlock(&etx_lock);
+			return;
+		}
+		uint32_t i = etxq_head % ETXQ;
+		len = etxq[i].len;
+		memcpy(one, etxq[i].d, len);
+		lck_mtx_unlock(&etx_lock);
+		if (!w_tx_ether(one, len, false)) {
+			return;                             /* no TX slot now: the frame waits for the next pass */
+		}
+		tx_up++;
+		lck_mtx_lock(&etx_lock);
+		etxq_head++;
+		lck_mtx_unlock(&etx_lock);
+	}
+}
+
+int
+sweet_wlan_api_join(const uint8_t *ssid, unsigned ssid_length, const uint8_t *bssid, const uint8_t *passphrase,
+    unsigned passphrase_length, const uint8_t *pmk)
+{
+	uint8_t key[32] = { 0 };
+	bool any = false;
+	if (!sweet_wlan_api_ready() || ssid_length == 0 || ssid_length > 32) {
+		return sweet_wlan_api_ready() ? EINVAL : ENXIO;
+	}
+	if (!s_tested) {
+		s_tested = true;
+		s_crypto_ok = sweet_wcr_selftest();
+	}
+	if ((passphrase_length != 0 || pmk != NULL) && !s_crypto_ok) {
+		return EIO;
+	}
+	if (passphrase_length != 0 && (passphrase_length < 8 || passphrase_length > 63)) {
+		return EINVAL;
+	}
+	if (pmk != NULL) {
+		memcpy(key, pmk, 32);
+	} else if (passphrase_length != 0) {
+		sweet_wcr_pbkdf2_pmk(passphrase, passphrase_length, ssid, ssid_length, key);   /* here, not on the radio's thread */
+	}
+	for (int i = 0; bssid != NULL && i < 6; i++) {
+		any |= bssid[i] != 0;
+	}
+	while (s_api_join || s_join_asked) {
+		sweet_sleep_ms(50);
+	}
+	memcpy(s_ssid, ssid, ssid_length);
+	s_ssid_len = (uint8_t)ssid_length;
+	if (any) {
+		memcpy(s_want_bssid, bssid, 6);
+	}
+	s_want_bssid_set = any;
+	memcpy(s_pmk, key, 32);
+	bzero(key, sizeof(key));
+	uint32_t before = s_join_done;
+	__asm__ volatile ("dmb ish" ::: "memory");
+	s_api_join = true;
+	for (int i = 0; i < 300 && s_join_done == before; i++) {   /* 30 s */
+		sweet_sleep_ms(100);
+	}
+	return s_join_done != before ? s_result : ETIMEDOUT;
+}
+
+int
+sweet_wlan_api_leave(void)
+{
+	uint32_t before = s_join_done;
+	if (s_state == S_IDLE && !s_api_join) {
+		return 0;
+	}
+	s_api_leave = true;
+	for (int i = 0; i < 50 && s_join_done == before; i++) {
+		sweet_sleep_ms(100);
+	}
+	return 0;
+}
+
+bool
+sweet_wlan_api_joined(void)
+{
+	return s_state == S_UP;
+}
+
+int
+sweet_wlan_api_last_error(void)
+{
+	return s_result;
+}
+
+bool
+sweet_wlan_api_current(struct sweet_wlan_bss *out)
+{
+	return s_state == S_UP && sweet_wlan_bss_by_bssid(s_bssid, out);
 }
