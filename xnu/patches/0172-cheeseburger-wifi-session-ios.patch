 }
 
+
+/* ---------------------------------------------------------------- 0173: for other threads */
+
+
+bool
+sweet_wlan_api_ready(void)
+{
+	return api_ready;
+}
+
+int
+sweet_wlan_api_scan(void)
+{
+	uint32_t before = api_scans_done;
+	if (!api_ready) {
+		return ENXIO;
+	}
+	api_scan_asked = true;
+	for (int i = 0; i < 300 && api_scans_done == before; i++) {   /* 30 s */
+		sweet_sleep_ms(100);
+	}
+	return api_scans_done != before ? 0 : ETIMEDOUT;
+}
+
+static void
+bss_out(const struct bss *b, struct sweet_wlan_bss *out)
+{
+	bzero(out, sizeof(*out));
+	memcpy(out->bssid, b->bssid, 6);
+	memcpy(out->ssid, b->raw_ssid, b->raw_ssid_len);
+	out->ssid_length = b->raw_ssid_len;
+	out->frequency = b->freq;
+	out->rssi = b->rssi;
+	out->beacon_interval = b->bintval;
+	out->capability = b->capab;
+	out->age_ms = g_ms - b->last_ms;
+	out->elements_length = (uint16_t)MIN((uint32_t)b->ie_len, (uint32_t)SWEET_WLAN_IE_MAX);
+	memcpy(out->elements, b->ie, out->elements_length);
+}
+
+/* (the table only grows, and an entry is rewritten in place: a copy may mix two beacons of one AP) */
+bool
+sweet_wlan_api_heard(unsigned index, struct sweet_wlan_bss *out)
+{
+	if (index >= nbss) {
+		return false;
+	}
+	bss_out(&bss[index], out);
+	return true;
+}
+
+bool
+sweet_wlan_bss_by_bssid(const uint8_t *bssid, struct sweet_wlan_bss *out)
+{
+	for (uint32_t i = 0; i < nbss; i++) {
+		if (memcmp(bss[i].bssid, bssid, 6) == 0) {
+			bss_out(&bss[i], out);
+			return true;
+		}
+	}
+	return false;
+}
+
+void
