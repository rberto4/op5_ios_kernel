 }
 
@@ -469,6 +482,11 @@ w_on_resp(uint16_t msg, const uint8_t *d, uint32_t len)
 		break;
 	case WLFW_WLAN_CFG:
 		LOG("t=%u ms: wlfw: wlan_cfg %s err %u", g_ms, ok ? "ok" : "FAILED", err);
+		if (ok && sweet_wlfw_upto == 2) {
+			w_step = "stopped after WLAN_CFG (upto 2)";
+			LOG("wlfw: kern.sweetwlfw_upto 2: no mission");
+			break;
+		}
 		if (ok && wm_new(&m, WLFW_WLAN_MODE)) {
 			wm_u32(&m, 0x01, 0);                /* mission */
 			wm_u8(&m, 0x10, 0);                 /* hw_debug */
@@ -555,6 +573,12 @@ wlfw_poll(void)
