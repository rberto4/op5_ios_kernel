+uint32_t
+SweetGPUUserClient::surfaceSeed(const Bo &b)
+{
+	return b.surface->state != NULL ?
+	       *(volatile uint32_t *)((uint8_t *)b.surface->state->getBytesNoCopy() + SWEET_SURFACE_STATE_SEED) : 0;
+}
+
+/* 0137: see SWEET_GPU_SURFACE_DRAWN. With the lock held. */
+IOReturn
+SweetGPUUserClient::surfaceDrawn(struct sweet_surface_drawn *req)
+{
+	req->marked = 0;
+	for (uint32_t h = 1; h < SWEET_GPU_MAX_BOS; h++) {
+		Bo &b = fBo[h];
+		if (b.mem == NULL || b.surface == NULL || b.surface->id != req->surface || b.pushed == 0) {
+			continue;
+		}
+		b.seed = surfaceSeed(b);
+		b.pushed = mach_absolute_time();
+		req->marked++;
+	}
+	return kIOReturnSuccess;
+}
