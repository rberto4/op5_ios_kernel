From b154979311cf689d8e1ecfcfb66147b67ba033e7 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 23 Nov 2026 21:13:21 +0100
Subject: [PATCH] cheeseburger: put the modem in QMI DMS low power mode

0158: the fatal text now reads cleanly ('DOG_HB detects starvation of task'), the modem asks nothing of the AP (only DEL_CLIENT, no lookup, no unhandled DATA). The modem boots online; cellular activity starts after MCFG (~7 s) and with the WLAN firmware in mission on the same Q6 a task starves ~4 s later, while either alone survives. Stock keeps the modem in LPM until the RIL enables the radio: send DMS SET_OPERATING_MODE LOW_POWER as soon as DMS appears (kern.sweetmss_lpm, default 1).
---
 bsd/dev/sweet_glink.c |  3 +++
 bsd/dev/sweet_mlink.h |  2 ++
 bsd/dev/sweet_msvc.c  | 50 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 55 insertions(+)

diff --git a/bsd/dev/sweet_glink.c b/bsd/dev/sweet_glink.c
index 8122827..287940e 100644
--- a/bsd/dev/sweet_glink.c
+++ b/bsd/dev/sweet_glink.c
@@ -568,6 +568,9 @@ qrtr_rx(const uint8_t *p, uint32_t len)
 			q_srv[q_srv_count].port = c->d;
 			q_srv_count++;
 		}
+		if (c->a == 0x02 && c->c == q_modem_node) {
+			svc_dms_seen(c->c, c->d);       /* QMI DMS */
+		}
 		if (c->a == QMI_SVC_WLFW) {
 			LOG("t=%u ms: *** WLFW service 0x45 up: inst %x node %u port %x ***", g_ms, c->b, c->c, c->d);
 			wlfw_arrive(c->c, c->d);
diff --git a/bsd/dev/sweet_mlink.h b/bsd/dev/sweet_mlink.h
index f52f1ba..ef6af7f 100644
--- a/bsd/dev/sweet_mlink.h
+++ b/bsd/dev/sweet_mlink.h
@@ -44,6 +44,7 @@ struct smem_part_hdr { uint8_t magic[4]; uint16_t host0, host1; uint32_t size, f
 #define svc_announce        sweet_mlink_svc_announce
 #define svc_summary         sweet_mlink_svc_summary
 #define svc_lookup          sweet_mlink_svc_lookup
+#define svc_dms_seen        sweet_mlink_svc_dms_seen
 #define wlfw_arrive         sweet_mlink_wlfw_arrive
 #define wlfw_rx             sweet_mlink_wlfw_rx
 #define wlfw_poll           sweet_mlink_wlfw_poll
@@ -85,6 +86,7 @@ bool svc_rx(uint32_t src_node, uint32_t src_port, uint32_t dst_port, const uint8
 void svc_announce(void);
 void svc_summary(void);
 void svc_lookup(uint32_t node, uint32_t port, uint32_t service, uint32_t instance);
+void svc_dms_seen(uint32_t node, uint32_t port);
 void wlfw_arrive(uint32_t node, uint32_t port);
 /* sweet_wlfw.c (W4) */
 void wlfw_rx(const uint8_t *data, uint32_t len);
diff --git a/bsd/dev/sweet_msvc.c b/bsd/dev/sweet_msvc.c
index 6b3fc0f..ce18ff1 100644
--- a/bsd/dev/sweet_msvc.c
+++ b/bsd/dev/sweet_msvc.c
@@ -112,6 +112,7 @@ efs_read(const char *part, uint64_t off, void *dst, uint64_t n)
 #define PORT_PDM            0x4001
 #define PORT_TFTP           0x4002
 #define PORT_RMTFS          0x4003
+#define PORT_DMSC           0x4005              /* our QMI client port towards DMS */
 #define PORT_SESS           0x4100
 
 /* generated by fwtable_all.py from NON-HLOS.bin (HyperOS 2.0.208 modem_a): 657 files, 657 extents */
@@ -789,6 +790,49 @@ svc_lookup(uint32_t node, uint32_t port, uint32_t service, uint32_t instance)
 	LOG("t=%u ms: qrtr: LOOKUP svc %x inst %x from %u:%x -> %u of ours + end", g_ms, service, instance, node, port, n);
 }
 
+/*
+ * Stock Android keeps the modem in low power mode until the RIL turns the radio on. Ours
+ * booted "online": cellular search starts after MCFG (~7 s) and, with the WLAN firmware in
+ * mission mode on the same Q6, the modem's DOG_HB saw a starved task ~4 s later (0154-0158).
+ * QMI DMS SET_OPERATING_MODE (0x2E) TLV 1 = 1 (LOW_POWER) as soon as DMS appears.
+ */
+#include <sys/sysctl.h>
+static int sweet_mss_lpm = 1;
+SYSCTL_INT(_kern, OID_AUTO, sweetmss_lpm, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_mss_lpm, 0,
+    "put the modem in QMI DMS low power mode once DMS is up (1, default) or leave it online (0)");
+static bool dms_sent;
+
+void
+svc_dms_seen(uint32_t node, uint32_t port)
+{
+	struct qmsg m;
+	uint8_t mode = 1;
+
+	if (dms_sent || !sweet_mss_lpm) {
+		return;
+	}
+	dms_sent = true;
+	qm_init(&m, 1, 0x002E);
+	m.b[0] = QMI_REQ;
+	qm_tlv(&m, 0x01, &mode, 1);
+	qm_send(&m, PORT_DMSC, node, port);
+	LOG("t=%u ms: dms: SET_OPERATING_MODE low power sent to %u:%x", g_ms, node, port);
+}
+
+static void
+dms_rx(const uint8_t *d, uint32_t len)
+{
+	uint16_t msg, tl = 0;
+	memcpy(&msg, d + 3, 2);
+	const uint8_t *r = qm_find(d, len, 0x02, &tl);
+	uint16_t res = 0xffff, err = 0xffff;
+	if (r != NULL && tl >= 4) {
+		memcpy(&res, r, 2);
+		memcpy(&err, r + 2, 2);
+	}
+	LOG("t=%u ms: dms: type %u msg %x result %u error %u", g_ms, d[0], msg, res, err);
+}
+
 void
 svc_announce(void)
 {
@@ -815,6 +859,12 @@ svc_rx(uint32_t src_node, uint32_t src_port, uint32_t dst_port, const uint8_t *d
 		wlfw_rx(data, len);
 		return true;
 	}
+	if (dst_port == PORT_DMSC) {
+		if (len >= 7) {
+			dms_rx(data, len);
+		}
+		return true;
+	}
 	if (len < 7 || data[0] != QMI_REQ) {
 		return false;
 	}
