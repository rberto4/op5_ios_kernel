+/*
+ * Phase C step 4: first GPU rendering, a 2D blit (A5xx 2D engine, CP_BLIT),
+ * register sequence from Mesa freedreno fd5_blitter.c (MIT): emit_setup,
+ * then emit_blit for linear RGBA8 surfaces. Offsets and fields from Mesa
+ * a5xx.xml / adreno_pm4.xml. The CPU checks every destination pixel.
+ */
+#define R_RB_RENDER_CNTL        0xe141
+#define R_RB_2D_BLIT_CNTL       0x2100
+#define R_GRAS_2D_BLIT_CNTL     0x2180
+#define R_UNKNOWN_2184          0x2184
+#define R_RB_CNTL               0xe140
+#define R_RB_MODE_CNTL_2D       0x0cc6
+#define R_SP_MODE_CNTL          0x0ec2
+#define R_TPL1_MODE_CNTL_2D     0x0f02
+#define R_HLSQ_MODE_CNTL        0x0e06
+#define R_GRAS_CL_CNTL          0xe000
+#define R_RB_2D_SRC_INFO        0x2107
+#define R_GRAS_2D_SRC_INFO      0x2181
+#define R_RB_2D_DST_INFO        0x2110
+#define R_GRAS_2D_DST_INFO      0x2182
+#define RB_CNTL_BYPASS          (1u << 17)
+#define FMT_R8G8B8A8_UNORM      0x30u   /* RB5_R8G8B8A8_UNORM, TILE5_LINEAR, WZYX */
+#define IMG_W                   64u
+#define IMG_H                   64u
+#define IMG_PITCH               (IMG_W * 4u)
+#define BLIT_W                  48u
+#define BLIT_H                  48u
+#define BLIT_SX                 8u
+#define BLIT_SY                 8u
+#define BLIT_DX                 4u
+#define BLIT_DY                 12u
+
+static void
+rb_pkt4(uint32_t reg, uint32_t cnt)
+{
+	rb_out(CP_TYPE4_PKT | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffffu) << 8) | (pm4_parity(reg) << 27));
+}
+
+static void
+rb_reg(uint32_t reg, uint32_t val)
+{
+	rb_pkt4(reg, 1);
+	rb_out(val);
+}
+
+static uint32_t
+img_pattern(uint32_t x, uint32_t y)
+{
+	return 0xff000000u | ((x * 4u) & 0xffu) | (((y * 4u) & 0xffu) << 8) | ((((x ^ y) * 8u) & 0xffu) << 16);
+}
+
+static void
+rb_surface(uint32_t info_reg, uint32_t gras_reg, uint64_t addr)
+{
+	rb_pkt4(info_reg, 9);
+	rb_out(FMT_R8G8B8A8_UNORM);
+	rb_out((uint32_t)addr);
+	rb_out((uint32_t)(addr >> 32));
+	rb_out((IMG_PITCH >> 6) | (((IMG_PITCH * IMG_H) >> 6) << 16));     /* PITCH, ARRAY_PITCH (64-byte units) */
+	for (int i = 0; i < 5; i++) {
+		rb_out(0);
+	}
+	rb_reg(gras_reg, FMT_R8G8B8A8_UNORM);
+}
+
+static bool irq_test(void);
+
+static bool
+blit_test(void)
+{
+	volatile uint32_t *src = (volatile uint32_t *)(dma + DMA_IMG_SRC);
+	volatile uint32_t *dst = (volatile uint32_t *)(dma + DMA_IMG_DST);
+	for (uint32_t y = 0; y < IMG_H; y++) {
+		for (uint32_t x = 0; x < IMG_W; x++) {
+			src[y * IMG_W + x] = img_pattern(x, y);
+			dst[y * IMG_W + x] = 0;
+		}
+	}
+	flush_dcache64(dma_pa + DMA_IMG_SRC, 2 * IMG_PITCH * IMG_H, TRUE);
+
+	/* fd5_blitter emit_setup */
+	rb_reg(R_RB_RENDER_CNTL, 0x00000008);
+	rb_reg(R_RB_2D_BLIT_CNTL, 0x86000000);
+	rb_reg(R_GRAS_2D_BLIT_CNTL, 0x86000000);
+	rb_reg(R_UNKNOWN_2184, 0x00000009);
+	rb_reg(R_RB_CNTL, RB_CNTL_BYPASS);
+	rb_reg(R_RB_MODE_CNTL_2D, 0x00000004);
+	rb_reg(R_SP_MODE_CNTL, 0x0000000c);
+	rb_reg(R_TPL1_MODE_CNTL_2D, 0x00000344);
+	rb_reg(R_HLSQ_MODE_CNTL, 0x00000002);
+	rb_reg(R_GRAS_CL_CNTL, 0x00000181);
+	/* emit_blit */
+	rb_pkt7(CP_SET_RENDER_MODE, 1);
+	rb_out(RENDER_MODE_BLIT2D);
+	rb_surface(R_RB_2D_SRC_INFO, R_GRAS_2D_SRC_INFO, gaddr(DMA_IMG_SRC));
+	rb_surface(R_RB_2D_DST_INFO, R_GRAS_2D_DST_INFO, gaddr(DMA_IMG_DST));
+	rb_pkt7(CP_BLIT, 5);
+	rb_out(BLIT_OP_COPY);
+	rb_out(BLIT_SX | (BLIT_SY << 16));
+	rb_out((BLIT_SX + BLIT_W - 1) | ((BLIT_SY + BLIT_H - 1) << 16));
+	rb_out(BLIT_DX | (BLIT_DY << 16));
+	rb_out((BLIT_DX + BLIT_W - 1) | ((BLIT_DY + BLIT_H - 1) << 16));
+	rb_pkt7(CP_SET_RENDER_MODE, 1);
+	rb_out(RENDER_MODE_END2D);
+	rb_pkt7(CP_WAIT_FOR_IDLE, 0);
+
+	/* CACHE_FLUSH_TS with IRQ: flushes the render caches, writes the fence, interrupts */
+	bool fenced = irq_test();
+	flush_dcache64(dma_pa + DMA_IMG_DST, IMG_PITCH * IMG_H, TRUE);
+	uint32_t bad = 0, first_x = 0, first_y = 0, first_got = 0, first_want = 0, inside = 0;
+	for (uint32_t y = 0; y < IMG_H; y++) {
+		for (uint32_t x = 0; x < IMG_W; x++) {
+			bool in = x >= BLIT_DX && x < BLIT_DX + BLIT_W && y >= BLIT_DY && y < BLIT_DY + BLIT_H;
+			uint32_t want = in ? img_pattern(x - BLIT_DX + BLIT_SX, y - BLIT_DY + BLIT_SY) : 0;
+			uint32_t got = dst[y * IMG_W + x];
+			inside += in && got == want;
+			if (got != want && bad++ == 0) {
+				first_x = x;
+				first_y = y;
+				first_got = got;
+				first_want = want;
+			}
+		}
+	}
+	printf("SWEET GPU B: BLIT %ux%u (%u,%u)->(%u,%u): %u/%u pixels right inside, %u wrong of %u, fence %s\n",
+	    BLIT_W, BLIT_H, BLIT_SX, BLIT_SY, BLIT_DX, BLIT_DY, inside, BLIT_W * BLIT_H, bad, IMG_W * IMG_H,
+	    fenced ? "ok" : "MISSING");
+	if (bad) {
+		printf("SWEET GPU B: BLIT first wrong pixel (%u,%u) = 0x%08x, want 0x%08x\n", first_x, first_y,
+		    first_got, first_want);
+	}
+	return fenced && bad == 0;
+}
