+++ b/bsd/dev/sweet_a540_b.c
@@ -2764,8 +2764,16 @@ SYSCTL_PROC(_kern, OID_AUTO, sweetgpu_val, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LO
  * gfx3d back on the PLL even output / 2. GPU MHz = 9.6 * l. One I/O mapping for good.
  */
 #define GPU_L_RUNTIME_MAX       69u     /* 662.4 MHz: the 670 MHz corner */
-int sweet_gpu_clock_runtime(uint32_t l);
+int sweet_gpu_clock_runtime(uint32_t l, bool measure);
 int sweet_gpu_clock_l(void);
+uint32_t sweet_gpu_activity(void);
+
+/* 0179: frames presented plus user submits, for the governor (bsd/dev/sweet_power.c) */
+uint32_t
+sweet_gpu_activity(void)
+{
+	return (uint32_t)present_frames + (uint32_t)gpu_submits;
+}
 
 int
 sweet_gpu_clock_l(void)
@@ -2774,7 +2782,7 @@ sweet_gpu_clock_l(void)
 }
 
 int
-sweet_gpu_clock_runtime(uint32_t l)
+sweet_gpu_clock_runtime(uint32_t l, bool measure)
 {
 	static vm_offset_t cc;
 	int error = 0;
@@ -2816,10 +2824,16 @@ sweet_gpu_clock_runtime(uint32_t l)
 	for (int i = 0; i < 100 && (*cmd & 1u); i++) {
 		delay(1);
 	}
-	gpu_clock_measure("runtime");
+	if (measure) {
+		gpu_clock_measure("runtime");   /* 2 ms with the ring held: only when asked by hand */
+	} else if (locked) {
+		last_khz = (int)(9600u * l);
+	}
 	lck_mtx_unlock(gpu_mtx);
-	printf("SWEET GPU: runtime clock L %u (%u.%u MHz asked): latch %s, lock %s, measured %d kHz\n", l,
-	    96u * l / 10u, 96u * l % 10u, latched ? "ok" : "TIMEOUT", locked ? "ok" : "NO", last_khz);
+	if (measure || !locked) {
+		printf("SWEET GPU: runtime clock L %u (%u.%u MHz asked): latch %s, lock %s, measured %d kHz\n", l,
+		    96u * l / 10u, 96u * l % 10u, latched ? "ok" : "TIMEOUT", locked ? "ok" : "NO", last_khz);
+	}
 	return error;
 }
 
